@model MyRegistrationsPageModel

@{
    ViewData["Title"] = "My Registrations";
    var showPast = Model.Show == "past";
}

<section class="account-page search-page">
    <div class="account-heading">
        <p class="account-kicker">Registrations</p>
        <h1>My registrations</h1>
        <p>Every tryout, camp, and event you've registered a player for, and where each one stands.</p>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="account-alert" role="status">@statusMessage</div>
    }

    <nav class="registration-tabs" aria-label="Registration filter">
        <a class="btn @(showPast ? "btn-outline-secondary" : "btn-primary")" href="/account/registrations" aria-current="@(showPast ? null : "page")">Upcoming (@Model.UpcomingCount)</a>
        <a class="btn @(showPast ? "btn-primary" : "btn-outline-secondary")" href="/account/registrations?show=past" aria-current="@(showPast ? "page" : null)">Past (@Model.PastCount)</a>
    </nav>

    <section class="form-section">
        @if (Model.Registrations.Count == 0)
        {
            @if (showPast)
            {
                <p class="section-help">No past registrations yet.</p>
            }
            else if (!Model.HasManagedPlayers)
            {
                <p class="section-help">Add your player first, then find a tryout and register in a couple of clicks.</p>
                <div class="form-actions">
                    <a class="btn btn-primary" href="/account/onboarding/player-profiles">Add a player</a>
                    <a class="btn btn-outline-secondary" href="/tryouts">Find tryouts</a>
                </div>
            }
            else
            {
                <p class="section-help">No upcoming registrations. Find a tryout near you to get started.</p>
                <div class="form-actions">
                    <a class="btn btn-primary" href="/tryouts">Find tryouts</a>
                </div>
            }
        }
        else
        {
            <div class="plan-list">
                @foreach (var registration in Model.Registrations)
                {
                    <article class="plan-row plan-row-stack opportunity-row p-2">
                        <div class="opportunity-row-head">
                            <div>
                                <strong>@registration.PlayerName - @registration.OpportunityTitle</strong>
                                <span>@registration.TypeLabel - @registration.SportName - @registration.TeamName</span>
                            </div>
                            <span class="registration-status registration-status-@registration.StatusCode">@registration.StatusLabel</span>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-2 small text-muted">
                            <span><strong class="text-body">Date:</strong> @FormatDate(registration.EventDate)</span>
                            <span><strong class="text-body">Where:</strong> @FormatLocation(registration.City, registration.State)</span>
                            <span><strong class="text-body">Registered:</strong> @FormatDate(registration.RegisteredAt)</span>
                        </div>
                        <div class="form-actions mt-2">
                            <a class="btn btn-outline-primary btn-sm" href="/opportunities/@registration.OpportunityId">View details</a>
                            @if (registration.CanWithdraw)
                            {
                                <form method="post" action="/account/registrations/@registration.RegistrationId/withdraw"
                                      data-confirm="Withdraw @registration.PlayerName from @registration.OpportunityTitle? The team will be notified on their roster.">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Withdraw</button>
                                </form>
                            }
                        </div>
                    </article>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="form-actions mt-3">
                    @if (Model.HasPreviousPage)
                    {
                        <a class="btn btn-outline-secondary" href="/account/registrations?show=@Model.Show&amp;page=@(Model.Page - 1)">Previous</a>
                    }
                    <span class="section-help">Page @Model.Page of @Model.TotalPages</span>
                    @if (Model.HasNextPage)
                    {
                        <a class="btn btn-outline-secondary" href="/account/registrations?show=@Model.Show&amp;page=@(Model.Page + 1)">Next</a>
                    }
                </div>
            }
        }
    </section>
</section>

@functions {
    private static string FormatDate(DateTime? value)
    {
        return value?.ToLocalTime().ToString("MMM d, yyyy") ?? "Not set";
    }

    private static string FormatLocation(string? city, string? state)
    {
        var parts = new[] { city?.Trim(), state?.Trim().ToUpperInvariant() }
            .Where(part => !string.IsNullOrWhiteSpace(part));
        var text = string.Join(", ", parts);
        return text.Length == 0 ? "Not set" : text;
    }
}
