@model ForgotPasswordPageModel

@{
    ViewData["Title"] = "Forgot Password";
}

<section class="account-page compact">
    <div class="account-heading">
        <p class="account-kicker">Account recovery</p>
        <h1>Reset your password.</h1>
        <p>Enter the email address on your TryOutSpot account. If the account exists, we will send reset instructions.</p>
        <p>You can also use this to add an email/password sign-in to an account created with Google or Facebook.</p>
        <p class="required-note"><span class="required-marker">*</span> Required field</p>
    </div>

    <form asp-action="ForgotPassword" asp-controller="Account" method="post" class="account-form">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <section class="form-section">
            <div class="form-field">
                <label asp-for="Email" class="form-label">Email address <span class="required-marker">*</span></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
        </section>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Send reset instructions</button>
            <a asp-action="Login" asp-controller="Account" class="btn btn-link">Back to login</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
