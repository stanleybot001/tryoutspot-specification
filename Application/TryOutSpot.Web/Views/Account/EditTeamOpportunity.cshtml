@model TeamOpportunityEditorPageModel

@{
    ViewData["Title"] = Model.IsEditMode ? "Edit Team Opportunity" : "Create Team Opportunity";
    var submitPath = Model.IsEditMode && Model.OpportunityId.HasValue
        ? Url.Action("EditTeamOpportunity", "Account", new { teamId = Model.TeamId, opportunityId = Model.OpportunityId.Value })
        : Url.Action("CreateTeamOpportunity", "Account", new { teamId = Model.TeamId });
    var statusMessage = TempData["StatusMessage"] as string ?? ViewData["StatusMessage"] as string;
    var statusType = TempData["StatusMessageType"] as string ?? ViewData["StatusMessageType"] as string;
    var statusCssClass = string.Equals(statusType, "error", StringComparison.OrdinalIgnoreCase)
        ? "account-alert account-alert-error"
        : "account-alert";
    var isTryoutOpportunity = string.Equals(Model.Type?.Trim(), "tryout", StringComparison.OrdinalIgnoreCase);
    var registrationSectionCssClass = isTryoutOpportunity ? "form-fieldset" : "form-fieldset d-none";
}

<section class="account-page compact">
    <div class="account-heading">
        <p class="account-kicker">Team management</p>
        <h1>@(Model.IsEditMode ? "Edit opportunity listing" : "Create opportunity listing")</h1>
        <p>Build a listing that players can find in search and use to register with your team.</p>
        <p class="required-note"><span class="required-marker">*</span> Required field</p>
        <p class="section-help">
            Team: <strong>@Model.TeamName</strong>
            @if (!string.IsNullOrWhiteSpace(Model.OrganizationName))
            {
                <span> - @Model.OrganizationName</span>
            }
        </p>
    </div>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="@statusCssClass">@statusMessage</div>
    }

    @if (!Model.CanPostOpportunities)
    {
        <div class="account-alert">
            Your current membership does not include opportunity posting. Upgrade to Free Coach, Team Basic, or Team Professional to publish listings.
        </div>
    }
    else if (Model.HasLimitedPosting && !Model.HasUnlimitedPosting)
    {
        <div class="account-alert">
            @Model.PublishingPlanLabel usage: @Model.PublishedInWindowCount/@Model.PublishingLimit published listings in @Model.PublishingWindowMonths months.
        </div>
    }

    <section class="form-section">
        <form method="post" action="@submitPath" class="stacked-form" enctype="multipart/form-data" id="teamOpportunityEditorForm">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <fieldset class="form-fieldset">
                <legend>Opportunity basics</legend>
                <p class="section-help">Start with the type of team item, the sport, and the headline players will see in search.</p>
                <div class="form-grid two-column">
                    <div class="form-field">
                        <label asp-for="Type" class="form-label">Opportunity type <span class="required-marker">*</span></label>
                        <select asp-for="Type" class="form-select">
                            @foreach (var type in Model.AvailableOpportunityTypes)
                            {
                                <option value="@type">@FormatOpportunityType(type)</option>
                            }
                        </select>
                        <span asp-validation-for="Type" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="SportId" class="form-label">Sport <span class="required-marker">*</span></label>
                        @if (Model.AvailableSports.Count == 0)
                        {
                            <select asp-for="SportId" class="form-select" disabled>
                                <option value="">No sports assigned to this team</option>
                            </select>
                            <p class="section-help">Add at least one sport to the team profile before creating listings.</p>
                        }
                        else
                        {
                            <select asp-for="SportId" class="form-select">
                                @foreach (var sport in Model.AvailableSports)
                                {
                                    <option value="@sport.Id">@sport.Name</option>
                                }
                            </select>
                        }
                        <span asp-validation-for="SportId" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="Title" class="form-label">Title <span class="required-marker">*</span></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="CompetitionLevel" class="form-label">Competition level</label>
                        <input asp-for="CompetitionLevel" class="form-control" placeholder="Example: 12U B, Varsity, Club" />
                        <span asp-validation-for="CompetitionLevel" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="AgeGroup" class="form-label">Age group</label>
                        <input asp-for="AgeGroup" class="form-control" placeholder="Example: 14U, 16U, 18U" />
                        <span asp-validation-for="AgeGroup" class="text-danger"></span>
                    </div>
                </div>
            </fieldset>

            <fieldset class="form-fieldset">
                <legend>Schedule</legend>
                <p class="section-help">Separate the actual event dates from the dates this listing should be visible.</p>
                <div class="form-grid two-column">
                    <div class="form-field">
                        <label asp-for="EventDate" class="form-label">Event start date</label>
                        <input asp-for="EventDate" class="form-control" />
                        <span asp-validation-for="EventDate" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="EventEndDate" class="form-label">Event end date</label>
                        <input asp-for="EventEndDate" class="form-control" />
                        <span asp-validation-for="EventEndDate" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="ListingStartDate" class="form-label">Listing start date</label>
                        <input asp-for="ListingStartDate" class="form-control" />
                        <span asp-validation-for="ListingStartDate" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="ListingEndDate" class="form-label">Listing end date</label>
                        <input asp-for="ListingEndDate" class="form-control" />
                        <span asp-validation-for="ListingEndDate" class="text-danger"></span>
                    </div>
                </div>
            </fieldset>

            <fieldset class="form-fieldset">
                <legend>Location</legend>
                <p class="section-help">Add the field, facility, or city where players should expect this opportunity.</p>
                <div class="form-grid two-column">
                    <div class="form-field">
                        <label asp-for="Location" class="form-label">Location</label>
                        <input asp-for="Location" class="form-control" placeholder="Facility or field name" />
                        <span asp-validation-for="Location" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="Address" class="form-label">Address</label>
                        <input asp-for="Address" class="form-control" placeholder="Street address" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="City" class="form-label">City</label>
                        <input asp-for="City" class="form-control" autocomplete="address-level2" />
                        <span asp-validation-for="City" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="State" class="form-label">State</label>
                        <input asp-for="State" class="form-control" autocomplete="address-level1" maxlength="2" />
                        <span asp-validation-for="State" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="ZipCode" class="form-label">ZIP code</label>
                        <input asp-for="ZipCode" class="form-control" autocomplete="postal-code" />
                        <span asp-validation-for="ZipCode" class="text-danger"></span>
                    </div>
                </div>
            </fieldset>

            <fieldset class="form-fieldset">
                <legend>Contact and links</legend>
                <p class="section-help">Put the main contact and any external landing page or flyer link together.</p>
                <div class="form-grid two-column">
                    <div class="form-field">
                        <label asp-for="ContactEmail" class="form-label">Contact email</label>
                        <input asp-for="ContactEmail" class="form-control" autocomplete="email" />
                        <span asp-validation-for="ContactEmail" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="ContactPhone" class="form-label">Contact phone</label>
                        <input asp-for="ContactPhone" class="form-control" autocomplete="tel" />
                        <span asp-validation-for="ContactPhone" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="WebsiteUrl" class="form-label">Website URL</label>
                        <input asp-for="WebsiteUrl" class="form-control" placeholder="https://..." />
                        <span asp-validation-for="WebsiteUrl" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="PdfUrl" class="form-label">External PDF link</label>
                        <input asp-for="PdfUrl" class="form-control" placeholder="https://.../flyer.pdf" />
                        <span asp-validation-for="PdfUrl" class="text-danger"></span>
                    </div>
                </div>
            </fieldset>

            <fieldset class="form-fieldset">
                <legend>PDF flyer</legend>
                <p class="section-help">Upload a PDF flyer when the listing needs a downloadable handout.</p>
                <div class="form-field">
                    @if (Model.HasUploadedPdf && !string.IsNullOrWhiteSpace(Model.UploadedPdfUrl))
                    {
                        <p class="section-help mb-2">
                            Current upload:
                            <a href="@Model.UploadedPdfUrl" target="_blank" rel="noopener">
                                @(string.IsNullOrWhiteSpace(Model.UploadedPdfFileName) ? "Open PDF" : Model.UploadedPdfFileName)
                            </a>
                        </p>
                        <label class="sms-consent-option" for="RemoveUploadedPdf">
                            <input asp-for="RemoveUploadedPdf" class="form-check-input" />
                            <span>Remove current uploaded PDF.</span>
                        </label>
                    }

                    <label asp-for="PdfUpload" class="form-label">Upload PDF</label>
                    <input asp-for="PdfUpload" type="file" accept=".pdf,application/pdf" class="form-control" id="PdfUploadInput" />
                    <p class="section-help">Maximum file size: 10 MB. Upload a PDF only.</p>
                    <span asp-validation-for="PdfUpload" class="text-danger"></span>
                    <p class="text-danger d-none" id="PdfUploadClientError"></p>
                </div>
            </fieldset>

            <fieldset class="form-fieldset">
                <legend>Description and instructions</legend>
                <p class="section-help">Use this area for the player-facing details they need before registering or contacting you.</p>
                <div class="form-grid">
                    <div class="form-field">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe what players should know before registering."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="RequiredEquipment" class="form-label">Required equipment</label>
                        <textarea asp-for="RequiredEquipment" class="form-control" rows="3" placeholder="Optional equipment checklist."></textarea>
                        <span asp-validation-for="RequiredEquipment" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="WhatToBring" class="form-label">What to bring</label>
                        <textarea asp-for="WhatToBring" class="form-control" rows="3" placeholder="Optional preparation notes."></textarea>
                        <span asp-validation-for="WhatToBring" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="SpecialInstructions" class="form-label">Special instructions</label>
                        <textarea asp-for="SpecialInstructions" class="form-control" rows="3" placeholder="Optional arrival, check-in, or waiver details."></textarea>
                        <span asp-validation-for="SpecialInstructions" class="text-danger"></span>
                    </div>
                </div>
            </fieldset>

            <fieldset id="tryoutRegistrationSettings" class="@registrationSectionCssClass">
                <legend>Tryout registration settings</legend>
                @if (!Model.CanConfigureTryoutRegistration)
                {
                    <p class="section-help">
                        Tryout registration management is available on Team Basic and higher plans.
                    </p>
                }

                <label class="sms-consent-option" for="RegistrationRequired">
                    <input asp-for="RegistrationRequired" class="form-check-input" />
                    <span>Enable tryout registration for this listing.</span>
                </label>

                <label class="sms-consent-option" for="LimitRegistrationCapacity">
                    <input asp-for="LimitRegistrationCapacity" class="form-check-input" />
                    <span>Limit registrations to a max player count and close automatically when full.</span>
                </label>

                <div class="form-grid two-column registration-settings-grid">
                    <div class="form-field">
                        <label asp-for="RegistrationFee" class="form-label">Registration cost (paid in person)</label>
                        <input asp-for="RegistrationFee" class="form-control" inputmode="decimal" />
                        <p class="section-help">This amount is informational only and is collected directly by the team.</p>
                        <span asp-validation-for="RegistrationFee" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="RegistrationDeadline" class="form-label">Registration deadline</label>
                        <input asp-for="RegistrationDeadline" class="form-control" />
                        <span asp-validation-for="RegistrationDeadline" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="MaxParticipants" class="form-label">Max registrations</label>
                        <input asp-for="MaxParticipants" class="form-control" inputmode="numeric" />
                        <p class="section-help">Optional unless capacity limit is enabled.</p>
                        <span asp-validation-for="MaxParticipants" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-field mt-3">
                    <p class="form-label mb-2">Required registration fields</p>
                    @if (Model.AvailableRegistrationFieldOptions.Count == 0)
                    {
                        <p class="section-help">No custom registration fields are configured.</p>
                    }
                    else
                    {
                        <div class="registration-required-field-grid">
                            @foreach (var fieldOption in Model.AvailableRegistrationFieldOptions)
                            {
                                var checkboxId = $"RequiredRegistrationFieldCodes_{fieldOption.Code}";
                                <label class="sms-consent-option registration-field-option" for="@checkboxId">
                                    <input
                                        type="checkbox"
                                        class="form-check-input"
                                        id="@checkboxId"
                                        name="RequiredRegistrationFieldCodes"
                                        value="@fieldOption.Code"
                                        @(fieldOption.IsRequired ? "checked" : null) />
                                    <span>
                                        <strong>@fieldOption.Label</strong>
                                        <span class="registration-field-description"> - @fieldOption.Description</span>
                                    </span>
                                </label>
                            }
                        </div>
                    }
                    <span asp-validation-for="RequiredRegistrationFieldCodes" class="text-danger"></span>
                </div>

                <div class="form-field mt-3">
                    <p class="form-label mb-2">Waiver handling</p>
                    <label class="sms-consent-option" for="WaiverRequired">
                        <input asp-for="WaiverRequired" class="form-check-input" />
                        <span>Require a signed waiver for this tryout.</span>
                    </label>
                    <span asp-validation-for="WaiverRequired" class="text-danger"></span>

                    <div class="mt-2">
                        <label class="sms-consent-option" for="WaiverMethodAtEvent">
                            <input
                                type="radio"
                                class="form-check-input"
                                id="WaiverMethodAtEvent"
                                name="WaiverMethod"
                                value="at_event"
                                @(string.Equals(Model.WaiverMethod, "at_event", System.StringComparison.OrdinalIgnoreCase) ? "checked" : null) />
                            <span>Waiver handled at event check-in.</span>
                        </label>
                        <label class="sms-consent-option" for="WaiverMethodDownloadable">
                            <input
                                type="radio"
                                class="form-check-input"
                                id="WaiverMethodDownloadable"
                                name="WaiverMethod"
                                value="downloadable"
                                @(string.Equals(Model.WaiverMethod, "downloadable", System.StringComparison.OrdinalIgnoreCase) ? "checked" : null) />
                            <span>Upload waiver PDF so parents/players can download it before the event.</span>
                        </label>
                        <span asp-validation-for="WaiverMethod" class="text-danger"></span>
                    </div>

                    @if (Model.HasUploadedWaiverPdf && !string.IsNullOrWhiteSpace(Model.UploadedWaiverPdfUrl))
                    {
                        <p class="section-help mt-2 mb-2">
                            Current waiver file:
                            <a href="@Model.UploadedWaiverPdfUrl" target="_blank" rel="noopener">
                                @(string.IsNullOrWhiteSpace(Model.UploadedWaiverPdfFileName) ? "Open waiver PDF" : Model.UploadedWaiverPdfFileName)
                            </a>
                        </p>
                        <label class="sms-consent-option" for="RemoveUploadedWaiverPdf">
                            <input asp-for="RemoveUploadedWaiverPdf" class="form-check-input" />
                            <span>Remove current uploaded waiver PDF.</span>
                        </label>
                    }

                    <label asp-for="WaiverPdfUpload" class="form-label mt-2">Upload waiver PDF</label>
                    <input asp-for="WaiverPdfUpload" type="file" accept=".pdf,application/pdf" class="form-control" id="WaiverPdfUploadInput" />
                    <p class="section-help">Maximum file size: 10 MB. Upload a PDF only.</p>
                    <span asp-validation-for="WaiverPdfUpload" class="text-danger"></span>

                    <label class="sms-consent-option mt-2" for="WaiverReturnByEmail">
                        <input asp-for="WaiverReturnByEmail" class="form-check-input" />
                        <span>Allow waiver return by email to the listing contact email.</span>
                    </label>
                    <label class="sms-consent-option" for="WaiverReturnInPerson">
                        <input asp-for="WaiverReturnInPerson" class="form-check-input" />
                        <span>Allow waiver return in person at the event.</span>
                    </label>
                    <span asp-validation-for="WaiverReturnByEmail" class="text-danger"></span>
                </div>
            </fieldset>

            <fieldset class="form-fieldset">
                <legend>Visibility and publishing</legend>
                <label class="sms-consent-option" for="IsPublished">
                    <input asp-for="IsPublished" class="form-check-input" />
                    <span>Publish this opportunity now so it appears in discovery.</span>
                </label>
            </fieldset>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">@(Model.IsEditMode ? "Update listing" : "Create listing")</button>
                <a class="btn btn-outline-secondary" href="/account/onboarding/team-opportunities/@Model.TeamId">Back to listings</a>
                <a class="btn btn-outline-secondary" href="/account/onboarding/team-opportunities">Back to teams</a>
            </div>
        </form>
    </section>
</section>

@functions {
    private static string FormatOpportunityType(string type)
    {
        if (string.IsNullOrWhiteSpace(type))
        {
            return "Opportunity";
        }

        return type
            .Replace("_", " ", StringComparison.Ordinal)
            .Trim()
            .ToLowerInvariant() switch
        {
            "tryout" => "Tryout",
            "roster opening" => "Roster opening",
            "pickup player" => "Pickup player",
            "camp" => "Camp",
            "clinic" => "Clinic",
            "tournament" => "Tournament",
            "private workout" => "Private workout",
            var fallback => char.ToUpperInvariant(fallback[0]) + fallback[1..]
        };
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const form = document.getElementById("teamOpportunityEditorForm");
            const typeSelect = document.getElementById("Type");
            const registrationSection = document.getElementById("tryoutRegistrationSettings");

            const normalizeType = (value) => (value || "")
                .toString()
                .trim()
                .toLowerCase()
                .replace(/_/g, " ");

            const syncTryoutRegistrationVisibility = () => {
                if (!typeSelect || !registrationSection) {
                    return;
                }

                const isTryout = normalizeType(typeSelect.value) === "tryout";
                registrationSection.classList.toggle("d-none", !isTryout);
                const registrationFields = registrationSection.querySelectorAll("input, select, textarea");
                registrationFields.forEach((field) => {
                    field.disabled = !isTryout;
                });
            };

            if (typeSelect && registrationSection) {
                syncTryoutRegistrationVisibility();
                typeSelect.addEventListener("change", syncTryoutRegistrationVisibility);
            }

            const maxBytes = 10 * 1024 * 1024;
            const fileInput = document.getElementById("PdfUploadInput");
            const errorEl = document.getElementById("PdfUploadClientError");
            if (!form || !fileInput || !errorEl) {
                return;
            }

            const clearError = () => {
                errorEl.textContent = "";
                errorEl.classList.add("d-none");
            };

            const setError = (message) => {
                errorEl.textContent = message;
                errorEl.classList.remove("d-none");
            };

            fileInput.addEventListener("change", () => {
                clearError();
                const file = fileInput.files && fileInput.files.length > 0 ? fileInput.files[0] : null;
                if (!file) {
                    return;
                }

                if (file.size > maxBytes) {
                    fileInput.value = "";
                    setError("PDF files can be up to 10 MB.");
                }
            });

            form.addEventListener("submit", (event) => {
                clearError();
                const file = fileInput.files && fileInput.files.length > 0 ? fileInput.files[0] : null;
                if (!file) {
                    return;
                }

                if (file.size > maxBytes) {
                    event.preventDefault();
                    fileInput.value = "";
                    setError("PDF files can be up to 10 MB.");
                }
            });
        })();
    </script>
}
