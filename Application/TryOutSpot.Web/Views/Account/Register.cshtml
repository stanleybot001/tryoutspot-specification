@model RegisterPageModel

@{
    ViewData["Title"] = "Create Account";
}

<section class="account-page">
    <div class="account-heading">
        <p class="account-kicker">Create your free TryOutSpot account</p>
        <h1>Create your free account</h1>
        <p>It takes about a minute. You can add kids, teams, and more details after you sign in.</p>
        <p class="required-note"><span class="required-marker">*</span> Required field</p>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="account-alert">@statusMessage</div>
    }

    <div class="account-divider"><span>or sign up faster</span></div>
    <div class="social-login-actions">
        @if (Model.GoogleIsConfigured)
        {
            <a class="btn btn-outline-dark" asp-action="ExternalLogin" asp-controller="Account" asp-route-provider="Google" asp-route-returnUrl="@Model.ReturnUrl" asp-route-source="register">Continue with Google</a>
        }
        @if (Model.FacebookIsConfigured)
        {
            <a class="btn btn-outline-dark" asp-action="ExternalLogin" asp-controller="Account" asp-route-provider="Facebook" asp-route-returnUrl="@Model.ReturnUrl" asp-route-source="register">Continue with Facebook</a>
        }
        @if (Model.AppleIsConfigured)
        {
            <a class="btn btn-outline-dark" asp-action="ExternalLogin" asp-controller="Account" asp-route-provider="Apple" asp-route-returnUrl="@Model.ReturnUrl" asp-route-source="register">Continue with Apple</a>
        }
        @if (!Model.GoogleIsConfigured && !Model.FacebookIsConfigured && !Model.AppleIsConfigured)
        {
            <p class="section-help">Social sign-up is not configured for this environment yet.</p>
        }
    </div>
    <p class="account-secondary-link">Prefer email and password? Complete the form below.</p>

    <form asp-action="Register" asp-controller="Account" method="post" class="account-form">
        <input asp-for="ReturnUrl" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <section class="form-section">
            <h2>Sign-in details</h2>
            <div class="form-grid two-column">
                <div class="form-field">
                    <label asp-for="Email" class="form-label">Email address <span class="required-marker">*</span></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="Password" class="form-label">Password <span class="required-marker">*</span></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" aria-describedby="password-hint" />
                    <span id="password-hint" class="field-hint">At least 8 characters with an uppercase letter, a lowercase letter, and a number.</span>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm password <span class="required-marker">*</span></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
            </div>
        </section>

        <section class="form-section">
            <h2>Account holder name</h2>
            <p class="section-help">If you are a parent or guardian, enter your own name here. Player and child details are added after signup in a separate player profile.</p>
            <div class="form-grid two-column">
                <div class="form-field">
                    <label asp-for="FirstName" class="form-label">Account holder first name <span class="required-marker">*</span></label>
                    <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="LastName" class="form-label">Account holder last name <span class="required-marker">*</span></label>
                    <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>
        </section>

        <section class="form-section">
            <h2>How will you use TryOutSpot? <span class="required-marker">*</span></h2>
            <p class="section-help">Choose parent or player (not both). Coaches who are also parents can choose both a parent role and the coach role.</p>
            <div class="account-type-grid">
                @foreach (var accountType in Model.AvailableAccountTypes)
                {
                    var exclusiveGroup = accountType.Name is TryOutSpotRoles.Parent or TryOutSpotRoles.Player ? "player-side" : null;
                    <label class="account-type-option" for="account-type-@accountType.Name">
                        <input class="form-check-input" id="account-type-@accountType.Name" name="AccountTypes" type="checkbox" value="@accountType.Name" checked="@accountType.IsSelected" data-exclusive-group="@exclusiveGroup" />
                        <span>
                            <strong>@accountType.Label</strong>
                            <small>@accountType.Description</small>
                        </span>
                    </label>
                }
            </div>
            <span asp-validation-for="AccountTypes" class="text-danger"></span>
        </section>

        <section class="form-section">
            <h2>Where are you located?</h2>
            <p class="section-help">Your ZIP code is used to show tryouts and players near you first.</p>
            <div class="form-grid two-column">
                <div class="form-field">
                    <label asp-for="ZipCode" class="form-label">ZIP code</label>
                    <input asp-for="ZipCode" class="form-control" autocomplete="postal-code" inputmode="numeric" />
                    <span asp-validation-for="ZipCode" class="text-danger"></span>
                </div>
            </div>
            @{
                var openOptionalDetails = Model.SmsConsentAccepted
                    || !string.IsNullOrWhiteSpace(Model.PhoneNumber)
                    || (ViewData.ModelState.ErrorCount > 0 && (
                        ViewData.ModelState[nameof(Model.PhoneNumber)]?.Errors.Count > 0
                        || ViewData.ModelState[nameof(Model.SmsConsentAccepted)]?.Errors.Count > 0
                        || ViewData.ModelState[nameof(Model.DateOfBirth)]?.Errors.Count > 0
                        || ViewData.ModelState[nameof(Model.State)]?.Errors.Count > 0));
            }
            <details class="optional-details" open="@openOptionalDetails">
                <summary>Add phone, text alerts, and more (optional)</summary>
                <div class="form-grid three-column">
                    <div class="form-field">
                        <label asp-for="PhoneNumber" class="form-label">Phone number</label>
                        <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" inputmode="tel" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="DateOfBirth" class="form-label">Your date of birth</label>
                        <input asp-for="DateOfBirth" class="form-control" />
                        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="City" class="form-label">City</label>
                        <input asp-for="City" class="form-control" autocomplete="address-level2" />
                        <span asp-validation-for="City" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="State" class="form-label">State</label>
                        <input asp-for="State" class="form-control" autocomplete="address-level1" maxlength="2" />
                        <span asp-validation-for="State" class="text-danger"></span>
                    </div>
                </div>
            <label class="sms-consent-option" for="SmsConsentAccepted">
                <input asp-for="SmsConsentAccepted" class="form-check-input" />
                <span>@TryOutSpotSmsConsent.CheckboxText</span>
            </label>
            <p class="sms-consent-disclosure">
                SMS consent is optional and is not required to create an account.
                Review the <a href="/privacy-policy">Privacy Policy</a> and
                <a href="/terms-and-conditions">Terms and Conditions</a>.
            </p>
            <span asp-validation-for="SmsConsentAccepted" class="text-danger"></span>
            </details>
        </section>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Create free account</button>
            <a asp-action="Login" asp-controller="Account" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-link">I already have an account</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
