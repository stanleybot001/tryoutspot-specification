@model TeamOpportunityListPageModel

@{
    ViewData["Title"] = "Team Opportunities";
}

<section class="account-page">
    <div class="account-heading">
        <p class="account-kicker">Team management</p>
        <h1>@Model.Team.TeamName opportunity listings</h1>
        <p>Manage active listings, publish updates, and keep tryout discovery current for your team.</p>
        @if (!string.IsNullOrWhiteSpace(Model.Team.OrganizationName))
        {
            <p class="section-help">Organization: @Model.Team.OrganizationName</p>
        }
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="account-alert">@statusMessage</div>
    }

    @if (!Model.CanPostOpportunities)
    {
        <div class="account-alert">
            Your current membership does not include opportunity posting. Upgrade to Free Coach, Team Basic, or Team Professional to publish new listings.
        </div>
    }
    else if (Model.HasLimitedPosting && !Model.HasUnlimitedPosting)
    {
        <div class="account-alert">
            @Model.PublishingPlanLabel allows up to @Model.PublishingLimit published opportunities every @Model.PublishingWindowMonths months.
            This team has @Model.Team.PublishedInWindowCount published in the current @Model.PublishingWindowMonths-month window.
        </div>
    }

    <section class="form-section">
        <div class="team-row-head">
            <div>
                <strong>@Model.Team.TeamName</strong>
                <span>@Model.Team.Role</span>
            </div>
            <div class="team-metric-inline">
                <span>@Model.Team.ActiveOpportunityCount active</span>
                <span>@Model.Team.PublishedOpportunityCount published</span>
                @if (Model.HasLimitedPosting && !Model.HasUnlimitedPosting)
                {
                    <span>@Model.Team.PublishedInWindowCount/@Model.PublishingLimit in @Model.PublishingWindowMonths months</span>
                }
            </div>
        </div>

        <div class="team-summary-grid">
            <div><span>Coverage</span><strong>@Model.Team.GeographicScope</strong></div>
            <div><span>Team level</span><strong>@(string.IsNullOrWhiteSpace(Model.Team.TeamLevel) ? "Not set" : Model.Team.TeamLevel)</strong></div>
            <div><span>Location</span><strong>@FormatLocation(Model.Team.City, Model.Team.State, Model.Team.ZipCode)</strong></div>
            <div><span>Searchable</span><strong>@(Model.Team.IsSearchable ? "Yes" : "No")</strong></div>
            <div><span>Public contact</span><strong>@(Model.Team.IsContactInfoVisible ? "Visible" : "Hidden")</strong></div>
            <div><span>Listings</span><strong>@Model.TotalCount total</strong></div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Team.TeamDescription))
        {
            <p class="section-help mt-2">@Model.Team.TeamDescription</p>
        }

        @if (Model.Team.Sports.Count > 0)
        {
            <div class="feature-code-list">
                @foreach (var sport in Model.Team.Sports)
                {
                    <span>@sport</span>
                }
            </div>
        }

        <div class="form-actions mt-3">
            @if (Model.CanPostOpportunities)
            {
                <a class="btn btn-primary" href="/account/onboarding/team-opportunities/@Model.Team.TeamId/new">Create listing</a>
            }
            <a class="btn btn-outline-secondary" href="/account/onboarding/team-opportunities/@Model.Team.TeamId/edit-profile">Edit profile</a>
            <a class="btn btn-outline-secondary" href="/account/onboarding/team-opportunities">Back to teams</a>
            <a class="btn btn-outline-secondary" href="/account/onboarding">Back to dashboard</a>
        </div>
    </section>

    <section class="form-section">
        <h2>Opportunity listings</h2>
        @if (Model.ShowBasicAnalytics)
        {
            <div class="d-flex flex-wrap gap-2 mb-2 small text-muted">
                <span><strong class="text-body">Page views:</strong> @Model.PageViewCountTotal</span>
                <span><strong class="text-body">Applications:</strong> @Model.PageRegistrationCountTotal</span>
                <span><strong class="text-body">Conversion:</strong> @FormatPercent(Model.PageViewToRegistrationConversionRate)</span>
                <span><strong class="text-body">Analytics:</strong> @(Model.ShowDetailedAnalytics ? "Detailed" : "Basic")</span>
            </div>
        }
        else
        {
            <p class="section-help">Listing reporting unlocks with Team Basic or higher plans.</p>
        }
        @if (Model.Opportunities.Count == 0)
        {
            <p class="section-help">No active listings yet. Create your first listing to start recruiting players.</p>
        }
        else
        {
            <div class="plan-list">
                @foreach (var opportunity in Model.Opportunities)
                {
                    <article class="plan-row plan-row-stack opportunity-row p-2 @(opportunity.IsPublished ? "published" : "draft")">
                        <div class="opportunity-row-head">
                            <div>
                                <strong>@opportunity.Title</strong>
                                <span>@FormatOpportunityType(opportunity.Type) - @opportunity.SportName</span>
                            </div>
                            <div class="team-metric-inline">
                                <span>@(opportunity.IsPublished ? "Published" : "Unpublished")</span>
                                <span>Updated @opportunity.UpdatedAt.ToLocalTime().ToString("MMM d, yyyy")</span>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-2 small text-muted">
                            <span><strong class="text-body">Age:</strong> @(string.IsNullOrWhiteSpace(opportunity.AgeGroup) ? "Not set" : opportunity.AgeGroup)</span>
                            <span><strong class="text-body">Competition:</strong> @(string.IsNullOrWhiteSpace(opportunity.CompetitionLevel) ? "Not set" : opportunity.CompetitionLevel)</span>
                            <span><strong class="text-body">Fee:</strong> @FormatFee(opportunity.RegistrationFee)</span>
                            <span><strong class="text-body">Deadline:</strong> @FormatDate(opportunity.RegistrationDeadline)</span>
                            <span><strong class="text-body">Start:</strong> @FormatDate(opportunity.EventDate)</span>
                            <span><strong class="text-body">End:</strong> @FormatDate(opportunity.EventEndDate)</span>
                            <span><strong class="text-body">Location:</strong> @FormatLocation(opportunity.City, opportunity.State, opportunity.ZipCode)</span>
                            <span><strong class="text-body">Expires:</strong> @FormatDate(opportunity.ExpiresAt)</span>
                        </div>

                        @if (Model.ShowBasicAnalytics)
                        {
                            <section class="listing-reporting p-2">
                                <div class="d-flex flex-wrap gap-2 small text-muted">
                                    <strong class="text-body">Reporting</strong>
                                    <span>Views: <strong class="text-body">@opportunity.ViewCount</strong></span>
                                    <span>Applications: <strong class="text-body">@opportunity.RegistrationCount</strong></span>
                                    <span>Unique players: <strong class="text-body">@opportunity.UniqueApplicantCount</strong></span>
                                    <span>
                                        @(Model.ShowDetailedAnalytics ? "View to apply" : "Pending review"):
                                        <strong class="text-body">@(Model.ShowDetailedAnalytics ? FormatPercent(opportunity.ViewToRegistrationConversionRate) : opportunity.PendingRegistrationCount.ToString())</strong>
                                    </span>
                                </div>

                                @if (Model.ShowDetailedAnalytics)
                                {
                                    var funnelMax = Math.Max(opportunity.RegistrationCount, 1);
                                    var approvedBar = CalculateBarPercent(opportunity.ApprovedRegistrationCount, funnelMax);
                                    var pendingBar = CalculateBarPercent(opportunity.PendingRegistrationCount, funnelMax);
                                    var declinedBar = CalculateBarPercent(opportunity.DeclinedRegistrationCount, funnelMax);

                                    <div class="listing-reporting-bars">
                                        <div class="listing-reporting-bar-row">
                                            <span>Approved</span>
                                            <div class="listing-reporting-bar-track">
                                                <div class="listing-reporting-bar-fill approved" style="width:@approvedBar"></div>
                                            </div>
                                            <strong>@opportunity.ApprovedRegistrationCount</strong>
                                        </div>
                                        <div class="listing-reporting-bar-row">
                                            <span>Pending</span>
                                            <div class="listing-reporting-bar-track">
                                                <div class="listing-reporting-bar-fill pending" style="width:@pendingBar"></div>
                                            </div>
                                            <strong>@opportunity.PendingRegistrationCount</strong>
                                        </div>
                                        <div class="listing-reporting-bar-row">
                                            <span>Declined</span>
                                            <div class="listing-reporting-bar-track">
                                                <div class="listing-reporting-bar-fill declined" style="width:@declinedBar"></div>
                                            </div>
                                            <strong>@opportunity.DeclinedRegistrationCount</strong>
                                        </div>
                                    </div>
                                }
                            </section>
                        }

                        @if (opportunity.Registrants.Count > 0)
                        {
                            <details class="listing-reporting registration-roster">
                                <summary class="registration-roster-toggle">
                                    <span class="listing-reporting-title">Registered players (@opportunity.Registrants.Count)</span>
                                    <span class="registration-roster-toggle-action">Open roster</span>
                                </summary>
                                <div class="registration-roster-toolbar">
                                    <a class="btn btn-outline-secondary btn-sm"
                                       href="/account/onboarding/team-opportunities/@Model.Team.TeamId/@opportunity.OpportunityId/registrations/share"
                                       target="_blank"
                                       rel="noopener">Share roster</a>
                                </div>
                                <div class="table-responsive" style="max-height: 420px; overflow-y: auto;">
                                    <table class="table table-sm align-middle registration-roster-table mb-0">
                                        <thead>
                                            <tr>
                                                <th scope="col">Player</th>
                                                <th scope="col">Status</th>
                                                <th scope="col">Contact</th>
                                                <th scope="col">Attendance</th>
                                                <th scope="col">Waiver</th>
                                                <th scope="col" class="text-end">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var registrant in opportunity.Registrants)
                                            {
                                                <tr class="@(registrant.IsFavoritedByViewer ? "table-warning" : string.Empty)">
                                                    <td>
                                                        <strong>
                                                            @registrant.PlayerName
                                                            @if (registrant.IsFavoritedByViewer)
                                                            {
                                                                <span class="favorite-player-marker"
                                                                      title="Favorited player listing"
                                                                      aria-label="Favorited player listing">&#9733;</span>
                                                            }
                                                        </strong>
                                                        @if (!string.IsNullOrWhiteSpace(registrant.SchoolName))
                                                        {
                                                            <span class="d-block small text-muted">@registrant.SchoolName</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <span>@registrant.StatusLabel</span>
                                                        <span class="d-block small text-muted">Registered @FormatDateTime(registrant.RegisteredAt)</span>
                                                    </td>
                                                    <td>
                                                        @if (string.IsNullOrWhiteSpace(registrant.PlayerPhone)
                                                            && string.IsNullOrWhiteSpace(registrant.PlayerEmail))
                                                        {
                                                            <span class="small text-muted">Not listed</span>
                                                        }
                                                        else
                                                        {
                                                            @if (!string.IsNullOrWhiteSpace(registrant.PlayerPhone))
                                                            {
                                                                <span class="d-block">@registrant.PlayerPhone</span>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(registrant.PlayerEmail))
                                                            {
                                                                <span class="d-block small text-muted">@registrant.PlayerEmail</span>
                                                            }
                                                        }
                                                    </td>
                                                    <td>
                                                        <span>@(registrant.IsPresent ? "Present" : "Not checked in")</span>
                                                        @if (registrant.CheckedInAt.HasValue)
                                                        {
                                                            <span class="d-block small text-muted">@FormatDateTime(registrant.CheckedInAt.Value)</span>
                                                        }
                                                        <form class="inline-form m-0 mt-1"
                                                              asp-action="SetTeamOpportunityRegistrationAttendance"
                                                              asp-controller="Account"
                                                              asp-route-teamId="@Model.Team.TeamId"
                                                              asp-route-opportunityId="@opportunity.OpportunityId"
                                                              asp-route-registrationId="@registrant.RegistrationId"
                                                              method="post">
                                                            <input type="hidden" name="isPresent" value="@(registrant.IsPresent ? "false" : "true")" />
                                                            <input type="hidden" name="page" value="@Model.Page" />
                                                            <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                                            <button type="submit" class="btn btn-outline-secondary btn-sm">
                                                                @(registrant.IsPresent ? "Reset" : "Mark present")
                                                            </button>
                                                        </form>
                                                    </td>
                                                    <td>
                                                        <span>@(registrant.IsWaiverReceived ? "Received" : "Missing")</span>
                                                        @if (registrant.WaiverReceivedAt.HasValue)
                                                        {
                                                            <span class="d-block small text-muted">@FormatDateTime(registrant.WaiverReceivedAt.Value)</span>
                                                        }
                                                        <form class="inline-form m-0 mt-1"
                                                              asp-action="SetTeamOpportunityRegistrationWaiverStatus"
                                                              asp-controller="Account"
                                                              asp-route-teamId="@Model.Team.TeamId"
                                                              asp-route-opportunityId="@opportunity.OpportunityId"
                                                              asp-route-registrationId="@registrant.RegistrationId"
                                                              method="post">
                                                            <input type="hidden" name="waiverReceived" value="@(registrant.IsWaiverReceived ? "false" : "true")" />
                                                            <input type="hidden" name="page" value="@Model.Page" />
                                                            <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                                            <button type="submit" class="btn btn-outline-secondary btn-sm">
                                                                @(registrant.IsWaiverReceived ? "Reset" : "Mark waiver")
                                                            </button>
                                                        </form>
                                                    </td>
                                                    <td class="text-end">
                                                        <div class="d-flex flex-wrap justify-content-end gap-1">
                                                            @if (!string.Equals(registrant.StatusCode, "accepted", StringComparison.OrdinalIgnoreCase))
                                                            {
                                                                <form class="inline-form m-0"
                                                                      asp-action="SetTeamOpportunityRegistrationStatus"
                                                                      asp-controller="Account"
                                                                      asp-route-teamId="@Model.Team.TeamId"
                                                                      asp-route-opportunityId="@opportunity.OpportunityId"
                                                                      asp-route-registrationId="@registrant.RegistrationId"
                                                                      method="post">
                                                                    <input type="hidden" name="status" value="accepted" />
                                                                    <input type="hidden" name="page" value="@Model.Page" />
                                                                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                                                    <button type="submit" class="btn btn-primary btn-sm">Accept</button>
                                                                </form>
                                                            }
                                                            @if (!string.Equals(registrant.StatusCode, "declined", StringComparison.OrdinalIgnoreCase))
                                                            {
                                                                <form class="inline-form m-0"
                                                                      asp-action="SetTeamOpportunityRegistrationStatus"
                                                                      asp-controller="Account"
                                                                      asp-route-teamId="@Model.Team.TeamId"
                                                                      asp-route-opportunityId="@opportunity.OpportunityId"
                                                                      asp-route-registrationId="@registrant.RegistrationId"
                                                                      method="post">
                                                                    <input type="hidden" name="status" value="declined" />
                                                                    <input type="hidden" name="page" value="@Model.Page" />
                                                                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                                                    <button type="submit" class="btn btn-outline-danger btn-sm">Decline</button>
                                                                </form>
                                                            }
                                                            @if (!string.Equals(registrant.StatusCode, "pending", StringComparison.OrdinalIgnoreCase))
                                                            {
                                                                <form class="inline-form m-0"
                                                                      asp-action="SetTeamOpportunityRegistrationStatus"
                                                                      asp-controller="Account"
                                                                      asp-route-teamId="@Model.Team.TeamId"
                                                                      asp-route-opportunityId="@opportunity.OpportunityId"
                                                                      asp-route-registrationId="@registrant.RegistrationId"
                                                                      method="post">
                                                                    <input type="hidden" name="status" value="pending" />
                                                                    <input type="hidden" name="page" value="@Model.Page" />
                                                                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                                                    <button type="submit" class="btn btn-outline-secondary btn-sm">Pending</button>
                                                                </form>
                                                            }
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </details>
                        }

                        @if (!string.IsNullOrWhiteSpace(opportunity.Description))
                        {
                            <p class="section-help small mb-1">@opportunity.Description</p>
                        }

                        @if (!string.IsNullOrWhiteSpace(opportunity.WebsiteUrl)
                            || !string.IsNullOrWhiteSpace(opportunity.PdfUrl)
                            || !string.IsNullOrWhiteSpace(opportunity.UploadedPdfUrl))
                        {
                            <div class="feature-code-list">
                                @if (!string.IsNullOrWhiteSpace(opportunity.WebsiteUrl))
                                {
                                    <a href="@opportunity.WebsiteUrl" target="_blank" rel="noopener">Website</a>
                                }
                                @if (!string.IsNullOrWhiteSpace(opportunity.UploadedPdfUrl))
                                {
                                    <a href="@opportunity.UploadedPdfUrl" target="_blank" rel="noopener">
                                        @(string.IsNullOrWhiteSpace(opportunity.UploadedPdfFileName) ? "Uploaded PDF" : opportunity.UploadedPdfFileName)
                                    </a>
                                }
                                @if (!string.IsNullOrWhiteSpace(opportunity.PdfUrl))
                                {
                                    <a href="@opportunity.PdfUrl" target="_blank" rel="noopener">External PDF</a>
                                }
                            </div>
                        }

                        <div class="form-actions mt-2">
                            @if (Model.Team.IsSearchable
                                && opportunity.IsPublished
                                && (!opportunity.ExpiresAt.HasValue || opportunity.ExpiresAt > DateTime.UtcNow))
                            {
                                <a class="btn btn-outline-primary btn-sm" href="/opportunities/@opportunity.OpportunityId" target="_blank" rel="noopener">View public page</a>
                            }
                            <a class="btn btn-outline-primary btn-sm" href="/account/onboarding/team-opportunities/@Model.Team.TeamId/@opportunity.OpportunityId/edit">Edit</a>

                            @if (opportunity.IsPublished)
                            {
                                <form class="inline-form"
                                      asp-action="SetTeamOpportunityPublication"
                                      asp-controller="Account"
                                      asp-route-teamId="@Model.Team.TeamId"
                                      asp-route-opportunityId="@opportunity.OpportunityId"
                                      method="post">
                                    <input type="hidden" name="isPublished" value="false" />
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">Unpublish</button>
                                </form>
                            }
                            else if (Model.CanPostOpportunities)
                            {
                                <form class="inline-form"
                                      asp-action="SetTeamOpportunityPublication"
                                      asp-controller="Account"
                                      asp-route-teamId="@Model.Team.TeamId"
                                      asp-route-opportunityId="@opportunity.OpportunityId"
                                      method="post">
                                    <input type="hidden" name="isPublished" value="true" />
                                    <button type="submit" class="btn btn-primary btn-sm">Publish</button>
                                </form>
                            }

                            <form class="inline-form"
                                  asp-action="DeactivateTeamOpportunity"
                                  asp-controller="Account"
                                  asp-route-teamId="@Model.Team.TeamId"
                                  asp-route-opportunityId="@opportunity.OpportunityId"
                                  method="post">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Deactivate</button>
                            </form>
                        </div>
                    </article>
                }
            </div>
        }

        @if (Model.TotalPages > 1)
        {
            <div class="form-actions mt-3">
                @if (Model.Page > 1)
                {
                    <a class="btn btn-outline-secondary" href="/account/onboarding/team-opportunities/@Model.Team.TeamId?page=@(Model.Page - 1)&pageSize=@Model.PageSize">Previous</a>
                }
                <span class="section-help">Page @Model.Page of @Model.TotalPages (@Model.TotalCount total)</span>
                @if (Model.Page < Model.TotalPages)
                {
                    <a class="btn btn-outline-secondary" href="/account/onboarding/team-opportunities/@Model.Team.TeamId?page=@(Model.Page + 1)&pageSize=@Model.PageSize">Next</a>
                }
            </div>
        }
    </section>
</section>

@functions {
    private static string FormatOpportunityType(string type)
    {
        if (string.IsNullOrWhiteSpace(type))
        {
            return "Opportunity";
        }

        return type
            .Replace("_", " ", StringComparison.Ordinal)
            .Trim()
            .ToLowerInvariant() switch
        {
            "tryout" => "Tryout",
            "roster opening" => "Roster opening",
            "pickup player" => "Pickup player",
            "camp" => "Camp",
            "clinic" => "Clinic",
            "tournament" => "Tournament",
            "private workout" => "Private workout",
            var fallback => char.ToUpperInvariant(fallback[0]) + fallback[1..]
        };
    }

    private static string FormatLocation(string? city, string? state, string? zipCode)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(city))
        {
            parts.Add(city.Trim());
        }

        if (!string.IsNullOrWhiteSpace(state))
        {
            parts.Add(state.Trim().ToUpperInvariant());
        }

        if (!string.IsNullOrWhiteSpace(zipCode))
        {
            parts.Add(zipCode.Trim());
        }

        return parts.Count == 0 ? "Not set" : string.Join(", ", parts);
    }

    private static string FormatDate(DateTime? date)
    {
        return date?.ToLocalTime().ToString("MMM d, yyyy") ?? "Not set";
    }

    private static string FormatDateTime(DateTime date)
    {
        return date.ToLocalTime().ToString("MMM d, yyyy h:mm tt");
    }

    private static string FormatFee(decimal amount)
    {
        return amount <= 0 ? "Free" : amount.ToString("C");
    }

    private static string FormatPercent(decimal? value)
    {
        return value.HasValue ? $"{value.Value:0.0}%" : "n/a";
    }

    private static string CalculateBarPercent(int count, int maxCount)
    {
        if (count <= 0 || maxCount <= 0)
        {
            return "0%";
        }

        var percentage = (decimal)count * 100m / maxCount;
        var normalized = Math.Clamp(Math.Round(percentage, 1, MidpointRounding.AwayFromZero), 0m, 100m);
        return normalized.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) + "%";
    }
}
