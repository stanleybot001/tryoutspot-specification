@model PlayerListingListPageModel

@{
    ViewData["Title"] = "Manage Player Listings";
}

<section class="account-page">
    <div class="account-heading">
        <p class="account-kicker">Player and parent listings</p>
        <h1>Manage your player marketplace listings.</h1>
        <p>Create and manage pickup player, looking for team, equipment, private lesson, and training partner listings.</p>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="account-alert">@statusMessage</div>
    }

    <section class="form-section">
        <div class="form-actions mb-2">
            <a class="btn btn-primary" href="/account/onboarding/player-listings/new">Create listing</a>
            <a class="btn btn-outline-secondary" href="/account/onboarding">Back to onboarding</a>
        </div>

        @if (Model.ManagedPlayers.Count > 0)
        {
            <div class="feature-code-list">
                @foreach (var player in Model.ManagedPlayers)
                {
                    <span>@player.DisplayName (@FormatLocation(player.City, player.State, player.ZipCode))</span>
                }
            </div>
        }
        else
        {
            <p class="section-help">No managed player profiles yet. You can still post equipment listings now, and add player profiles anytime.</p>
        }
    </section>

    <section class="form-section">
        <h2>Listings</h2>
        @if (Model.Listings.Count == 0)
        {
            <p class="section-help">No active listings yet. Create your first listing to start showing up in discovery.</p>
        }
        else
        {
            <div class="plan-list">
                @foreach (var listing in Model.Listings)
                {
                    <article class="plan-row plan-row-stack opportunity-row @(listing.IsPublished ? "published" : "draft")">
                        <div class="opportunity-row-head">
                            <div>
                                <strong>@listing.Title</strong>
                                <span>@listing.ListingTypeLabel</span>
                            </div>
                            <div class="team-metric-inline">
                                <span>@(listing.IsPublished ? "Published" : "Unpublished")</span>
                                <span>@(listing.IsSearchable ? "Searchable" : "Hidden from search")</span>
                            </div>
                        </div>

                        <div class="team-summary-grid opportunity-summary-grid">
                            <div><span>Player</span><strong>@(string.IsNullOrWhiteSpace(listing.PlayerName) ? "Not linked" : listing.PlayerName)</strong></div>
                            <div><span>Sport</span><strong>@(string.IsNullOrWhiteSpace(listing.SportName) ? "Not set" : listing.SportName)</strong></div>
                            <div><span>Price</span><strong>@FormatAskingPrice(listing.AskingPrice, listing.Currency)</strong></div>
                            <div><span>Condition</span><strong>@(string.IsNullOrWhiteSpace(listing.Condition) ? "Not set" : listing.Condition)</strong></div>
                            <div><span>Location</span><strong>@FormatLocation(listing.City, listing.State, listing.ZipCode)</strong></div>
                            <div><span>Published</span><strong>@FormatDate(listing.PublishedAt)</strong></div>
                            <div><span>Expires</span><strong>@FormatDate(listing.ExpiresAt)</strong></div>
                            <div><span>Updated</span><strong>@listing.UpdatedAt.ToLocalTime().ToString("MMM d, yyyy")</strong></div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(listing.Description))
                        {
                            <p class="section-help">@listing.Description</p>
                        }

                        <div class="form-actions">
                            @if (listing.IsPublished && listing.IsSearchable)
                            {
                                <a class="btn btn-outline-primary" href="/player-listings/@listing.ListingId" target="_blank" rel="noopener">View public page</a>
                            }
                            <a class="btn btn-outline-primary" href="/account/onboarding/player-listings/@listing.ListingId/edit">Edit</a>

                            @if (listing.IsPublished)
                            {
                                <form class="inline-form"
                                      asp-action="SetPlayerListingPublication"
                                      asp-controller="Account"
                                      asp-route-listingId="@listing.ListingId"
                                      method="post">
                                    <input type="hidden" name="isPublished" value="false" />
                                    <button type="submit" class="btn btn-outline-secondary">Unpublish</button>
                                </form>
                            }
                            else
                            {
                                <form class="inline-form"
                                      asp-action="SetPlayerListingPublication"
                                      asp-controller="Account"
                                      asp-route-listingId="@listing.ListingId"
                                      method="post">
                                    <input type="hidden" name="isPublished" value="true" />
                                    <button type="submit" class="btn btn-primary">Publish</button>
                                </form>
                            }

                            <form class="inline-form"
                                  asp-action="DeactivatePlayerListing"
                                  asp-controller="Account"
                                  asp-route-listingId="@listing.ListingId"
                                  method="post">
                                <button type="submit" class="btn btn-outline-danger">Deactivate</button>
                            </form>
                        </div>
                    </article>
                }
            </div>
        }

        @if (Model.TotalPages > 1)
        {
            <div class="form-actions mt-3">
                @if (Model.Page > 1)
                {
                    <a class="btn btn-outline-secondary" href="/account/onboarding/player-listings?page=@(Model.Page - 1)&pageSize=@Model.PageSize">Previous</a>
                }
                <span class="section-help">Page @Model.Page of @Model.TotalPages (@Model.TotalCount total)</span>
                @if (Model.Page < Model.TotalPages)
                {
                    <a class="btn btn-outline-secondary" href="/account/onboarding/player-listings?page=@(Model.Page + 1)&pageSize=@Model.PageSize">Next</a>
                }
            </div>
        }
    </section>
</section>

@functions {
    private static string FormatLocation(string? city, string? state, string? zipCode)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(city))
        {
            parts.Add(city.Trim());
        }

        if (!string.IsNullOrWhiteSpace(state))
        {
            parts.Add(state.Trim().ToUpperInvariant());
        }

        if (!string.IsNullOrWhiteSpace(zipCode))
        {
            parts.Add(zipCode.Trim());
        }

        return parts.Count == 0 ? "Not set" : string.Join(", ", parts);
    }

    private static string FormatDate(DateTime? value)
    {
        return value?.ToLocalTime().ToString("MMM d, yyyy") ?? "Not set";
    }

    private static string FormatAskingPrice(decimal? value, string? currency)
    {
        if (!value.HasValue)
        {
            return "Not listed";
        }

        var normalizedCurrency = string.IsNullOrWhiteSpace(currency)
            ? "USD"
            : currency.Trim().ToUpperInvariant();
        return $"{normalizedCurrency} {value.Value:0.##}";
    }
}
