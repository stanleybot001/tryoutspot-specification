@model PlayerListingListPageModel

@{
    ViewData["Title"] = "Manage Player Listings";
}

<section class="account-page">
    <div class="account-heading">
        <p class="account-kicker">Player listings</p>
        <h1>Manage your player marketplace listings.</h1>
        <p>Create and manage pickup player, looking for team, equipment, private lesson, and training partner listings. Player search only includes listings tied to active player profiles.</p>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="account-alert">@statusMessage</div>
    }

    <section class="form-section">
        <div class="form-actions mb-2">
            <a class="btn btn-primary" href="/account/onboarding/player-listings/new">Create listing</a>
            <a class="btn btn-outline-secondary" href="/account/onboarding">Back to dashboard</a>
        </div>

        @if (Model.ManagedPlayers.Count > 0)
        {
            <div class="feature-code-list">
                @foreach (var player in Model.ManagedPlayers)
                {
                    <span>@player.DisplayName (@FormatLocation(player.City, player.State, player.ZipCode))</span>
                }
            </div>
        }
        else
        {
            <p class="section-help">No managed player profiles yet. Add a player profile before creating searchable player listings.</p>
        }
    </section>

    <section class="form-section">
        <h2>Listings</h2>
        @if (Model.Listings.Count == 0)
        {
            <p class="section-help">No active listings yet. Create your first player-linked listing to appear in player search.</p>
        }
        else
        {
            <div class="plan-list">
                @foreach (var listing in Model.Listings)
                {
                    <article class="plan-row plan-row-stack opportunity-row p-2 @(listing.IsPublished ? "published" : "draft")">
                        <div class="opportunity-row-head">
                            <div>
                                <strong>@listing.Title</strong>
                                <span>@listing.ListingTypeLabel</span>
                            </div>
                            <div class="team-metric-inline">
                                <span>@(listing.IsPublished ? "Published" : "Unpublished")</span>
                                <span>@(listing.IsSearchable ? "Searchable" : "Hidden from search")</span>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-2 small text-muted">
                            <span><strong class="text-body">Player:</strong> @(string.IsNullOrWhiteSpace(listing.PlayerName) ? "Not linked" : listing.PlayerName)</span>
                            <span><strong class="text-body">Sport:</strong> @(string.IsNullOrWhiteSpace(listing.SportName) ? "Not set" : listing.SportName)</span>
                            <span><strong class="text-body">Price:</strong> @FormatAskingPrice(listing.AskingPrice, listing.Currency)</span>
                            <span><strong class="text-body">Condition:</strong> @(string.IsNullOrWhiteSpace(listing.Condition) ? "Not set" : listing.Condition)</span>
                            <span><strong class="text-body">Location:</strong> @FormatLocation(listing.City, listing.State, listing.ZipCode)</span>
                            <span><strong class="text-body">Published:</strong> @FormatDate(listing.PublishedAt)</span>
                            <span><strong class="text-body">Expires:</strong> @FormatDate(listing.ExpiresAt)</span>
                            <span><strong class="text-body">Updated:</strong> @listing.UpdatedAt.ToLocalTime().ToString("MMM d, yyyy")</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(listing.Description))
                        {
                            <p class="section-help small mb-1">@listing.Description</p>
                        }

                        @if (!string.IsNullOrWhiteSpace(listing.UploadedPdfUrl))
                        {
                            <div class="feature-code-list">
                                <a href="@listing.UploadedPdfUrl" target="_blank" rel="noopener">
                                    @(string.IsNullOrWhiteSpace(listing.UploadedPdfFileName) ? "PDF flyer" : listing.UploadedPdfFileName)
                                </a>
                            </div>
                        }

                        <div class="form-actions mt-2">
                            @if (listing.IsPublished && listing.IsSearchable)
                            {
                                <a class="btn btn-outline-primary btn-sm" href="/player-listings/@listing.ListingId" target="_blank" rel="noopener">View public page</a>
                            }
                            <a class="btn btn-outline-primary btn-sm" href="/account/onboarding/player-listings/@listing.ListingId/edit">Edit</a>

                            @if (listing.IsPublished)
                            {
                                <form class="inline-form"
                                      asp-action="SetPlayerListingPublication"
                                      asp-controller="Account"
                                      asp-route-listingId="@listing.ListingId"
                                      method="post">
                                    <input type="hidden" name="isPublished" value="false" />
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">Unpublish</button>
                                </form>
                            }
                            else
                            {
                                <form class="inline-form"
                                      asp-action="SetPlayerListingPublication"
                                      asp-controller="Account"
                                      asp-route-listingId="@listing.ListingId"
                                      method="post">
                                    <input type="hidden" name="isPublished" value="true" />
                                    <button type="submit" class="btn btn-primary btn-sm">Publish</button>
                                </form>
                            }

                            <form class="inline-form"
                                  asp-action="DeactivatePlayerListing"
                                  asp-controller="Account"
                                  asp-route-listingId="@listing.ListingId"
                                  method="post">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Deactivate</button>
                            </form>
                        </div>
                    </article>
                }
            </div>
        }

        @if (Model.TotalPages > 1)
        {
            <div class="form-actions mt-3">
                @if (Model.Page > 1)
                {
                    <a class="btn btn-outline-secondary" href="/account/onboarding/player-listings?page=@(Model.Page - 1)&pageSize=@Model.PageSize">Previous</a>
                }
                <span class="section-help">Page @Model.Page of @Model.TotalPages (@Model.TotalCount total)</span>
                @if (Model.Page < Model.TotalPages)
                {
                    <a class="btn btn-outline-secondary" href="/account/onboarding/player-listings?page=@(Model.Page + 1)&pageSize=@Model.PageSize">Next</a>
                }
            </div>
        }
    </section>
</section>

@functions {
    private static string FormatLocation(string? city, string? state, string? zipCode)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(city))
        {
            parts.Add(city.Trim());
        }

        if (!string.IsNullOrWhiteSpace(state))
        {
            parts.Add(state.Trim().ToUpperInvariant());
        }

        if (!string.IsNullOrWhiteSpace(zipCode))
        {
            parts.Add(zipCode.Trim());
        }

        return parts.Count == 0 ? "Not set" : string.Join(", ", parts);
    }

    private static string FormatDate(DateTime? value)
    {
        return value?.ToLocalTime().ToString("MMM d, yyyy") ?? "Not set";
    }

    private static string FormatAskingPrice(decimal? value, string? currency)
    {
        if (!value.HasValue)
        {
            return "Not listed";
        }

        var normalizedCurrency = string.IsNullOrWhiteSpace(currency)
            ? "USD"
            : currency.Trim().ToUpperInvariant();
        return $"{normalizedCurrency} {value.Value:0.##}";
    }
}
