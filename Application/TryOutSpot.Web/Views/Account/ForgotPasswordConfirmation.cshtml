@{
    ViewData["Title"] = "Password Reset Sent";
}

<section class="account-page compact">
    <div class="account-heading">
        <p class="account-kicker">Check your email</p>
        <h1>Password reset instructions sent.</h1>
        <p>@(TempData["StatusMessage"] ?? "If an active account exists for that email address, password reset instructions will be sent.")</p>
    </div>

    <div class="form-actions">
        <a asp-action="Login" asp-controller="Account" class="btn btn-primary">Back to login</a>
    </div>
</section>
