@model AddTeamOrOrganizationPageModel

@{
    ViewData["Title"] = "Add Team Or Organization";
}

<section class="account-page compact">
    <div class="account-heading">
        <p class="account-kicker">Onboarding</p>
        <h1>Add team or organization</h1>
        <p>Create your first team or organization so you can post opportunities and manage registrations.</p>
        <p class="required-note"><span class="required-marker">*</span> Required field</p>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="account-alert">@statusMessage</div>
    }

    <section class="form-section">
        <form asp-action="AddTeamOrOrganization" asp-controller="Account" method="post" class="stacked-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-field">
                <label asp-for="CreateType" class="form-label">Create <span class="required-marker">*</span></label>
                <div class="form-actions">
                    <label class="account-check">
                        <input class="form-check-input" type="radio" name="CreateType" value="team" checked="@string.Equals(Model.CreateType, "team", StringComparison.OrdinalIgnoreCase)" />
                        <span>Team only</span>
                    </label>
                    <label class="account-check">
                        <input class="form-check-input" type="radio" name="CreateType" value="organization" checked="@string.Equals(Model.CreateType, "organization", StringComparison.OrdinalIgnoreCase)" />
                        <span>Organization and team</span>
                    </label>
                </div>
                <span asp-validation-for="CreateType" class="text-danger"></span>
            </div>

            <div class="form-grid two-column">
                <div class="form-field">
                    <label asp-for="TeamName" class="form-label">Team name <span class="required-marker">*</span></label>
                    <input asp-for="TeamName" class="form-control" autocomplete="organization" />
                    <span asp-validation-for="TeamName" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="OrganizationName" class="form-label">Organization name</label>
                    <input asp-for="OrganizationName" class="form-control" autocomplete="organization" />
                    <span asp-validation-for="OrganizationName" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="TeamRole" class="form-label">Your team role <span class="required-marker">*</span></label>
                    @if (Model.AvailableTeamRoleOptions.Count == 0)
                    {
                        <select asp-for="TeamRole" class="form-select" disabled>
                            <option value="">No eligible role selected</option>
                        </select>
                    }
                    else
                    {
                        <select asp-for="TeamRole" class="form-select">
                            @foreach (var role in Model.AvailableTeamRoleOptions)
                            {
                                <option value="@role">@FormatTeamRoleLabel(role)</option>
                            }
                        </select>
                    }
                    @if (Model.AvailableTeamRoleOptions.Count == 0)
                    {
                        <p class="section-help">Add a coach, team manager, academy director, or organization admin account type first.</p>
                    }
                    <span asp-validation-for="TeamRole" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="TeamLevel" class="form-label">Team level</label>
                    <input asp-for="TeamLevel" class="form-control" placeholder="Example: 14U, Varsity, Showcase" />
                    <span asp-validation-for="TeamLevel" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="ContactEmail" class="form-label">Contact email</label>
                    <input asp-for="ContactEmail" class="form-control" autocomplete="email" />
                    <span asp-validation-for="ContactEmail" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="ContactPhone" class="form-label">Contact phone</label>
                    <input asp-for="ContactPhone" class="form-control" autocomplete="tel" />
                    <span asp-validation-for="ContactPhone" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="ProfileImageUrl" class="form-label">Profile picture URL</label>
                    <input asp-for="ProfileImageUrl" class="form-control" placeholder="https://..." />
                    <span asp-validation-for="ProfileImageUrl" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="HighlightVideoUrl1" class="form-label">Highlight video link 1</label>
                    <input asp-for="HighlightVideoUrl1" class="form-control" placeholder="https://..." />
                    <span asp-validation-for="HighlightVideoUrl1" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="HighlightVideoUrl2" class="form-label">Highlight video link 2</label>
                    <input asp-for="HighlightVideoUrl2" class="form-control" placeholder="https://..." />
                    <span asp-validation-for="HighlightVideoUrl2" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="WebsiteUrl" class="form-label">Website URL</label>
                    <input asp-for="WebsiteUrl" class="form-control" placeholder="https://example.com" />
                    <span asp-validation-for="WebsiteUrl" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="City" class="form-label">City</label>
                    <input asp-for="City" class="form-control" autocomplete="address-level2" />
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="State" class="form-label">State</label>
                    <input asp-for="State" class="form-control" autocomplete="address-level1" maxlength="2" />
                    <span asp-validation-for="State" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="ZipCode" class="form-label">ZIP code</label>
                    <input asp-for="ZipCode" class="form-control" autocomplete="postal-code" />
                    <span asp-validation-for="ZipCode" class="text-danger"></span>
                </div>
            </div>

            <div>
                <label class="form-label">Social pages</label>
                <p class="section-help">For X, Instagram, and TikTok, enter username with or without @@.</p>
                <div class="form-grid two-column">
                    <div class="form-field">
                        <label asp-for="FacebookPageUrl" class="form-label">Facebook page</label>
                        <input asp-for="FacebookPageUrl" class="form-control" placeholder="https://facebook.com/yourpage" />
                        <span asp-validation-for="FacebookPageUrl" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="XPageUrl" class="form-label">X username</label>
                        <input asp-for="XPageUrl" class="form-control" placeholder="@@teamhandle" />
                        <span asp-validation-for="XPageUrl" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="InstagramUrl" class="form-label">Instagram username</label>
                        <input asp-for="InstagramUrl" class="form-control" placeholder="@@teamhandle" />
                        <span asp-validation-for="InstagramUrl" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="YouTubeUrl" class="form-label">YouTube</label>
                        <input asp-for="YouTubeUrl" class="form-control" placeholder="https://youtube.com/@@yourchannel" />
                        <span asp-validation-for="YouTubeUrl" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="TikTokUrl" class="form-label">TikTok username</label>
                        <input asp-for="TikTokUrl" class="form-control" placeholder="@@teamhandle" />
                        <span asp-validation-for="TikTokUrl" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div>
                <label class="form-label">Sports</label>
                @if (Model.AvailableSports.Count == 0)
                {
                    <p class="section-help">Sports options will appear here after the catalog is available.</p>
                }
                else
                {
                    <div class="account-type-grid compact-grid">
                        @foreach (var sport in Model.AvailableSports)
                        {
                            <label class="account-type-option" for="sport-@sport.Id">
                                <input class="form-check-input" id="sport-@sport.Id" name="SelectedSportIds" type="checkbox" value="@sport.Id" checked="@sport.IsSelected" />
                                <span>
                                    <strong>@sport.Name</strong>
                                    <small>Select every sport this team supports.</small>
                                </span>
                            </label>
                        }
                    </div>
                }
                <span asp-validation-for="SelectedSportIds" class="text-danger"></span>
            </div>

            <p class="section-help">Organization name is required only when creating an organization and team together.</p>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Save team setup</button>
                <a class="btn btn-outline-secondary" href="/account/onboarding">Back to onboarding</a>
            </div>
        </form>
    </section>
</section>

@functions {
    private static string FormatTeamRoleLabel(string teamRole)
    {
        return teamRole switch
        {
            TryOutSpotRoles.TeamManager => "Team manager",
            TryOutSpotRoles.AcademyDirector => "Academy director",
            TryOutSpotRoles.OrganizationAdmin => "Organization admin",
            _ => teamRole
        };
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
