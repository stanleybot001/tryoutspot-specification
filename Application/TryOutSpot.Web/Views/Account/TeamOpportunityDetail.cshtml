@model TeamOpportunityDetailPageModel

@{
    ViewData["Title"] = Model.Title;
    var shareUrl = Url.Action("TeamOpportunityDetail", "Account", new { opportunityId = Model.OpportunityId }, Context.Request.Scheme)
        ?? $"{Context.Request.Scheme}://{Context.Request.Host}/opportunities/{Model.OpportunityId}";
    var googleMapsUrl = BuildGoogleMapsUrl(Model.Address, Model.City, Model.State, Model.ZipCode);
    var locationText = FormatLocation(Model.City, Model.State, Model.ZipCode);
    var metaDescription = BuildMetaDescription(Model.Title, Model.TeamName, Model.SportName, locationText);
    var shareText = $"{Model.TeamName} posted {FormatOpportunityType(Model.Type).ToLowerInvariant()} details for {Model.Title} on TryOutSpot: {shareUrl}";
    var reportPageUrl = $"/opportunities/{Model.OpportunityId}/report";
    var reportHref = Model.ViewerIsAuthenticated
        ? reportPageUrl
        : $"/account/login?returnUrl={Uri.EscapeDataString(reportPageUrl)}";
    var showReportAction = !Model.ViewerIsAuthenticated || Model.ViewerCanReport;
    var opportunityReturnUrl = $"/opportunities/{Model.OpportunityId}";
    var encodedOpportunityReturnUrl = Uri.EscapeDataString(opportunityReturnUrl);
    var loginToRegisterUrl = $"/account/login?returnUrl={encodedOpportunityReturnUrl}";
    var createAccountToRegisterUrl = $"/account/register?returnUrl={encodedOpportunityReturnUrl}";
    var addPlayerProfileUrl = $"/account/onboarding/add-player-profile?createNew=true";
    var authenticationRequiredForRegistration = Model.RegistrationRequired
        && !Model.ViewerIsAuthenticated
        && string.Equals(
            Model.RegistrationClosedReason,
            "Sign in as a parent or player to register.",
            StringComparison.Ordinal);
    var playerProfileRequiredForRegistration = Model.RegistrationRequired
        && Model.ViewerIsAuthenticated
        && !Model.ViewerCanSubmitRegistration
        && string.Equals(
            Model.RegistrationClosedReason,
            "Add a player profile you can manage to submit registration.",
            StringComparison.Ordinal);
    var registrationCanContinue = Model.IsRegistrationOpen
        || authenticationRequiredForRegistration
        || playerProfileRequiredForRegistration;

    ViewData["MetaDescription"] = metaDescription;
    ViewData["CanonicalUrl"] = shareUrl;
    ViewData["OpenGraphTitle"] = $"{Model.Title} - TryOutSpot";
    ViewData["OpenGraphDescription"] = metaDescription;
    ViewData["OpenGraphImage"] = string.IsNullOrWhiteSpace(Model.TeamLogoImageUrl)
        ? "~/logo/MainLogoSized.png"
        : Model.TeamLogoImageUrl;
}

<section class="account-page">
    <div class="account-heading">
        <p class="account-kicker">Team opportunity</p>
        <h1>@Model.Title</h1>
        <p>@FormatOpportunityType(Model.Type) - @Model.SportName</p>
        <div class="listing-identity-row section-help">
            @if (!string.IsNullOrWhiteSpace(Model.TeamLogoImageUrl))
            {
                <img class="listing-hero-avatar" src="@Model.TeamLogoImageUrl" alt="@Model.TeamName logo" loading="lazy" />
            }
            <p>
                Team: <strong>@Model.TeamName</strong>
                @if (!string.IsNullOrWhiteSpace(Model.OrganizationName))
                {
                    <span> - @Model.OrganizationName</span>
                }
            </p>
        </div>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="account-alert">@statusMessage</div>
    }

    @if (Model.ViewerManagesTeam)
    {
        <section class="form-section share-panel">
            <div>
                <h2>Share this opportunity</h2>
                <p class="section-help">A public TryOutSpot link keeps registration, favorites, and reporting on-site.</p>
            </div>
            <div class="share-input-row">
                <input class="form-control" value="@shareUrl" readonly aria-label="Public opportunity link" />
                <button type="button" class="btn btn-outline-primary" data-copy-text="@shareUrl" data-copy-status="#opportunityShareStatus">Copy link</button>
                <button type="button" class="btn btn-primary" data-copy-text="@shareText" data-copy-status="#opportunityShareStatus">Copy post</button>
            </div>
            <p class="copy-status section-help" id="opportunityShareStatus" aria-live="polite"></p>
        </section>
    }

    <section class="form-section listing-detail-card">
        @if (showReportAction)
        {
            <a class="listing-report-icon" href="@reportHref" aria-label="Report listing" title="Report listing">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M5 4v16" />
                    <path d="M6 5h10l-1 4 1 4H6" />
                </svg>
            </a>
        }

        <div class="form-actions">
            @if (Model.ViewerIsAuthenticated)
            {
                if (Model.IsFavorited)
                {
                    <form class="inline-form"
                          asp-action="RemoveFavoriteTeamOpportunity"
                          asp-controller="Account"
                          asp-route-opportunityId="@Model.OpportunityId"
                          method="post">
                        <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                        <button type="submit" class="btn btn-outline-secondary">Remove favorite</button>
                    </form>
                }
                else
                {
                    <form class="inline-form"
                          asp-action="FavoriteTeamOpportunity"
                          asp-controller="Account"
                          asp-route-opportunityId="@Model.OpportunityId"
                          method="post">
                        <button type="submit" class="btn btn-primary">Add to favorites</button>
                    </form>
                }
            }
            else
            {
                <a class="btn btn-outline-primary" href="/account/login?returnUrl=@encodedOpportunityReturnUrl">Sign in to favorite</a>
            }
        </div>

        @if (Model.RegistrationRequired)
        {
            <div class="listing-primary-action-panel">
                <div>
                    <h2>Register for this tryout</h2>
                    @if (registrationCanContinue)
                    {
                        <p class="section-help">Registration is open through TryOutSpot.</p>
                    }
                    else
                    {
                        <p class="section-help">@Model.RegistrationClosedReason</p>
                    }
                </div>
                <div class="form-actions">
                    @if (authenticationRequiredForRegistration || (Model.IsRegistrationOpen && !Model.ViewerIsAuthenticated))
                    {
                        <a class="btn btn-primary" href="@createAccountToRegisterUrl">Create account to register</a>
                        <a class="btn btn-outline-primary" href="@loginToRegisterUrl">Sign in to register</a>
                    }
                    else if (Model.IsRegistrationOpen && Model.ViewerCanSubmitRegistration)
                    {
                        <a class="btn btn-primary" href="#tryout-registration">Register now</a>
                    }
                    else if (playerProfileRequiredForRegistration)
                    {
                        <a class="btn btn-primary" href="@addPlayerProfileUrl">Add player profile</a>
                        <a class="btn btn-outline-primary" href="#tryout-registration">View registration details</a>
                    }
                    else
                    {
                        <a class="btn btn-outline-secondary" href="#tryout-registration">View registration details</a>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="listing-primary-action-panel">
                <div>
                    <h2>Registration not required</h2>
                    <p class="section-help">Review the flyer and listing details, then use the team contact options if you need more information.</p>
                </div>
            </div>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.PdfUrl))
    {
        <section class="form-section listing-flyer-section">
            <h2>Flyer</h2>
            @if (Model.IsFlyerImage)
            {
                <div class="listing-flyer-image-frame">
                    <img src="@Model.PdfUrl" alt="@Model.Title flyer" class="listing-flyer-image" loading="lazy" />
                </div>
                <p class="section-help">
                    <a href="@Model.PdfUrl" target="_blank" rel="noopener">Open the flyer image in a new tab</a>.
                </p>
            }
            else
            {
                <div class="listing-pdf-embed">
                    <iframe
                        src="@Model.PdfUrl"
                        title="Opportunity flyer PDF"
                        loading="lazy">
                    </iframe>
                </div>
                <p class="section-help">
                    If the preview does not load in your browser, <a href="@Model.PdfUrl" target="_blank" rel="noopener">open the flyer in a new tab</a>.
                </p>
            }
        </section>
    }

    <section class="form-section">
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="readonly-field mb-3">
                @Model.Description
            </div>
        }
        <div class="team-summary-grid opportunity-summary-grid">
            @if (!string.IsNullOrWhiteSpace(Model.CompetitionLevel))
            {
                <div><span>Competition level</span><strong>@Model.CompetitionLevel</strong></div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.AgeGroup))
            {
                <div><span>Age group</span><strong>@Model.AgeGroup</strong></div>
            }
            @if (Model.RegistrationFee > 0 || Model.RegistrationRequired)
            {
                <div><span>Registration fee</span><strong>@FormatFee(Model.RegistrationFee)</strong></div>
            }
            @if (!Model.RegistrationRequired)
            {
                <div><span>Registration required</span><strong>No</strong></div>
            }
            else
            {
                <div><span>Registration required</span><strong>Yes</strong></div>
            }
            @if (Model.MaxParticipants.HasValue)
            {
                <div><span>Max registrations</span><strong>@Model.MaxParticipants.Value</strong></div>
            }
            @if (Model.RegistrationRequired)
            {
                <div><span>Current registrations</span><strong>@Model.ActiveRegistrationCount</strong></div>
            }
            @if (Model.RemainingRegistrationSpots.HasValue)
            {
                <div><span>Remaining spots</span><strong>@Model.RemainingRegistrationSpots.Value</strong></div>
            }
            @if (Model.RegistrationDeadline.HasValue)
            {
                <div><span>Registration deadline</span><strong>@FormatDate(Model.RegistrationDeadline)</strong></div>
            }
            @if (Model.EventDate.HasValue)
            {
                <div><span>Event start</span><strong>@FormatDate(Model.EventDate)</strong></div>
            }
            @if (Model.EventEndDate.HasValue)
            {
                <div><span>Event end</span><strong>@FormatDate(Model.EventEndDate)</strong></div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Location))
            {
                <div><span>Location</span><strong>@Model.Location</strong></div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Address))
            {
                <div><span>Address</span><strong>@Model.Address</strong></div>
            }
            @if (!string.IsNullOrWhiteSpace(googleMapsUrl))
            {
                <div><span>Map</span><strong><a href="@googleMapsUrl" target="_blank" rel="noopener">View on Google Maps</a></strong></div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.City) || !string.IsNullOrWhiteSpace(Model.State) || !string.IsNullOrWhiteSpace(Model.ZipCode))
            {
                <div><span>City/State/ZIP</span><strong>@FormatLocation(Model.City, Model.State, Model.ZipCode)</strong></div>
            }
            @if (Model.PublishedAt.HasValue)
            {
                <div><span>Published</span><strong>@FormatDate(Model.PublishedAt)</strong></div>
            }
            @if (Model.ExpiresAt.HasValue)
            {
                <div><span>Expires</span><strong>@FormatDate(Model.ExpiresAt)</strong></div>
            }
        </div>
    </section>

    <section class="form-section" id="tryout-registration">
        <h2>Tryout registration</h2>
        @if (!Model.RegistrationRequired)
        {
            <p class="section-help">This listing does not require registration.</p>
        }
        else
        {
            @if (Model.RegistrationFee > 0)
            {
                <p class="section-help">
                    Registration cost: <strong>@FormatFee(Model.RegistrationFee)</strong>. Payment is collected in person by the team.
                </p>
            }
            else
            {
                <p class="section-help">No registration cost is listed.</p>
            }

            @if (Model.RequiredRegistrationFields.Count > 0)
            {
                <p class="section-help">Required registration fields set by the team:</p>
                <ul>
                    @foreach (var requiredField in Model.RequiredRegistrationFields)
                    {
                        <li><strong>@requiredField.Label</strong>: @requiredField.Description</li>
                    }
                </ul>
            }

            @if (Model.WaiverRequired)
            {
                <p class="section-help"><strong>Waiver required:</strong> A signed waiver is required for this tryout.</p>
                @if (string.Equals(Model.WaiverMethod, "downloadable", System.StringComparison.OrdinalIgnoreCase))
                {
                    if (!string.IsNullOrWhiteSpace(Model.WaiverPdfUrl))
                    {
                        <p class="section-help">
                            <a href="@Model.WaiverPdfUrl" target="_blank" rel="noopener">Download waiver PDF</a>
                        </p>
                    }
                    else
                    {
                        <p class="section-help">Waiver PDF will be provided by the team.</p>
                    }
                }
                else
                {
                    <p class="section-help">Waiver will be handled at event check-in.</p>
                }

                @if (Model.WaiverReturnByEmail || Model.WaiverReturnInPerson)
                {
                    <p class="section-help mb-1">Accepted return options:</p>
                    <ul>
                        @if (Model.WaiverReturnByEmail)
                        {
                            <li>
                                Email signed waiver
                                @if (!string.IsNullOrWhiteSpace(Model.WaiverReturnEmail))
                                {
                                    <text>to <strong>@Model.WaiverReturnEmail</strong>.</text>
                                }
                                else
                                {
                                    <text>to the team contact email.</text>
                                }
                            </li>
                        }
                        @if (Model.WaiverReturnInPerson)
                        {
                            <li>Bring signed waiver to the event.</li>
                        }
                    </ul>
                }
            }

            @if (authenticationRequiredForRegistration)
            {
                <p class="section-help">
                    <a href="@createAccountToRegisterUrl">Create a player or parent account</a>
                    or <a href="@loginToRegisterUrl">sign in</a> to register.
                </p>
            }
            else if (!Model.IsRegistrationOpen)
            {
                <p class="section-help">@Model.RegistrationClosedReason</p>
            }
            else if (!Model.ViewerIsAuthenticated)
            {
                <p class="section-help">
                    <a href="@createAccountToRegisterUrl">Create a player or parent account</a>
                    or <a href="@loginToRegisterUrl">sign in</a> to register.
                </p>
            }
            else if (!Model.ViewerCanSubmitRegistration)
            {
                <p class="section-help">@Model.RegistrationClosedReason</p>
            }
            else
            {
                <form asp-action="RegisterForTeamOpportunity" asp-controller="Account" asp-route-opportunityId="@Model.OpportunityId" method="post" asp-antiforgery="true" class="stacked-form">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-field">
                        <label asp-for="RegistrationForm.PlayerId" class="form-label">Player profile <span class="required-marker">*</span></label>
                        <select asp-for="RegistrationForm.PlayerId" class="form-select">
                            <option value="">Select player</option>
                            @foreach (var player in Model.RegistrationPlayers.Where(player => !player.AlreadyRegistered))
                            {
                                <option value="@player.PlayerId">@player.DisplayName</option>
                            }
                        </select>
                        <span asp-validation-for="RegistrationForm.PlayerId" class="text-danger"></span>
                    </div>

                    @if (RequiresField(Model, "player_name"))
                    {
                        <div class="form-field">
                            <label asp-for="RegistrationForm.PlayerName" class="form-label">Player name <span class="required-marker">*</span></label>
                            <input asp-for="RegistrationForm.PlayerName" class="form-control" />
                            <span asp-validation-for="RegistrationForm.PlayerName" class="text-danger"></span>
                        </div>
                    }

                    @if (RequiresField(Model, "player_birthdate"))
                    {
                        <div class="form-field">
                            <label asp-for="RegistrationForm.PlayerBirthDate" class="form-label">Player birthdate <span class="required-marker">*</span></label>
                            <input asp-for="RegistrationForm.PlayerBirthDate" class="form-control" />
                            <span asp-validation-for="RegistrationForm.PlayerBirthDate" class="text-danger"></span>
                        </div>
                    }

                    @if (RequiresField(Model, "player_school"))
                    {
                        <div class="form-field">
                            <label asp-for="RegistrationForm.PlayerSchool" class="form-label">Player school <span class="required-marker">*</span></label>
                            <input asp-for="RegistrationForm.PlayerSchool" class="form-control" />
                            <span asp-validation-for="RegistrationForm.PlayerSchool" class="text-danger"></span>
                        </div>
                    }

                    @if (RequiresField(Model, "player_phone"))
                    {
                        <div class="form-field">
                            <label asp-for="RegistrationForm.PlayerPhone" class="form-label">Player cell phone <span class="required-marker">*</span></label>
                            <input asp-for="RegistrationForm.PlayerPhone" class="form-control" autocomplete="tel" />
                            <span asp-validation-for="RegistrationForm.PlayerPhone" class="text-danger"></span>
                        </div>
                    }

                    @if (RequiresField(Model, "player_email"))
                    {
                        <div class="form-field">
                            <label asp-for="RegistrationForm.PlayerEmail" class="form-label">Player email address <span class="required-marker">*</span></label>
                            <input asp-for="RegistrationForm.PlayerEmail" class="form-control" autocomplete="email" />
                            <span asp-validation-for="RegistrationForm.PlayerEmail" class="text-danger"></span>
                        </div>
                    }

                    @if (RequiresField(Model, "guardian_name"))
                    {
                        <div class="form-field">
                            <label asp-for="RegistrationForm.GuardianName" class="form-label">Guardian name <span class="required-marker">*</span></label>
                            <input asp-for="RegistrationForm.GuardianName" class="form-control" />
                            <span asp-validation-for="RegistrationForm.GuardianName" class="text-danger"></span>
                        </div>
                    }

                    @if (RequiresField(Model, "guardian_email"))
                    {
                        <div class="form-field">
                            <label asp-for="RegistrationForm.GuardianEmail" class="form-label">Guardian email <span class="required-marker">*</span></label>
                            <input asp-for="RegistrationForm.GuardianEmail" class="form-control" autocomplete="email" />
                            <span asp-validation-for="RegistrationForm.GuardianEmail" class="text-danger"></span>
                        </div>
                    }

                    @if (RequiresField(Model, "guardian_phone"))
                    {
                        <div class="form-field">
                            <label asp-for="RegistrationForm.GuardianPhone" class="form-label">Guardian phone <span class="required-marker">*</span></label>
                            <input asp-for="RegistrationForm.GuardianPhone" class="form-control" autocomplete="tel" />
                            <span asp-validation-for="RegistrationForm.GuardianPhone" class="text-danger"></span>
                        </div>
                    }

                    @if (RequiresField(Model, "emergency_contact_name"))
                    {
                        <div class="form-field">
                            <label asp-for="RegistrationForm.EmergencyContactName" class="form-label">Emergency contact name <span class="required-marker">*</span></label>
                            <input asp-for="RegistrationForm.EmergencyContactName" class="form-control" />
                            <span asp-validation-for="RegistrationForm.EmergencyContactName" class="text-danger"></span>
                        </div>
                    }

                    @if (RequiresField(Model, "emergency_contact_phone"))
                    {
                        <div class="form-field">
                            <label asp-for="RegistrationForm.EmergencyContactPhone" class="form-label">Emergency contact phone <span class="required-marker">*</span></label>
                            <input asp-for="RegistrationForm.EmergencyContactPhone" class="form-control" autocomplete="tel" />
                            <span asp-validation-for="RegistrationForm.EmergencyContactPhone" class="text-danger"></span>
                        </div>
                    }

                    @if (RequiresField(Model, "medical_info"))
                    {
                        <div class="form-field">
                            <label asp-for="RegistrationForm.MedicalInfo" class="form-label">Medical notes <span class="required-marker">*</span></label>
                            <textarea asp-for="RegistrationForm.MedicalInfo" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="RegistrationForm.MedicalInfo" class="text-danger"></span>
                        </div>
                    }

                    @if (RequiresField(Model, "additional_notes"))
                    {
                        <div class="form-field">
                            <label asp-for="RegistrationForm.AdditionalNotes" class="form-label">Additional notes <span class="required-marker">*</span></label>
                            <textarea asp-for="RegistrationForm.AdditionalNotes" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="RegistrationForm.AdditionalNotes" class="text-danger"></span>
                        </div>
                    }

                    @if (RequiresField(Model, "waiver_signature"))
                    {
                        <label class="sms-consent-option" for="RegistrationForm_WaiverAcknowledged">
                            <input asp-for="RegistrationForm.WaiverAcknowledged" class="form-check-input" />
                            <span>I acknowledge the waiver requirement for this tryout. <span class="required-marker">*</span></span>
                        </label>
                        <span asp-validation-for="RegistrationForm.WaiverAcknowledged" class="text-danger"></span>

                        <div class="form-field">
                            <label asp-for="RegistrationForm.WaiverSignerName" class="form-label">Waiver signer name <span class="required-marker">*</span></label>
                            <input asp-for="RegistrationForm.WaiverSignerName" class="form-control" />
                            <span asp-validation-for="RegistrationForm.WaiverSignerName" class="text-danger"></span>
                        </div>
                    }

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Submit registration</button>
                    </div>
                </form>
            }
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.RequiredEquipment)
        || !string.IsNullOrWhiteSpace(Model.WhatToBring)
        || !string.IsNullOrWhiteSpace(Model.SpecialInstructions))
    {
        <section class="form-section">
            <h2>Preparation details</h2>
            @if (!string.IsNullOrWhiteSpace(Model.RequiredEquipment))
            {
                <p><strong>Required equipment</strong></p>
                <p class="section-help">@Model.RequiredEquipment</p>
            }
            @if (!string.IsNullOrWhiteSpace(Model.WhatToBring))
            {
                <p><strong>What to bring</strong></p>
                <p class="section-help">@Model.WhatToBring</p>
            }
            @if (!string.IsNullOrWhiteSpace(Model.SpecialInstructions))
            {
                <p><strong>Special instructions</strong></p>
                <p class="section-help">@Model.SpecialInstructions</p>
            }
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ContactEmail)
        || !string.IsNullOrWhiteSpace(Model.ContactPhone)
        || !string.IsNullOrWhiteSpace(Model.WebsiteUrl)
        || !string.IsNullOrWhiteSpace(Model.PdfUrl))
    {
        <section class="form-section">
            <h2>Contact and links</h2>
            @if (!string.IsNullOrWhiteSpace(Model.TeamDescription))
            {
                <div class="readonly-field mb-3">
                    @Model.TeamDescription
                </div>
            }
            <div class="team-summary-grid">
                @if (!string.IsNullOrWhiteSpace(Model.ContactEmail))
                {
                    <div><span>Contact email</span><strong>@Model.ContactEmail</strong></div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.ContactPhone))
                {
                    <div><span>Contact phone</span><strong>@Model.ContactPhone</strong></div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.WebsiteUrl))
                {
                    <div><span>Website</span><strong><a href="@Model.WebsiteUrl" target="_blank" rel="noopener">Open website</a></strong></div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.PdfUrl))
                {
                    <div><span>Flyer</span><strong><a href="@Model.PdfUrl" target="_blank" rel="noopener">Open flyer</a></strong></div>
                }
            </div>
        </section>
    }
    else if (!Model.IsContactInfoVisible)
    {
        <section class="form-section">
            <h2>Contact and links</h2>
            @if (!string.IsNullOrWhiteSpace(Model.TeamDescription))
            {
                <div class="readonly-field mb-3">
                    @Model.TeamDescription
                </div>
            }
            <p class="section-help">This team has chosen to keep contact details and external links private.</p>
        </section>
    }
</section>

@functions {
    private static string FormatOpportunityType(string type)
    {
        if (string.IsNullOrWhiteSpace(type))
        {
            return "Opportunity";
        }

        return type
            .Replace("_", " ", StringComparison.Ordinal)
            .Trim()
            .ToLowerInvariant() switch
        {
            "tryout" => "Tryout",
            "roster opening" => "Roster opening",
            "pickup player" => "Pickup player",
            "camp" => "Camp",
            "clinic" => "Clinic",
            "tournament" => "Tournament",
            "private workout" => "Private workout",
            var fallback => char.ToUpperInvariant(fallback[0]) + fallback[1..]
        };
    }

    private static string FormatDate(DateTime? date)
    {
        return date?.ToLocalTime().ToString("MMM d, yyyy") ?? string.Empty;
    }

    private static string FormatLocation(string? city, string? state, string? zipCode)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(city))
        {
            parts.Add(city.Trim());
        }

        if (!string.IsNullOrWhiteSpace(state))
        {
            parts.Add(state.Trim().ToUpperInvariant());
        }

        if (!string.IsNullOrWhiteSpace(zipCode))
        {
            parts.Add(zipCode.Trim());
        }

        return string.Join(", ", parts);
    }

    private static string FormatFee(decimal amount)
    {
        return amount <= 0 ? "Free" : amount.ToString("C");
    }

    private static string BuildMetaDescription(string title, string teamName, string sportName, string location)
    {
        var locationText = string.IsNullOrWhiteSpace(location) ? string.Empty : $" in {location}";
        return $"{teamName} posted {title}, a {sportName} opportunity{locationText}. View details and register through TryOutSpot.";
    }

    private static string? BuildGoogleMapsUrl(string? address, string? city, string? state, string? zipCode)
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(address))
        {
            parts.Add(address.Trim());
        }

        if (!string.IsNullOrWhiteSpace(city))
        {
            parts.Add(city.Trim());
        }

        if (!string.IsNullOrWhiteSpace(state))
        {
            parts.Add(state.Trim());
        }

        if (!string.IsNullOrWhiteSpace(zipCode))
        {
            parts.Add(zipCode.Trim());
        }

        if (parts.Count == 0)
        {
            return null;
        }

        var query = Uri.EscapeDataString(string.Join(", ", parts));
        return $"https://www.google.com/maps/search/?api=1&query={query}";
    }

    private static bool RequiresField(TeamOpportunityDetailPageModel model, string code)
    {
        return model.RequiredRegistrationFields.Any(
            field => string.Equals(field.Code, code, StringComparison.OrdinalIgnoreCase));
    }
}

