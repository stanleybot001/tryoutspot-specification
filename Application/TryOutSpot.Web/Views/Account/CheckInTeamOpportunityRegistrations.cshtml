@model TeamOpportunityRegistrationSharePageModel

@{
    Layout = null;
    var checkInUrl = BuildDocumentUrl("check-in");
    var evaluationUrl = BuildDocumentUrl("evaluation");
    var shareSubject = $"TryOutSpot check-in roster: {Model.Title}";
    var shareBody = BuildShareBody(checkInUrl, "Check-in roster");
    var emailHref = $"mailto:?subject={Uri.EscapeDataString(shareSubject)}&body={Uri.EscapeDataString(shareBody)}";
    var smsHref = $"sms:?body={Uri.EscapeDataString(shareBody)}";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Check-in roster - @Model.Title - TryOutSpot</title>
    <style>
        :root {
            color-scheme: light;
            --ink: #111827;
            --muted: #4b5563;
            --line: #cbd5e1;
            --soft: #f8fafc;
            --accent: #0f62fe;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #eef2f7;
            color: var(--ink);
            font-family: Arial, Helvetica, sans-serif;
            font-size: 12px;
            line-height: 1.35;
        }

        .print-shell {
            width: min(1500px, calc(100% - 24px));
            margin: 16px auto;
            background: #ffffff;
            border: 1px solid var(--line);
            border-radius: 6px;
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
            padding: 18px;
        }

        .document-toolbar {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 14px;
        }

        .document-toolbar a,
        .document-toolbar button {
            border: 1px solid var(--accent);
            border-radius: 4px;
            background: #ffffff;
            color: var(--accent);
            cursor: pointer;
            font: inherit;
            font-weight: 700;
            padding: 7px 10px;
            text-decoration: none;
        }

        .document-toolbar .primary {
            background: var(--accent);
            color: #ffffff;
        }

        .document-header {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            gap: 16px;
            align-items: start;
            border-bottom: 2px solid var(--ink);
            padding-bottom: 10px;
            margin-bottom: 10px;
        }

        .document-kicker {
            margin: 0 0 4px;
            color: var(--muted);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }

        h1 {
            margin: 0 0 5px;
            font-size: 26px;
            line-height: 1.05;
        }

        .document-subtitle {
            margin: 0;
            color: var(--muted);
            font-size: 13px;
        }

        .document-count {
            border: 2px solid var(--ink);
            min-width: 120px;
            padding: 8px;
            text-align: center;
        }

        .document-count strong {
            display: block;
            font-size: 30px;
            line-height: 1;
        }

        .meta-grid {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            border: 1px solid var(--line);
            margin-bottom: 12px;
        }

        .meta-grid div {
            border-right: 1px solid var(--line);
            border-bottom: 1px solid var(--line);
            padding: 6px 8px;
        }

        .meta-grid div:nth-child(5n) {
            border-right: 0;
        }

        .meta-grid span,
        .small-label {
            display: block;
            color: var(--muted);
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.03em;
            text-transform: uppercase;
        }

        .meta-grid strong {
            display: block;
            margin-top: 2px;
            font-size: 12px;
        }

        .table-scroll {
            overflow-x: auto;
        }

        table {
            width: 100%;
            min-width: 1180px;
            border-collapse: collapse;
        }

        th,
        td {
            border: 1px solid var(--line);
            padding: 5px 6px;
            text-align: left;
            vertical-align: top;
        }

        th {
            background: #e5edf7;
            font-size: 10px;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        tbody tr:nth-child(even) {
            background: var(--soft);
        }

        .tryout-number {
            font-size: 20px;
            font-weight: 800;
            text-align: center;
            white-space: nowrap;
        }

        .player-name {
            font-weight: 800;
            font-size: 13px;
        }

        .favorite-marker {
            color: #a16207;
            font-weight: 800;
        }

        .stacked {
            display: grid;
            gap: 2px;
        }

        .muted {
            color: var(--muted);
        }

        .checkbox-cell {
            display: inline-block;
            width: 18px;
            height: 18px;
            border: 2px solid var(--ink);
            vertical-align: middle;
        }

        .notes-cell {
            min-width: 210px;
        }

        @@media (max-width: 760px) {
            body {
                font-size: 13px;
            }

            .print-shell {
                width: 100%;
                margin: 0;
                border: 0;
                border-radius: 0;
                padding: 12px;
            }

            .document-header,
            .meta-grid {
                grid-template-columns: 1fr;
            }

            .meta-grid div,
            .meta-grid div:nth-child(5n) {
                border-right: 0;
            }
        }

        @@media print {
            @@page {
                size: landscape;
                margin: 0.35in;
            }

            body {
                background: #ffffff;
                font-size: 10px;
            }

            .print-shell {
                width: 100%;
                margin: 0;
                border: 0;
                border-radius: 0;
                box-shadow: none;
                padding: 0;
            }

            .document-toolbar {
                display: none;
            }

            table {
                min-width: 0;
            }

            th,
            td {
                padding: 4px;
            }

            tr {
                break-inside: avoid;
            }
        }
    </style>
</head>
<body>
    <main class="print-shell">
        <nav class="document-toolbar" aria-label="Document actions">
            <button type="button" class="primary" onclick="window.print()">Print / Save PDF</button>
            <a href="@emailHref">Email link</a>
            <a href="@smsHref">Text link</a>
            <a href="@evaluationUrl">Evaluation sheet</a>
            <a href="/account/onboarding/team-opportunities/@Model.TeamId">Back to listing</a>
        </nav>

        <header class="document-header">
            <div>
                <p class="document-kicker">Tryout check-in roster</p>
                <h1>@Model.Title</h1>
                <p class="document-subtitle">@Model.TeamName@if (!string.IsNullOrWhiteSpace(Model.OrganizationName))
                    {
                        @: - @Model.OrganizationName
                    }</p>
            </div>
            <div class="document-count">
                <span class="small-label">Players</span>
                <strong>@Model.RegistrantCount</strong>
            </div>
        </header>

        <section class="meta-grid" aria-label="Tryout details">
            <div><span>Sport</span><strong>@Model.SportName</strong></div>
            <div><span>Type</span><strong>@FormatOpportunityType(Model.Type)</strong></div>
            <div><span>Age group</span><strong>@FormatValue(Model.AgeGroup)</strong></div>
            <div><span>Competition</span><strong>@FormatValue(Model.CompetitionLevel)</strong></div>
            <div><span>Generated</span><strong>@FormatDateTime(Model.GeneratedAt)</strong></div>
            <div><span>Event start</span><strong>@FormatDate(Model.EventDate)</strong></div>
            <div><span>Event end</span><strong>@FormatDate(Model.EventEndDate)</strong></div>
            <div><span>Location</span><strong>@FormatValue(Model.Location)</strong></div>
            <div><span>Address</span><strong>@FormatValue(Model.Address)</strong></div>
            <div><span>City/State/ZIP</span><strong>@FormatLocation(Model.City, Model.State, Model.ZipCode)</strong></div>
        </section>

        @if (Model.Registrants.Count == 0)
        {
            <p>No players have registered for this event yet.</p>
        }
        else
        {
            <section class="table-scroll" aria-label="Check-in roster">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Tryout #</th>
                            <th scope="col">Player</th>
                            <th scope="col">Age</th>
                            <th scope="col">Arrived</th>
                            <th scope="col">Status</th>
                            <th scope="col">Waiver</th>
                            <th scope="col">Player contact</th>
                            <th scope="col">Guardian contact</th>
                            <th scope="col">Emergency</th>
                            <th scope="col">Medical / notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var registrant in Model.Registrants)
                        {
                            <tr>
                                <td class="tryout-number">@registrant.TryoutNumber</td>
                                <td>
                                    <div class="player-name">
                                        @registrant.PlayerName
                                        @if (registrant.IsFavoritedByViewer)
                                        {
                                            <span class="favorite-marker" title="Favorited player listing">&#9733;</span>
                                        }
                                    </div>
                                    <div class="muted">@FormatValue(registrant.SchoolName)</div>
                                </td>
                                <td>@FormatAge(registrant.PlayerAge)</td>
                                <td><span class="checkbox-cell" aria-hidden="true"></span></td>
                                <td>
                                    <div>@registrant.StatusLabel</div>
                                    <div class="muted">Registered @FormatDateTime(registrant.RegisteredAt)</div>
                                    @if (registrant.CheckedInAt.HasValue)
                                    {
                                        <div class="muted">Checked in @FormatDateTime(registrant.CheckedInAt.Value)</div>
                                    }
                                </td>
                                <td>
                                    <div>@(registrant.IsWaiverReceived ? "Received" : "Missing")</div>
                                    @if (registrant.WaiverReceivedAt.HasValue)
                                    {
                                        <div class="muted">@FormatDateTime(registrant.WaiverReceivedAt.Value)</div>
                                    }
                                </td>
                                <td>@FormatContactLines(registrant.PlayerPhone, registrant.PlayerEmail)</td>
                                <td>
                                    <div>@FormatValue(registrant.GuardianName)</div>
                                    @FormatContactLines(registrant.GuardianPhone, registrant.GuardianEmail)
                                </td>
                                <td>
                                    <div>@FormatValue(registrant.EmergencyContactName)</div>
                                    <div class="muted">@FormatValue(registrant.EmergencyContactPhone)</div>
                                </td>
                                <td class="notes-cell">
                                    @if (!string.IsNullOrWhiteSpace(registrant.MedicalInfo))
                                    {
                                        <div><strong>Medical:</strong> @registrant.MedicalInfo</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(registrant.AdditionalNotes))
                                    {
                                        <div><strong>Notes:</strong> @registrant.AdditionalNotes</div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }
    </main>
</body>
</html>

@functions {
    private string BuildDocumentUrl(string documentType)
    {
        var path = $"/account/onboarding/team-opportunities/{Model.TeamId}/{Model.OpportunityId}/registrations/{documentType}";
        return $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}{path}";
    }

    private string BuildShareBody(string documentUrl, string documentLabel)
    {
        return string.Join(
            Environment.NewLine,
            [
                $"{documentLabel} for {Model.Title}",
                $"{Model.TeamName} - {FormatDate(Model.EventDate)}",
                documentUrl
            ]);
    }

    private static string FormatOpportunityType(string type)
    {
        if (string.IsNullOrWhiteSpace(type))
        {
            return "Opportunity";
        }

        return type.Replace("_", " ", StringComparison.Ordinal).Trim().ToLowerInvariant() switch
        {
            "tryout" => "Tryout",
            "roster opening" => "Roster opening",
            "pickup player" => "Pickup player",
            "camp" => "Camp",
            "clinic" => "Clinic",
            "tournament" => "Tournament",
            "private workout" => "Private workout",
            var fallback => char.ToUpperInvariant(fallback[0]) + fallback[1..]
        };
    }

    private static string FormatLocation(string? city, string? state, string? zipCode)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(city))
        {
            parts.Add(city.Trim());
        }

        if (!string.IsNullOrWhiteSpace(state))
        {
            parts.Add(state.Trim().ToUpperInvariant());
        }

        if (!string.IsNullOrWhiteSpace(zipCode))
        {
            parts.Add(zipCode.Trim());
        }

        return parts.Count == 0 ? "Not set" : string.Join(", ", parts);
    }

    private static string FormatDate(DateTime? date)
    {
        return date?.ToLocalTime().ToString("MMM d, yyyy") ?? "Not set";
    }

    private static string FormatDateTime(DateTime date)
    {
        return date.ToLocalTime().ToString("MMM d, yyyy h:mm tt");
    }

    private static string FormatValue(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Not set" : value.Trim();
    }

    private static string FormatAge(int? age)
    {
        return age?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "n/a";
    }

    private static Microsoft.AspNetCore.Html.IHtmlContent FormatContactLines(string? phone, string? email)
    {
        var builder = new Microsoft.AspNetCore.Html.HtmlContentBuilder();
        if (string.IsNullOrWhiteSpace(phone) && string.IsNullOrWhiteSpace(email))
        {
            builder.AppendHtml("<span class=\"muted\">Not listed</span>");
            return builder;
        }

        if (!string.IsNullOrWhiteSpace(phone))
        {
            builder.AppendHtml("<div>");
            builder.Append(phone.Trim());
            builder.AppendHtml("</div>");
        }

        if (!string.IsNullOrWhiteSpace(email))
        {
            builder.AppendHtml("<div class=\"muted\">");
            builder.Append(email.Trim());
            builder.AppendHtml("</div>");
        }

        return builder;
    }
}
