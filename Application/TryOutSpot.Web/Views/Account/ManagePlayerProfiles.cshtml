@model ManagePlayerProfilesPageModel

@{
    ViewData["Title"] = "Manage Player Profiles";
    var headingTitle = Model.IsParentOrGuardianAccount
        ? "Manage child/player profiles."
        : "Manage your player profiles.";
    var headingDescription = Model.IsParentOrGuardianAccount
        ? "These are the player profiles tied to your parent/guardian account. Your adult account holder profile stays separate."
        : "Edit, deactivate, and add players from one place.";
    var addButtonLabel = Model.IsParentOrGuardianAccount ? "Add another child/player" : "Add another player";
}

<section class="account-page">
    <div class="account-heading">
        <p class="account-kicker">Player profiles</p>
        <h1>@headingTitle</h1>
        <p>@headingDescription</p>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="account-alert">@statusMessage</div>
    }

    <section class="form-section">
        <div class="form-actions mb-2">
            <a class="btn btn-primary" href="/account/onboarding/add-player-profile?createNew=true">@addButtonLabel</a>
            <a class="btn btn-outline-secondary" href="/account/onboarding">Back to dashboard</a>
        </div>

        @if (Model.Profiles.Count == 0)
        {
            <p class="section-help">No managed players yet. Add the first player profile to continue onboarding.</p>
        }
        else
        {
            <div class="plan-list">
                @foreach (var profile in Model.Profiles)
                {
                    var publicProfileUrl = Url.Action("PlayerProfileDetail", "Account", new { playerId = profile.PlayerId }, Context.Request.Scheme)
                        ?? $"{Context.Request.Scheme}://{Context.Request.Host}/players/{profile.PlayerId}";
                    var profileShareText = $"View {profile.FullName}'s TryOutSpot player profile: {publicProfileUrl}";

                    <article class="plan-row plan-row-stack opportunity-row published">
                        <div class="opportunity-row-head">
                            <div>
                                <strong>@profile.FullName</strong>
                                <span>@FormatRelationship(profile.Relationship)</span>
                            </div>
                            <div class="team-metric-inline">
                                <span>@(profile.IsSearchable ? "Player searchable" : "Hidden from player search")</span>
                                <span>@FormatContactVisibility(profile.ContactVisibility)</span>
                            </div>
                        </div>

                        <div class="team-summary-grid opportunity-summary-grid">
                            <div><span>Date of birth</span><strong>@profile.DateOfBirth.ToString("MMM d, yyyy")</strong></div>
                            <div><span>Location</span><strong>@FormatLocation(profile.City, profile.State, profile.ZipCode)</strong></div>
                            <div><span>Contact email</span><strong>@(string.IsNullOrWhiteSpace(profile.ContactEmail) ? "Not set" : profile.ContactEmail)</strong></div>
                            <div><span>Contact phone</span><strong>@(string.IsNullOrWhiteSpace(profile.ContactPhone) ? "Not set" : profile.ContactPhone)</strong></div>
                            <div><span>Sports</span><strong>@(profile.Sports.Length == 0 ? "Not set" : string.Join(", ", profile.Sports))</strong></div>
                            <div><span>Active listings</span><strong>@profile.ActiveListingCount</strong></div>
                            <div><span>Last updated</span><strong>@profile.UpdatedAt.ToLocalTime().ToString("MMM d, yyyy")</strong></div>
                        </div>

                        <div class="form-actions">
                            @if (profile.IsSearchable)
                            {
                                <a class="btn btn-outline-primary" href="@publicProfileUrl" target="_blank" rel="noopener">View public profile</a>
                                <button type="button"
                                        class="btn btn-outline-primary"
                                        data-copy-text="@publicProfileUrl"
                                        data-copy-status="#shareStatus-@profile.PlayerId">Copy link</button>
                                <button type="button"
                                        class="btn btn-primary"
                                        data-copy-text="@profileShareText"
                                        data-copy-status="#shareStatus-@profile.PlayerId">Copy post</button>
                                <span class="copy-status section-help" id="shareStatus-@profile.PlayerId" aria-live="polite"></span>
                            }
                            <a class="btn btn-outline-primary" href="/account/onboarding/player-profiles/@profile.PlayerId/edit">Edit</a>
                            <form class="inline-form"
                                  asp-action="DeactivatePlayerProfile"
                                  asp-controller="Account"
                                  asp-route-playerId="@profile.PlayerId"
                                  method="post">
                                <button type="submit" class="btn btn-outline-danger">Deactivate</button>
                            </form>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</section>

@functions {
    private static string FormatLocation(string? city, string? state, string? zipCode)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(city))
        {
            parts.Add(city.Trim());
        }

        if (!string.IsNullOrWhiteSpace(state))
        {
            parts.Add(state.Trim().ToUpperInvariant());
        }

        if (!string.IsNullOrWhiteSpace(zipCode))
        {
            parts.Add(zipCode.Trim());
        }

        return parts.Count == 0 ? "Not set" : string.Join(", ", parts);
    }

    private static string FormatContactVisibility(string? value)
    {
        return value switch
        {
            "Public" => "Contact public",
            "VerifiedCoachesOnly" => "Contact for verified coaches",
            _ => "Contact limited"
        };
    }

    private static string FormatRelationship(string? value)
    {
        return value switch
        {
            "Parent" => "You are the parent",
            "Guardian" => "You are the guardian",
            "Self" => "Self-managed player",
            "Coach" => "You are the coach",
            "Other" => "Managed by this account",
            _ => string.IsNullOrWhiteSpace(value) ? "Managed by this account" : value
        };
    }
}
