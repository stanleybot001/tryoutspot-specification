@model AddPlayerProfilePageModel

@{
    var isEditMode = Model.IsEditMode && Model.PlayerId.HasValue;
    var headingTitle = isEditMode ? "Edit player profile" : "Add player profile";
    var headingDescription = isEditMode
        ? "Update player profile details, visibility, sports, and recruiting links."
        : "Create a player profile so you can start registering for tryouts and opportunities.";
    var submitLabel = isEditMode ? "Save player changes" : "Save player profile";
    var formAction = isEditMode
        ? Url.Action("EditPlayerProfile", "Account", new { playerId = Model.PlayerId!.Value })
        : Url.Action("AddPlayerProfile", "Account");
    var fallbackBackUrl = isEditMode ? "/account/onboarding/player-profiles" : "/account/onboarding";
    var backUrl = string.IsNullOrWhiteSpace(Model.ReturnUrl) ? fallbackBackUrl : Model.ReturnUrl;

    ViewData["Title"] = isEditMode ? "Edit Player Profile" : "Add Player Profile";
}

<section class="account-page compact">
    <div class="account-heading">
        <p class="account-kicker">Onboarding</p>
        <h1>@headingTitle</h1>
        <p>@headingDescription</p>
        <p class="required-note"><span class="required-marker">*</span> Required field</p>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="account-alert">@statusMessage</div>
    }

    <section class="form-section">
        <form method="post" action="@formAction" enctype="multipart/form-data" class="stacked-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input asp-for="PlayerId" type="hidden" />
            <input asp-for="IsEditMode" type="hidden" />
            <input asp-for="ReturnUrl" type="hidden" />
            <input asp-for="ProfileImageUrl" type="hidden" />
            <input asp-for="EnhancedProfileVisibleToTeams" type="hidden" />

            @if (!Model.EnhancedProfileVisibleToTeams)
            {
                <div class="section-help mb-3">
                    Enhanced profile fields can still be saved on Free Player/Parent accounts, but teams will not see those enhanced details, media, or highlights until Premium Player is active.
                </div>
            }

            <div class="form-grid two-column">
                <div class="form-field">
                    <label asp-for="FirstName" class="form-label">Player first name <span class="required-marker">*</span></label>
                    <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="LastName" class="form-label">Player last name <span class="required-marker">*</span></label>
                    <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="DateOfBirth" class="form-label">Player date of birth <span class="required-marker">*</span></label>
                    <input asp-for="DateOfBirth" class="form-control" />
                    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="Relationship" class="form-label">Relationship <span class="required-marker">*</span></label>
                    <select asp-for="Relationship" class="form-select">
                        @foreach (var relationshipOption in Model.AvailableRelationshipOptions)
                        {
                            <option value="@relationshipOption">@relationshipOption</option>
                        }
                    </select>
                    <span asp-validation-for="Relationship" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="ContactEmail" class="form-label">Contact email</label>
                    <input asp-for="ContactEmail" class="form-control" autocomplete="email" />
                    <span asp-validation-for="ContactEmail" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="ContactPhone" class="form-label">Contact phone</label>
                    <input asp-for="ContactPhone" class="form-control" autocomplete="tel" />
                    <span asp-validation-for="ContactPhone" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="ProfileImageUpload" class="form-label">Profile picture upload</label>
                    <input asp-for="ProfileImageUpload" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp,.svg,image/jpeg,image/png,image/webp,image/svg+xml" />
                    <span asp-validation-for="ProfileImageUpload" class="text-danger"></span>
                    @if (!string.IsNullOrWhiteSpace(Model.CurrentProfileImageUrl))
                    {
                        <div class="mt-2">
                            <img class="listing-profile-image" src="@Model.CurrentProfileImageUrl" alt="Current profile picture" loading="lazy" onerror="this.style.display='none'" />
                        </div>
                        <label class="account-check mt-2">
                            <input asp-for="RemoveProfileImage" class="form-check-input" />
                            <span>Remove current profile picture</span>
                        </label>
                    }
                </div>
                <div class="form-field">
                    <label asp-for="HighlightVideoUrl1" class="form-label">Highlight video link 1</label>
                    <input asp-for="HighlightVideoUrl1" class="form-control" placeholder="https://..." />
                    <span asp-validation-for="HighlightVideoUrl1" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="HighlightVideoUrl2" class="form-label">Highlight video link 2</label>
                    <input asp-for="HighlightVideoUrl2" class="form-control" placeholder="https://..." />
                    <span asp-validation-for="HighlightVideoUrl2" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="SchoolName" class="form-label">School name</label>
                    <input asp-for="SchoolName" class="form-control" autocomplete="organization" />
                    <span asp-validation-for="SchoolName" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="CurrentTeamName" class="form-label">Club or team name</label>
                    <input asp-for="CurrentTeamName" class="form-control" autocomplete="organization" />
                    <span asp-validation-for="CurrentTeamName" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="GraduationYear" class="form-label">Graduation year</label>
                    <input asp-for="GraduationYear" class="form-control" inputmode="numeric" />
                    <span asp-validation-for="GraduationYear" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="Height" class="form-label">Height</label>
                    <input asp-for="Height" class="form-control" placeholder="Example: 5'8&quot;" />
                    <span asp-validation-for="Height" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="Weight" class="form-label">Weight</label>
                    <input asp-for="Weight" class="form-control" placeholder="Example: 145 lb" />
                    <span asp-validation-for="Weight" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="ThrowsHand" class="form-label">Throws hand</label>
                    <input asp-for="ThrowsHand" class="form-control" placeholder="Right, Left, or Switch" />
                    <span asp-validation-for="ThrowsHand" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="BatsHand" class="form-label">Bats hand</label>
                    <input asp-for="BatsHand" class="form-control" placeholder="Right, Left, or Switch" />
                    <span asp-validation-for="BatsHand" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="City" class="form-label">City</label>
                    <input asp-for="City" class="form-control" autocomplete="address-level2" />
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="State" class="form-label">State</label>
                    <input asp-for="State" class="form-control" autocomplete="address-level1" maxlength="2" />
                    <span asp-validation-for="State" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="ZipCode" class="form-label">ZIP code</label>
                    <input asp-for="ZipCode" class="form-control" autocomplete="postal-code" />
                    <span asp-validation-for="ZipCode" class="text-danger"></span>
                </div>
            </div>

            <label class="sms-consent-option" for="IsSearchable">
                <input asp-for="IsSearchable" class="form-check-input" />
                <span>Allow this player profile to appear in search results.</span>
            </label>

            <div class="form-field">
                <label asp-for="ContactVisibility" class="form-label">Contact visibility <span class="required-marker">*</span></label>
                <select asp-for="ContactVisibility" class="form-select">
                    @foreach (var visibilityOption in Model.AvailableContactVisibilityOptions)
                    {
                        <option value="@visibilityOption">@FormatContactVisibilityLabel(visibilityOption)</option>
                    }
                </select>
                <span asp-validation-for="ContactVisibility" class="text-danger"></span>
            </div>

            <div>
                <label class="form-label">Social pages</label>
                <p class="section-help">For X, Instagram, and TikTok, enter username with or without @@.</p>
                <div class="form-grid two-column">
                    <div class="form-field">
                        <label asp-for="FacebookPageUrl" class="form-label">Facebook page</label>
                        <input asp-for="FacebookPageUrl" class="form-control" placeholder="https://facebook.com/..." />
                        <span asp-validation-for="FacebookPageUrl" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="XPageUrl" class="form-label">X username</label>
                        <input asp-for="XPageUrl" class="form-control" placeholder="@@username" />
                        <span asp-validation-for="XPageUrl" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="InstagramUrl" class="form-label">Instagram username</label>
                        <input asp-for="InstagramUrl" class="form-control" placeholder="@@username" />
                        <span asp-validation-for="InstagramUrl" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="YouTubeUrl" class="form-label">YouTube</label>
                        <input asp-for="YouTubeUrl" class="form-control" placeholder="https://youtube.com/..." />
                        <span asp-validation-for="YouTubeUrl" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="TikTokUrl" class="form-label">TikTok username</label>
                        <input asp-for="TikTokUrl" class="form-control" placeholder="@@username" />
                        <span asp-validation-for="TikTokUrl" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div>
                <label class="form-label">Recruiting profiles</label>
                <p class="section-help">Add external recruiting profile links when they exist.</p>
                <div class="form-grid two-column">
                    <div class="form-field">
                        <label asp-for="SportsRecruitsProfileUrl" class="form-label">SportsRecruits</label>
                        <input asp-for="SportsRecruitsProfileUrl" class="form-control" placeholder="https://sportsrecruits.com/..." />
                        <span asp-validation-for="SportsRecruitsProfileUrl" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="FieldLevelProfileUrl" class="form-label">FieldLevel</label>
                        <input asp-for="FieldLevelProfileUrl" class="form-control" placeholder="https://fieldlevel.com/..." />
                        <span asp-validation-for="FieldLevelProfileUrl" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="NcsaProfileUrl" class="form-label">NCSA</label>
                        <input asp-for="NcsaProfileUrl" class="form-control" placeholder="https://recruit-match.ncsasports.org/..." />
                        <span asp-validation-for="NcsaProfileUrl" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="OtherRecruitingProfileUrl" class="form-label">Other recruiting profile</label>
                        <input asp-for="OtherRecruitingProfileUrl" class="form-control" placeholder="https://..." />
                        <span asp-validation-for="OtherRecruitingProfileUrl" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <label class="sms-consent-option" for="CanManage">
                <input asp-for="CanManage" class="form-check-input" />
                <span>Allow this account to manage the player profile.</span>
            </label>

            <div>
                <label class="form-label">Sports</label>
                @if (Model.SportDetails.Count == 0)
                {
                    <p class="section-help">Sports options will appear here after the catalog is available.</p>
                }
                else
                {
                    <div class="account-type-grid compact-grid">
                        @for (var sportIndex = 0; sportIndex < Model.SportDetails.Count; sportIndex++)
                        {
                            var sport = Model.SportDetails[sportIndex];
                            <label class="account-type-option" for="sport-@sport.SportId">
                                <input asp-for="SportDetails[sportIndex].IsSelected" class="form-check-input" id="sport-@sport.SportId" />
                                <input asp-for="SportDetails[sportIndex].SportId" type="hidden" />
                                <input asp-for="SportDetails[sportIndex].SportName" type="hidden" />
                                <span>
                                    <strong>@sport.SportName</strong>
                                    <small>Select every sport this player participates in.</small>
                                </span>
                            </label>
                            <div class="form-grid two-column">
                                <div class="form-field">
                                    <label asp-for="SportDetails[sportIndex].SkillLevel" class="form-label">Ability level</label>
                                    <input asp-for="SportDetails[sportIndex].SkillLevel" class="form-control" placeholder="Example: A, AA, AAA, Varsity, Club" />
                                    <span asp-validation-for="SportDetails[sportIndex].SkillLevel" class="text-danger"></span>
                                </div>
                                <div class="form-field">
                                    <label asp-for="SportDetails[sportIndex].PrimaryPosition" class="form-label">Primary position</label>
                                    <input asp-for="SportDetails[sportIndex].PrimaryPosition" class="form-control" placeholder="Example: Pitcher, Shortstop, Midfielder" />
                                    <span asp-validation-for="SportDetails[sportIndex].PrimaryPosition" class="text-danger"></span>
                                </div>
                                <div class="form-field">
                                    <label asp-for="SportDetails[sportIndex].SecondaryPositions" class="form-label">Secondary positions</label>
                                    <input asp-for="SportDetails[sportIndex].SecondaryPositions" class="form-control" placeholder="Optional additional positions" />
                                    <span asp-validation-for="SportDetails[sportIndex].SecondaryPositions" class="text-danger"></span>
                                </div>
                            </div>
                        }
                    </div>
                }
                <span asp-validation-for="SportDetails" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">@submitLabel</button>
                <a class="btn btn-outline-secondary" href="@backUrl">Back</a>
            </div>
        </form>
    </section>
</section>

@functions {
    private static string FormatContactVisibilityLabel(string visibility)
    {
        return visibility switch
        {
            "Public" => "Visible to everyone",
            "VerifiedCoachesOnly" => "Visible only to verified coaches",
            _ => visibility
        };
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
