@model OnboardingPageModel
@using TryOutSpot.Web.Billing
@using TryOutSpot.Web.Identity

@{
    ViewData["Title"] = "Account Setup";
    var hiddenWhenCompleteStepCodes = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
    {
        "choose_account_types",
        "verify_email",
        "choose_plan"
    };
    var visibleSteps = Model.Steps
        .Where(step => !step.IsComplete || !hiddenWhenCompleteStepCodes.Contains(step.Code))
        .ToArray();
    var accountMenuSteps = visibleSteps
        .Where(step => IsAccountSetupStep(step.Code))
        .ToArray();
    var playerMenuSteps = visibleSteps
        .Where(step => IsPlayerDashboardStep(step.Code))
        .ToArray();
    var teamMenuSteps = visibleSteps
        .Where(step => IsTeamDashboardStep(step.Code))
        .ToArray();
    var savedMenuSteps = visibleSteps
        .Where(step => string.Equals(step.Code, "my_favorites", StringComparison.OrdinalIgnoreCase))
        .ToArray();
    var menuGroups = new[]
    {
        new { Title = "Account setup", Steps = accountMenuSteps },
        new { Title = "Player dashboard", Steps = playerMenuSteps },
        new { Title = "Team dashboard", Steps = teamMenuSteps },
        new { Title = "Saved items", Steps = savedMenuSteps }
    }
    .Where(group => group.Steps.Length > 0)
    .ToArray();
    var showAccountTypeEditor = !Model.Steps.Any(step =>
        string.Equals(step.Code, "choose_account_types", StringComparison.OrdinalIgnoreCase) && step.IsComplete);
}

<section class="account-page">
    <div class="account-heading">
        <p class="account-kicker">Setup</p>
        <h1>@Model.FirstName, finish the pieces that matter.</h1>
        <p>TryOutSpot keeps signup light. These items help tailor the next screens for players, parents, coaches, and organization staff.</p>
        <p class="required-note"><span class="required-marker">*</span> Required item</p>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="account-alert">@statusMessage</div>
    }

    <section class="account-summary-strip">
        <div>
            <span>Email</span>
            <strong>@Model.Email</strong>
        </div>
        <div>
            <span>Email status</span>
            <strong>@(Model.EmailConfirmed ? "Verified" : "Not verified")</strong>
        </div>
        <div>
            <span>Phone</span>
            <strong>@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Not added" : Model.PhoneNumber)</strong>
        </div>
    </section>

    <div class="onboarding-layout">
        <section class="form-section dashboard-menu-section">
            <h2>Dashboard menu</h2>
            <p class="section-help">Use these shortcuts to manage the areas tied to your account.</p>
            @if (menuGroups.Length == 0)
            {
                <p class="section-help">No dashboard actions are available yet.</p>
            }
            else
            {
                @foreach (var group in menuGroups)
                {
                    <div class="dashboard-menu-group">
                        <h3>@group.Title</h3>
                        <div class="dashboard-menu-grid">
                            @foreach (var step in group.Steps)
                            {
                                <article class="dashboard-menu-card @(step.IsComplete ? "complete" : string.Empty)">
                                    <div>
                                        <strong>@step.Title</strong>
                                        <span>@step.Description</span>
                                    </div>
                                    <div class="dashboard-menu-action">
                                        @if (step.IsRequired)
                                        {
                                            <span class="required-pill">Required</span>
                                        }
                                        <span class="dashboard-menu-state">@(step.IsComplete ? "Complete" : "Next")</span>
                                        @if (TryGetStepOpenUrl(step.Code, out var stepOpenUrl))
                                        {
                                            <a class="btn btn-sm btn-outline-primary" href="@stepOpenUrl">@(step.IsComplete ? "View" : "Open")</a>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    </div>
                }
            }
        </section>

        @if (showAccountTypeEditor)
        {
            <section class="form-section" id="onboarding-account-types">
                <h2>Account type <span class="required-marker">*</span></h2>
                <p class="section-help">Choose one role per bundle. Roles control plan eligibility. Active subscription controls unlocked features.</p>
                <form asp-action="UpdateOnboardingAccountTypes" asp-controller="Account" method="post">
                    @{
                        var selectedPlayerParentRole = Model.AccountTypes
                            .FirstOrDefault(role => string.Equals(role, "Parent", StringComparison.OrdinalIgnoreCase)
                                || string.Equals(role, "Player", StringComparison.OrdinalIgnoreCase));
                        var selectedTeamRole = Model.AccountTypes
                            .FirstOrDefault(TryOutSpotRoles.IsTeamBundleRole);
                    }
                    <h3 class="form-label">Parent/Player bundle</h3>
                    <div class="account-type-grid compact-grid">
                        <label class="account-type-option" for="onboarding-player-parent-none">
                            <input class="form-check-input" id="onboarding-player-parent-none" name="playerParentRole" type="radio" value="" @(string.IsNullOrWhiteSpace(selectedPlayerParentRole) ? "checked" : null) />
                            <span>
                                <strong>None</strong>
                                <small>No parent/player role selected.</small>
                            </span>
                        </label>
                        @foreach (var accountType in Model.AvailableAccountTypes.Where(option =>
                            string.Equals(option.Name, "Parent", StringComparison.OrdinalIgnoreCase)
                            || string.Equals(option.Name, "Player", StringComparison.OrdinalIgnoreCase)))
                        {
                            <label class="account-type-option" for="onboarding-account-type-@accountType.Name">
                                <input class="form-check-input"
                                       id="onboarding-account-type-@accountType.Name"
                                       name="playerParentRole"
                                       type="radio"
                                       value="@accountType.Name"
                                       @(string.Equals(selectedPlayerParentRole, accountType.Name, StringComparison.OrdinalIgnoreCase) ? "checked" : null) />
                                <span>
                                    <strong>@accountType.Label</strong>
                                    <small>@accountType.Description</small>
                                </span>
                            </label>
                        }
                    </div>
                    <h3 class="form-label mt-3">Team bundle</h3>
                    <div class="account-type-grid compact-grid">
                        <label class="account-type-option" for="onboarding-team-role-none">
                            <input class="form-check-input" id="onboarding-team-role-none" name="teamRole" type="radio" value="" @(string.IsNullOrWhiteSpace(selectedTeamRole) ? "checked" : null) />
                            <span>
                                <strong>None</strong>
                                <small>No team role selected.</small>
                            </span>
                        </label>
                        @foreach (var accountType in Model.AvailableAccountTypes.Where(option =>
                            TryOutSpotRoles.IsTeamBundleRole(option.Name)))
                        {
                            <label class="account-type-option" for="onboarding-account-type-@accountType.Name">
                                <input class="form-check-input"
                                       id="onboarding-account-type-@accountType.Name"
                                       name="teamRole"
                                       type="radio"
                                       value="@accountType.Name"
                                       @(string.Equals(selectedTeamRole, accountType.Name, StringComparison.OrdinalIgnoreCase) ? "checked" : null) />
                                <span>
                                    <strong>@accountType.Label</strong>
                                    <small>@accountType.Description</small>
                                </span>
                            </label>
                        }
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Update account type</button>
                    </div>
                </form>
            </section>
        }
    </div>

    @if (Model.ShowTryoutRegistrationList)
    {
        <section class="form-section">
            <h2>Upcoming tryout registrations</h2>
            @if (Model.UpcomingTryoutRegistrations.Count == 0)
            {
                <p class="section-help">
                    No upcoming tryout registrations yet. Register a player from any tryout listing and it will appear here.
                </p>
            }
            else
            {
                <div class="registration-agenda-list">
                    @foreach (var registration in Model.UpcomingTryoutRegistrations)
                    {
                        <article class="registration-agenda-row">
                            <div class="registration-agenda-date">
                                <strong>@FormatAgendaDate(registration.EventDate ?? registration.EventEndDate ?? registration.RegistrationDeadline)</strong>
                                <span>@FormatAgendaDateLabel(registration)</span>
                            </div>
                            <div class="registration-agenda-details">
                                <div class="registration-agenda-head">
                                    <strong>@registration.OpportunityTitle</strong>
                                    <span class="registration-status-pill @GetRegistrationStatusClass(registration.StatusLabel)">@registration.StatusLabel</span>
                                </div>
                                <span>
                                    Player: <strong>@registration.PlayerName</strong> · Team: <strong>@registration.TeamName</strong> · @registration.SportName
                                </span>
                                @if (!string.IsNullOrWhiteSpace(registration.City) || !string.IsNullOrWhiteSpace(registration.State))
                                {
                                    <span>@FormatLocation(registration.City, registration.State)</span>
                                }
                            </div>
                            <div class="registration-agenda-actions">
                                <a class="btn btn-sm btn-outline-primary" href="/opportunities/@registration.OpportunityId">View</a>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    }

    @if (Model.ShowRecommendedPlans)
    {
        <section class="form-section">
            <h2>Recommended plan options</h2>
            <p class="section-help">Stay on the free path or upgrade now. Paid plans redirect to Stripe checkout; free plans apply immediately.</p>
            <div class="plan-list">
                @foreach (var plan in Model.RecommendedPlans)
                {
                    <div class="plan-row">
                        <div>
                            <strong>@plan.Name</strong>
                            <span>@plan.Audience</span>
                            <p>@plan.Description</p>
                        </div>
                        <div class="plan-price">
                            @if (TryOutSpotBillingCatalog.RequiresAnnualCommitment(plan.Code) && plan.AnnualAmount is not null)
                            {
                                <strong>@($"{plan.AnnualAmount.Value:C0}/yr")</strong>
                                <span>Annual only</span>
                            }
                            else
                            {
                                <strong>@FormatMonthlyAmount(plan.MonthlyAmount)</strong>
                            }
                            @if (plan.TrialDays is not null)
                            {
                                <span>@plan.TrialDays-day trial</span>
                            }
                            else if (!plan.RequiresStripeSubscription)
                            {
                                <span>No payment required</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <form asp-action="Logout" asp-controller="Account" method="post" class="logout-form">
        <button type="submit" class="btn btn-outline-secondary">Sign out</button>
    </form>
</section>

@functions {
    private static string FormatMonthlyAmount(decimal monthlyAmount)
    {
        return monthlyAmount <= 0 ? "Free" : $"{monthlyAmount:C0}/mo";
    }

    private bool TryGetStepOpenUrl(string stepCode, out string url)
    {
        url = stepCode switch
        {
            "choose_account_types" => "#onboarding-account-types",
            "verify_email" => "/account/settings",
            "add_player_profile" => "/account/onboarding/add-player-profile",
            "manage_player_listings" => "/account/onboarding/player-listings",
            "add_team_or_organization" => "/account/onboarding/add-team-or-organization",
            "manage_team_opportunities" => "/account/onboarding/team-opportunities",
            "my_favorites" => "/account/onboarding/favorites",
            "choose_plan" => "/account/onboarding/choose-plan",
            _ => string.Empty
        };

        return !string.IsNullOrWhiteSpace(url);
    }

    private static bool IsAccountSetupStep(string stepCode)
    {
        return string.Equals(stepCode, "choose_account_types", StringComparison.OrdinalIgnoreCase)
            || string.Equals(stepCode, "verify_email", StringComparison.OrdinalIgnoreCase)
            || string.Equals(stepCode, "choose_plan", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsPlayerDashboardStep(string stepCode)
    {
        return string.Equals(stepCode, "add_player_profile", StringComparison.OrdinalIgnoreCase)
            || string.Equals(stepCode, "manage_player_listings", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsTeamDashboardStep(string stepCode)
    {
        return string.Equals(stepCode, "add_team_or_organization", StringComparison.OrdinalIgnoreCase)
            || string.Equals(stepCode, "manage_team_opportunities", StringComparison.OrdinalIgnoreCase);
    }

    private static string FormatAgendaDate(DateTime? value)
    {
        return value.HasValue
            ? value.Value.ToLocalTime().ToString("MMM d, yyyy")
            : "Date not set";
    }

    private static string FormatAgendaDateLabel(OnboardingTryoutRegistrationPageItem registration)
    {
        if (registration.EventDate.HasValue)
        {
            return "Event start";
        }

        if (registration.EventEndDate.HasValue)
        {
            return "Event end";
        }

        if (registration.RegistrationDeadline.HasValue)
        {
            return "Registration deadline";
        }

        return $"Registered {registration.RegisteredAt.ToLocalTime():MMM d}";
    }

    private static string FormatLocation(string? city, string? state)
    {
        var normalizedCity = string.IsNullOrWhiteSpace(city) ? null : city.Trim();
        var normalizedState = string.IsNullOrWhiteSpace(state) ? null : state.Trim().ToUpperInvariant();
        if (normalizedCity is null)
        {
            return normalizedState ?? "Location not set";
        }

        if (normalizedState is null)
        {
            return normalizedCity;
        }

        return $"{normalizedCity}, {normalizedState}";
    }

    private static string GetRegistrationStatusClass(string statusLabel)
    {
        return statusLabel switch
        {
            "Accepted" => "registration-status-approved",
            "Approved" => "registration-status-approved",
            "Declined" => "registration-status-declined",
            _ => "registration-status-pending"
        };
    }
}
