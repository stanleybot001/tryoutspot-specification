@model ResetPasswordPageModel

@{
    ViewData["Title"] = "Reset Password";
}

<section class="account-page compact">
    <div class="account-heading">
        <p class="account-kicker">Account recovery</p>
        <h1>Choose a new password.</h1>
        <p class="required-note"><span class="required-marker">*</span> Required field</p>
    </div>

    <form asp-action="ResetPassword" asp-controller="Account" method="post" class="account-form">
        <input asp-for="Token" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <section class="form-section">
            <div class="form-grid">
                <div class="form-field">
                    <label asp-for="Email" class="form-label">Email address <span class="required-marker">*</span></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="NewPassword" class="form-label">New password <span class="required-marker">*</span></label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="ConfirmNewPassword" class="form-label">Confirm new password <span class="required-marker">*</span></label>
                    <input asp-for="ConfirmNewPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                </div>
            </div>
        </section>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Reset password</button>
            <a asp-action="Login" asp-controller="Account" class="btn btn-link">Back to login</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
