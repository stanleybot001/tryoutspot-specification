@model LoginPageModel

@{
    ViewData["Title"] = "Login";
}

<section class="account-page compact">
    <div class="account-heading">
        <p class="account-kicker">Welcome back</p>
        <h1>Sign in to TryOutSpot.</h1>
        <p class="required-note"><span class="required-marker">*</span> Required field</p>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="account-alert">@statusMessage</div>
    }

    <form asp-action="Login" asp-controller="Account" method="post" class="account-form">
        <input asp-for="ReturnUrl" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <section class="form-section">
            <div class="form-grid">
                <div class="form-field">
                    <label asp-for="Email" class="form-label">Email address <span class="required-marker">*</span></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="Password" class="form-label">Password <span class="required-marker">*</span></label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <label class="form-check account-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <span class="form-check-label">Keep me signed in</span>
                </label>
            </div>
        </section>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Sign in</button>
            <a asp-action="ForgotPassword" asp-controller="Account" class="btn btn-link">Forgot password?</a>
        </div>
    </form>

    @if (Model.ShowResendVerificationPrompt)
    {
        <section class="form-section">
            <h2>Need a new verification email?</h2>
            <p class="section-help">If your account is not verified yet, resend the verification link below.</p>
            <form asp-action="ResendVerificationEmailFromLogin" asp-controller="Account" method="post" class="stacked-form">
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <div class="form-grid">
                    <div class="form-field">
                        <label class="form-label" for="resend-email">Email address</label>
                        <input id="resend-email" name="email" type="email" class="form-control" value="@Model.Email" autocomplete="email" />
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-outline-primary">Resend verification email</button>
                </div>
            </form>
        </section>
    }

    <div class="account-divider"><span>or</span></div>

    <div class="social-login-actions">
        @if (Model.GoogleIsConfigured)
        {
            <a class="btn btn-outline-dark" asp-action="ExternalLogin" asp-controller="Account" asp-route-provider="Google" asp-route-returnUrl="@Model.ReturnUrl" asp-route-source="login">Continue with Google</a>
        }
        @if (Model.FacebookIsConfigured)
        {
            <a class="btn btn-outline-dark" asp-action="ExternalLogin" asp-controller="Account" asp-route-provider="Facebook" asp-route-returnUrl="@Model.ReturnUrl" asp-route-source="login">Continue with Facebook</a>
        }
        @if (Model.AppleIsConfigured)
        {
            <a class="btn btn-outline-dark" asp-action="ExternalLogin" asp-controller="Account" asp-route-provider="Apple" asp-route-returnUrl="@Model.ReturnUrl" asp-route-source="login">Continue with Apple</a>
        }
        @if (!Model.GoogleIsConfigured && !Model.FacebookIsConfigured && !Model.AppleIsConfigured)
        {
            <p class="section-help">Social sign-in is not configured for this environment.</p>
        }
    </div>

    <p class="account-secondary-link">
        New to TryOutSpot?
        <a asp-action="Register" asp-controller="Account" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a>
    </p>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
