@model AccountSettingsPageModel
@using TryOutSpot.Web.Billing
@using TryOutSpot.Web.Identity
@using TryOutSpot.Web.Models.Billing

@{
    ViewData["Title"] = "Account Settings";
}

<section class="account-page">
    <div class="account-heading">
        <p class="account-kicker">Account settings</p>
        <h1>Manage your access, profile, and notifications.</h1>
        <p>These settings control how you sign in, how TryOutSpot identifies your account type, and which account messages you can receive.</p>
        <p class="required-note"><span class="required-marker">*</span> Required field</p>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="account-alert">@statusMessage</div>
    }

    <section class="account-summary-strip settings-summary">
        <div>
            <span>Email</span>
            <strong>@Model.Email.CurrentEmail</strong>
        </div>
        <div>
            <span>Email status</span>
            <strong>@(Model.Email.EmailConfirmed ? "Verified" : "Not verified")</strong>
        </div>
        <div>
            <span>Phone status</span>
            <strong>@(Model.Phone.PhoneNumberConfirmed ? "Verified" : "Not verified")</strong>
        </div>
        <div>
            <span>Membership</span>
            <strong>@Model.CurrentPlanName</strong>
            @if (!string.IsNullOrWhiteSpace(Model.CurrentPlanStatus))
            {
                <small>@Model.CurrentPlanStatus</small>
            }
        </div>
    </section>

    <div class="settings-layout">
        <section class="form-section">
            <h2>Profile</h2>
            <form asp-action="UpdateProfile" asp-controller="Account" method="post" class="stacked-form">
                <div class="form-grid two-column">
                    <div class="form-field">
                        <label asp-for="Profile.FirstName" class="form-label">First name <span class="required-marker">*</span></label>
                        <input asp-for="Profile.FirstName" class="form-control" autocomplete="given-name" />
                        <span asp-validation-for="Profile.FirstName" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="Profile.LastName" class="form-label">Last name <span class="required-marker">*</span></label>
                        <input asp-for="Profile.LastName" class="form-control" autocomplete="family-name" />
                        <span asp-validation-for="Profile.LastName" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="Profile.DateOfBirth" class="form-label">Date of birth</label>
                        <input asp-for="Profile.DateOfBirth" class="form-control" />
                        <span asp-validation-for="Profile.DateOfBirth" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="Profile.ZipCode" class="form-label">ZIP code</label>
                        <input asp-for="Profile.ZipCode" class="form-control" autocomplete="postal-code" />
                        <span asp-validation-for="Profile.ZipCode" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="Profile.City" class="form-label">City</label>
                        <input asp-for="Profile.City" class="form-control" autocomplete="address-level2" />
                        <span asp-validation-for="Profile.City" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="Profile.State" class="form-label">State</label>
                        <input asp-for="Profile.State" class="form-control" autocomplete="address-level1" maxlength="2" />
                        <span asp-validation-for="Profile.State" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Save profile</button>
                </div>
            </form>
        </section>

        <section class="form-section">
            <h2>Email</h2>
            <p class="section-help">Changing email requires confirmation from the new address.</p>
            <form asp-action="RequestEmailChange" asp-controller="Account" method="post" class="stacked-form">
                <input asp-for="Email.CurrentEmail" type="hidden" />
                <input asp-for="Email.EmailConfirmed" type="hidden" />
                <input asp-for="Email.HasLocalPassword" type="hidden" />
                <div class="form-grid two-column">
                    <div class="form-field">
                        <label asp-for="Email.NewEmail" class="form-label">New email address <span class="required-marker">*</span></label>
                        <input asp-for="Email.NewEmail" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email.NewEmail" class="text-danger"></span>
                    </div>
                    @if (Model.Email.HasLocalPassword)
                    {
                        <div class="form-field">
                            <label asp-for="Email.CurrentPassword" class="form-label">Current password <span class="required-marker">*</span></label>
                            <input asp-for="Email.CurrentPassword" class="form-control" autocomplete="current-password" />
                            <span asp-validation-for="Email.CurrentPassword" class="text-danger"></span>
                        </div>
                    }
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Send confirmation</button>
                </div>
            </form>
        </section>

        <section class="form-section">
            <h2>Phone</h2>
            <p class="section-help">Phone verification uses transactional SMS and requires SMS consent.</p>
            <form asp-action="UpdatePhone" asp-controller="Account" method="post" class="stacked-form">
                <div class="form-grid two-column">
                    <div class="form-field">
                        <label asp-for="Phone.PhoneNumber" class="form-label">Phone number</label>
                        <input asp-for="Phone.PhoneNumber" class="form-control" autocomplete="tel" />
                        <span asp-validation-for="Phone.PhoneNumber" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Status</label>
                        <div class="readonly-field">@(Model.Phone.PhoneNumberConfirmed ? "Verified" : "Not verified")</div>
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Save phone</button>
                    <button type="submit" class="btn btn-outline-primary" formaction="/account/settings/send-phone-code">Send code</button>
                </div>
            </form>

            <form asp-action="VerifyPhone" asp-controller="Account" method="post" class="stacked-form tight-form">
                <input asp-for="Phone.PhoneNumber" type="hidden" />
                <div class="form-grid two-column">
                    <div class="form-field">
                        <label asp-for="Phone.VerificationCode" class="form-label">Verification code</label>
                        <input asp-for="Phone.VerificationCode" class="form-control" autocomplete="one-time-code" />
                        <span asp-validation-for="Phone.VerificationCode" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Verify phone</button>
                </div>
            </form>
        </section>

        <section class="form-section">
            <h2>Password</h2>
            <p class="section-help">
                @(Model.Password.HasLocalPassword
                    ? "Update the password used with email sign-in."
                    : "Add a password so this account can also sign in with email.")
            </p>
            <form asp-action="UpdatePassword" asp-controller="Account" method="post" class="stacked-form">
                <input asp-for="Password.HasLocalPassword" type="hidden" />
                <div class="form-grid two-column">
                    @if (Model.Password.HasLocalPassword)
                    {
                        <div class="form-field">
                            <label asp-for="Password.CurrentPassword" class="form-label">Current password <span class="required-marker">*</span></label>
                            <input asp-for="Password.CurrentPassword" class="form-control" autocomplete="current-password" />
                            <span asp-validation-for="Password.CurrentPassword" class="text-danger"></span>
                        </div>
                    }
                    <div class="form-field">
                        <label asp-for="Password.NewPassword" class="form-label">New password <span class="required-marker">*</span></label>
                        <input asp-for="Password.NewPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Password.NewPassword" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="Password.ConfirmNewPassword" class="form-label">Confirm new password <span class="required-marker">*</span></label>
                        <input asp-for="Password.ConfirmNewPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Password.ConfirmNewPassword" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">@(Model.Password.HasLocalPassword ? "Update password" : "Add password")</button>
                </div>
            </form>
        </section>

        <section class="form-section settings-wide">
            <h2>Account types <span class="required-marker">*</span></h2>
            <p class="section-help">Choose one role per bundle. Roles control plan eligibility. Active subscription controls unlocked features.</p>
            <form asp-action="UpdateAccountTypes" asp-controller="Account" method="post" class="stacked-form">
                @{
                    var selectedPlayerParentRole = Model.AccountTypes.AccountTypes
                        .FirstOrDefault(role => string.Equals(role, "Parent", StringComparison.OrdinalIgnoreCase)
                            || string.Equals(role, "Player", StringComparison.OrdinalIgnoreCase));
                    var selectedTeamRole = Model.AccountTypes.AccountTypes
                        .FirstOrDefault(TryOutSpotRoles.IsTeamBundleRole);
                }
                <h3 class="form-label">Parent/Player bundle</h3>
                <div class="account-type-grid">
                    <label class="account-type-option" for="settings-player-parent-none">
                        <input class="form-check-input" id="settings-player-parent-none" name="playerParentRole" type="radio" value="" @(string.IsNullOrWhiteSpace(selectedPlayerParentRole) ? "checked" : null) />
                        <span>
                            <strong>None</strong>
                            <small>No parent/player role selected.</small>
                        </span>
                    </label>
                    @foreach (var accountType in Model.AccountTypes.AvailableAccountTypes.Where(option =>
                        string.Equals(option.Name, "Parent", StringComparison.OrdinalIgnoreCase)
                        || string.Equals(option.Name, "Player", StringComparison.OrdinalIgnoreCase)))
                    {
                        <label class="account-type-option" for="settings-account-type-@accountType.Name">
                            <input class="form-check-input"
                                   id="settings-account-type-@accountType.Name"
                                   name="playerParentRole"
                                   type="radio"
                                   value="@accountType.Name"
                                   @(string.Equals(selectedPlayerParentRole, accountType.Name, StringComparison.OrdinalIgnoreCase) ? "checked" : null) />
                            <span>
                                <strong>@accountType.Label</strong>
                                <small>@accountType.Description</small>
                            </span>
                        </label>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(selectedPlayerParentRole))
                {
                    var primaryMembership = Model.MembershipSummaries.FirstOrDefault();
                    var playerParentPlanName = primaryMembership?.PlanName ?? Model.CurrentPlanName ?? "No plan selected";
                    var playerParentPlanStatus = primaryMembership?.Status ?? Model.CurrentPlanStatus;
                    <div class="team-access-snapshot">
                        <p class="team-access-title">Parent/Player access snapshot</p>
                        <p class="team-access-line"><strong>Role:</strong> @selectedPlayerParentRole</p>
                        <p class="team-access-line"><strong>Current plan:</strong> @playerParentPlanName</p>
                        @if (!string.IsNullOrWhiteSpace(playerParentPlanStatus))
                        {
                            <p class="team-access-line"><strong>Status:</strong> @playerParentPlanStatus</p>
                        }
                    </div>
                }
                <h3 class="form-label mt-3">Team bundle</h3>
                <div class="account-type-grid">
                    <label class="account-type-option" for="settings-team-role-none">
                        <input class="form-check-input" id="settings-team-role-none" name="teamRole" type="radio" value="" @(string.IsNullOrWhiteSpace(selectedTeamRole) ? "checked" : null) />
                        <span>
                            <strong>None</strong>
                            <small>No team role selected.</small>
                        </span>
                    </label>
                    @foreach (var accountType in Model.AccountTypes.AvailableAccountTypes.Where(option =>
                        TryOutSpotRoles.IsTeamBundleRole(option.Name)))
                    {
                        <label class="account-type-option" for="settings-account-type-@accountType.Name">
                            <input class="form-check-input"
                                   id="settings-account-type-@accountType.Name"
                                   name="teamRole"
                                   type="radio"
                                   value="@accountType.Name"
                                   @(string.Equals(selectedTeamRole, accountType.Name, StringComparison.OrdinalIgnoreCase) ? "checked" : null) />
                            <span>
                                <strong>@accountType.Label</strong>
                                <small>@accountType.Description</small>
                            </span>
                        </label>
                    }
                </div>
                @if (TryOutSpotRoles.IsTeamBundleRole(selectedTeamRole))
                {
                    var primaryMembership = Model.MembershipSummaries.FirstOrDefault();
                    var teamPlanName = primaryMembership?.PlanName ?? Model.CurrentPlanName ?? "No team plan selected";
                    var teamPlanStatus = primaryMembership?.Status ?? Model.CurrentPlanStatus;
                    <div class="team-access-snapshot">
                        <p class="team-access-title">Team access snapshot</p>
                        <p class="team-access-line"><strong>Role:</strong> @selectedTeamRole</p>
                        <p class="team-access-line"><strong>Current plan:</strong> @teamPlanName</p>
                        @if (!string.IsNullOrWhiteSpace(teamPlanStatus))
                        {
                            <p class="team-access-line"><strong>Status:</strong> @teamPlanStatus</p>
                        }
                    </div>
                }
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Save account types</button>
                </div>
            </form>
        </section>

        @if (Model.DashboardActivityPreferences is { Options.Count: > 0 } dashboardActivityPreferences)
        {
            <section class="form-section settings-wide">
                <h2>Dashboard activity</h2>
                <p class="section-help">Choose which items appear after login. Subscription access still controls what can be shown.</p>
                <form asp-action="UpdateDashboardActivityPreferences" asp-controller="Account" method="post" class="stacked-form">
                    <div class="account-type-grid">
                        @foreach (var option in dashboardActivityPreferences.Options)
                        {
                            <label class="account-type-option dashboard-preference-option @(option.IsAvailable ? null : "disabled-option")" for="dashboard-activity-@option.Code">
                                <input class="form-check-input"
                                       id="dashboard-activity-@option.Code"
                                       name="activityTypes"
                                       type="checkbox"
                                       value="@option.Code"
                                       checked="@option.IsSelected"
                                       disabled="@(!option.IsAvailable)" />
                                <span>
                                    <strong>@option.Label</strong>
                                    <small>@option.Description</small>
                                    <small>@option.Audience</small>
                                    @if (!option.IsAvailable && !string.IsNullOrWhiteSpace(option.UnavailableReason))
                                    {
                                        <small>@option.UnavailableReason</small>
                                    }
                                </span>
                            </label>
                        }
                    </div>
                    @if (dashboardActivityPreferences.LastViewedAt is not null)
                    {
                        <p class="section-help">New-items window starts: @FormatLocalDate(dashboardActivityPreferences.LastViewedAt.Value)</p>
                    }
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Save dashboard activity</button>
                    </div>
                </form>
            </section>
        }

        <section class="form-section settings-wide">
            <h2>SMS consent</h2>
            <p class="section-help">SMS consent is optional and is not required to use TryOutSpot. It allows transactional messages such as verification codes, security notices, password reset notices, and tryout registration updates.</p>
            <form asp-action="UpdateSmsConsent" asp-controller="Account" method="post" class="stacked-form">
                <div class="form-grid two-column">
                    <div class="form-field">
                        <label asp-for="SmsConsent.PhoneNumber" class="form-label">Phone number</label>
                        <input asp-for="SmsConsent.PhoneNumber" class="form-control" autocomplete="tel" />
                        <span asp-validation-for="SmsConsent.PhoneNumber" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label class="form-label">Current SMS status</label>
                        <div class="readonly-field">@(Model.SmsConsent.SmsConsentAccepted ? "Opted in" : "Not opted in")</div>
                        @if (Model.SmsConsent.SmsConsentAcceptedAt is not null)
                        {
                            <small class="account-meta">Accepted @Model.SmsConsent.SmsConsentAcceptedAt.Value.ToLocalTime().ToString("g")</small>
                        }
                    </div>
                </div>
                <label class="sms-consent-option" for="SmsConsent_SmsConsentAccepted">
                    <input asp-for="SmsConsent.SmsConsentAccepted" class="form-check-input" />
                    <span>@TryOutSpotSmsConsent.CheckboxText</span>
                </label>
                <p class="sms-consent-disclosure">
                    Review the <a href="/privacy-policy">Privacy Policy</a>,
                    <a href="/terms-and-conditions">Terms and Conditions</a>, and
                    <a href="/sms-consent">SMS Consent</a> details.
                </p>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Save SMS consent</button>
                </div>
            </form>
        </section>

        <section class="form-section settings-wide">
            <h2>Membership access</h2>
            <p class="section-help">Paid plans redirect to Stripe checkout when selected. Upgrades are enabled after Stripe confirms payment. Downgrades and cancellations schedule Stripe period-end cancellation so access stays active through the paid term.</p>
            @if (Model.MembershipSummaries.Count > 0)
            {
                var primaryMembership = Model.MembershipSummaries.First();
                <div class="plan-list membership-summary-list">
                    <div class="plan-row">
                        <div>
                            <strong>Current membership: @primaryMembership.PlanName</strong>
                            <span>@primaryMembership.Scope scope</span>
                            <p>Status: @primaryMembership.Status</p>
                            @if (primaryMembership.CurrentPeriodEnd is not null)
                            {
                                var periodEndLabel = primaryMembership.CurrentPeriodEndLabel
                                    ?? (primaryMembership.CancelAtPeriodEnd
                                    ? "Access ends"
                                    : "Next billing date");
                                <p>@periodEndLabel: @FormatLocalDate(primaryMembership.CurrentPeriodEnd.Value)</p>
                            }
                            else
                            {
                                <p>Last updated: @FormatLocalDate(primaryMembership.UpdatedAt)</p>
                            }
                        </div>
                        <div class="plan-price">
                            <strong>@primaryMembership.Price</strong>
                            <span>@primaryMembership.BillingInterval</span>
                            @if (primaryMembership.CancelAtPeriodEnd)
                            {
                                <span>Cancels at period end</span>
                            }
                            else if (primaryMembership.HasActiveEntitlement)
                            {
                                <span>@(primaryMembership.ActiveEntitlementLabel ?? "Active entitlement")</span>
                            }
                        </div>
                    </div>
                </div>
            }
            <div class="form-actions">
                <a class="btn btn-primary" href="/account/onboarding/choose-plan">Choose or change plan</a>
                @if (Model.HasStripeCustomer)
                {
                    <form asp-action="OpenBillingPortal" asp-controller="Account" method="post" class="inline-form">
                        <button type="submit" class="btn btn-outline-primary">Manage billing in Stripe</button>
                    </form>
                }
                @if (Model.CanCancelPaidMembership)
                {
                    <form asp-action="CancelMembership" asp-controller="Account" method="post" class="inline-form">
                        <button type="submit" class="btn btn-outline-danger">Cancel paid membership</button>
                    </form>
                }
            </div>
            @if (!Model.StripeCheckoutConfigured)
            {
                <p class="section-help">Stripe checkout is not configured on this environment yet, so paid upgrades cannot be completed here.</p>
            }
            else if (!Model.HasStripeCustomer)
            {
                <p class="section-help">No Stripe billing profile is linked yet. Pick a paid plan to start checkout.</p>
            }
            else if (Model.HasPendingPaidPlanSelection)
            {
                <p class="section-help">You have a pending paid selection. Finish checkout in Stripe to unlock the upgrade.</p>
            }
            @if (Model.HasScheduledPaidCancellation && Model.ScheduledPaidCancellationAt is not null)
            {
                <p class="section-help">Paid cancellation is already scheduled. Premium access remains until @FormatLocalDate(Model.ScheduledPaidCancellationAt.Value).</p>
            }
            <div class="plan-list">
                @foreach (var plan in Model.RecommendedPlans)
                {
                    var isCurrentPlan = IsCurrentRecommendedPlan(plan, Model);
                    <div class="plan-row @(isCurrentPlan ? "plan-row-active" : null)">
                        <div>
                            <strong>@plan.Name</strong>
                            <span>@plan.Audience</span>
                            <p>@plan.Description</p>
                            @if (isCurrentPlan)
                            {
                                <span class="active-plan-badge">Active plan</span>
                            }
                        </div>
                        <div class="plan-price">
                            @if (TryOutSpotBillingCatalog.RequiresAnnualCommitment(plan.Code) && plan.AnnualAmount is not null)
                            {
                                <strong>@($"{plan.AnnualAmount.Value:C0}/yr")</strong>
                                <span>Annual only</span>
                            }
                            else
                            {
                                <strong>@FormatMonthlyAmount(plan.MonthlyAmount)</strong>
                            }
                            @if (plan.TrialDays is not null)
                            {
                                <span>@plan.TrialDays-day trial</span>
                            }
                            else if (!plan.RequiresStripeSubscription)
                            {
                                <span>No payment required</span>
                            }
                        </div>
                    </div>
                }
            </div>
            @if (Model.FeatureCodes.Count > 0)
            {
                <div class="feature-code-list settings-feature-list">
                    @foreach (var featureCode in Model.FeatureCodes.OrderBy(code => code))
                    {
                        <span>@featureCode</span>
                    }
                </div>
            }
        </section>
    </div>

    <form asp-action="Logout" asp-controller="Account" method="post" class="logout-form">
        <button type="submit" class="btn btn-outline-secondary">Sign out</button>
    </form>
</section>

@functions {
    private static string FormatMonthlyAmount(decimal monthlyAmount)
    {
        return monthlyAmount <= 0 ? "Free" : $"{monthlyAmount:C0}/mo";
    }

    private static string FormatLocalDate(DateTime value)
    {
        return value.ToLocalTime().ToString("MMM d, yyyy h:mm tt");
    }

    private static bool IsCurrentRecommendedPlan(BillingPlanResponse plan, AccountSettingsPageModel model)
    {
        var activePlanName = model.MembershipSummaries.FirstOrDefault()?.PlanName ?? model.CurrentPlanName;
        if (string.IsNullOrWhiteSpace(activePlanName))
        {
            return false;
        }

        return string.Equals(
            NormalizeForPlanComparison(activePlanName),
            NormalizeForPlanComparison(plan.Name),
            StringComparison.OrdinalIgnoreCase);
    }

    private static string NormalizeForPlanComparison(string planName)
    {
        var normalized = planName.Replace("Account scope", string.Empty, StringComparison.OrdinalIgnoreCase);
        return normalized.Trim();
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
