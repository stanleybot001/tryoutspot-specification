@model ChoosePlanPageModel
@using TryOutSpot.Web.Billing

@{
    ViewData["Title"] = "Choose Plan";
    var selectedPlan = Model.AvailablePlans.FirstOrDefault(plan =>
        string.Equals(plan.Code, Model.PlanCode, StringComparison.Ordinal));
}

<section class="account-page compact">
    <div class="account-heading">
        <p class="account-kicker">Onboarding</p>
        <h1>Choose plan</h1>
        <p>Pick the plan that fits your current account type. You can change this later.</p>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="account-alert">@statusMessage</div>
    }

    <section class="form-section">
        <form asp-action="ChoosePlan" asp-controller="Account" method="post" class="stacked-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="plan-list">
                @foreach (var plan in Model.AvailablePlans)
                {
                    var isSelected = string.Equals(plan.Code, Model.PlanCode, StringComparison.Ordinal);
                    <label class="plan-row" for="plan-@plan.Code">
                        <div>
                            <input class="form-check-input" id="plan-@plan.Code" name="PlanCode" type="radio" value="@plan.Code" checked="@isSelected" />
                            <strong>@plan.Name</strong>
                            <span>@plan.Audience</span>
                            <p>@plan.Description</p>
                        </div>
                        <div class="plan-price">
                            @if (TryOutSpotBillingCatalog.RequiresAnnualCommitment(plan.Code) && plan.AnnualAmount is not null)
                            {
                                <strong>@($"{plan.AnnualAmount.Value:C0}/yr")</strong>
                                <span>Annual only</span>
                            }
                            else
                            {
                                <strong>@FormatMonthlyAmount(plan.MonthlyAmount)</strong>
                                @if (plan.AnnualAmount is not null)
                                {
                                    <span>@($"{plan.AnnualAmount.Value:C0}/yr")</span>
                                }
                                else if (!plan.RequiresStripeSubscription)
                                {
                                    <span>No payment required</span>
                                }
                            }

                            @if (plan.TrialDays is not null)
                            {
                                <span>@($"{plan.TrialDays.Value}-day trial")</span>
                            }
                        </div>
                    </label>
                }
            </div>

            <span asp-validation-for="PlanCode" class="text-danger"></span>

            <div class="form-field">
                <label asp-for="BillingInterval" class="form-label">Billing interval</label>
                <div class="form-actions">
                    @if (Model.AvailableBillingIntervals.Contains(BillingIntervalCodes.Month, StringComparer.Ordinal))
                    {
                        <label class="account-check">
                            <input class="form-check-input" type="radio" name="BillingInterval" value="@BillingIntervalCodes.Month" checked="@string.Equals(Model.BillingInterval, BillingIntervalCodes.Month, StringComparison.Ordinal)" />
                            <span>Monthly</span>
                        </label>
                    }
                    @if (Model.AvailableBillingIntervals.Contains(BillingIntervalCodes.Year, StringComparer.Ordinal))
                    {
                        <label class="account-check">
                            <input class="form-check-input" type="radio" name="BillingInterval" value="@BillingIntervalCodes.Year" checked="@string.Equals(Model.BillingInterval, BillingIntervalCodes.Year, StringComparison.Ordinal)" />
                            <span>Annual</span>
                        </label>
                    }
                </div>
                @if (Model.SelectedPlanRequiresAnnualBilling)
                {
                    <p class="section-help">This membership requires annual billing to keep team or organization access active.</p>
                }
                <span asp-validation-for="BillingInterval" class="text-danger"></span>
            </div>

            @if (selectedPlan is not null && !selectedPlan.RequiresStripeSubscription)
            {
                <p class="section-help">This is a free plan. No payment is collected. If you are currently paid, Stripe cancellation is scheduled for period end and paid access continues until that date.</p>
            }
            else if (selectedPlan is not null && Model.CheckoutAvailableForSelection)
            {
                <p class="section-help">After you save, you will be redirected to secure Stripe checkout to complete payment.</p>
            }
            else if (!Model.StripeIsConfigured)
            {
                <p class="section-help">Stripe checkout is not configured yet. Your selection will be saved and checkout can be completed later.</p>
            }
            else if (!Model.CheckoutAvailableForSelection)
            {
                <p class="section-help">Checkout is not available for this plan and billing interval yet. Pick a supported interval or contact support.</p>
            }

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Save and continue</button>
                <a class="btn btn-outline-secondary" href="/account/onboarding">Back to onboarding</a>
            </div>
        </form>
    </section>
</section>

@functions {
    private static string FormatMonthlyAmount(decimal monthlyAmount)
    {
        return monthlyAmount <= 0 ? "Free" : $"{monthlyAmount:C0}/mo";
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
