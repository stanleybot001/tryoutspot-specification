@model ChoosePlanPageModel

@{
    ViewData["Title"] = "Choose Plan";
}

<section class="account-page compact">
    <div class="account-heading">
        <p class="account-kicker">Onboarding</p>
        <h1>Choose plan</h1>
        <p>Pick the plan that fits your current account type. You can change this later.</p>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="account-alert">@statusMessage</div>
    }

    <section class="form-section">
        <form asp-action="ChoosePlan" asp-controller="Account" method="post" class="stacked-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="plan-list">
                @foreach (var plan in Model.AvailablePlans)
                {
                    var isSelected = string.Equals(plan.Code, Model.PlanCode, StringComparison.Ordinal);
                    <label class="plan-row" for="plan-@plan.Code">
                        <div>
                            <input class="form-check-input" id="plan-@plan.Code" name="PlanCode" type="radio" value="@plan.Code" checked="@isSelected" />
                            <strong>@plan.Name</strong>
                            <span>@plan.Audience</span>
                            <p>@plan.Description</p>
                        </div>
                        <div class="plan-price">
                            <strong>@FormatMonthlyAmount(plan.MonthlyAmount)</strong>
                            @if (plan.AnnualAmount is not null)
                            {
                                <span>@($"{plan.AnnualAmount.Value:C0}/yr")</span>
                            }
                            else if (!plan.RequiresStripeSubscription)
                            {
                                <span>No payment required</span>
                            }

                            @if (plan.TrialDays is not null)
                            {
                                <span>@($"{plan.TrialDays.Value}-day trial")</span>
                            }
                        </div>
                    </label>
                }
            </div>

            <span asp-validation-for="PlanCode" class="text-danger"></span>

            <div class="form-field">
                <label asp-for="BillingInterval" class="form-label">Billing interval</label>
                <div class="form-actions">
                    <label class="account-check">
                        <input class="form-check-input" type="radio" name="BillingInterval" value="month" checked="@string.Equals(Model.BillingInterval, "month", StringComparison.Ordinal)" />
                        <span>Monthly</span>
                    </label>
                    <label class="account-check">
                        <input class="form-check-input" type="radio" name="BillingInterval" value="year" checked="@string.Equals(Model.BillingInterval, "year", StringComparison.Ordinal)" />
                        <span>Annual</span>
                    </label>
                </div>
                <span asp-validation-for="BillingInterval" class="text-danger"></span>
            </div>

            @if (!Model.StripeIsConfigured)
            {
                <p class="section-help">Stripe checkout is not configured yet. Your selection will be saved and checkout can be completed later.</p>
            }
            else if (!Model.CheckoutAvailableForSelection)
            {
                <p class="section-help">Checkout availability depends on the selected plan and billing interval.</p>
            }

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Save and continue</button>
                <a class="btn btn-outline-secondary" href="/account/onboarding">Back to onboarding</a>
            </div>
        </form>
    </section>
</section>

@functions {
    private static string FormatMonthlyAmount(decimal monthlyAmount)
    {
        return monthlyAmount <= 0 ? "Free" : $"{monthlyAmount:C0}/mo";
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
