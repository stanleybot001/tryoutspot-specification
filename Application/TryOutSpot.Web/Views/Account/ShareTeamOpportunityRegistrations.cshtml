@model TeamOpportunityRegistrationSharePageModel

@{
    ViewData["Title"] = "Registration roster";
    var rosterUrl = BuildAbsoluteRosterUrl();
    var shareSubject = $"TryOutSpot roster: {Model.Title}";
    var shareBody = BuildShareBody(rosterUrl);
    var emailHref = $"mailto:?subject={Uri.EscapeDataString(shareSubject)}&body={Uri.EscapeDataString(shareBody)}";
    var smsHref = $"sms:?body={Uri.EscapeDataString(shareBody)}";
}

<section class="account-page registration-share-page">
    <div class="account-heading registration-share-heading">
        <p class="account-kicker">Registration roster</p>
        <h1>@Model.Title</h1>
        <p>@Model.TeamName@if (!string.IsNullOrWhiteSpace(Model.OrganizationName))
            {
                @: - @Model.OrganizationName
            }</p>
        <div class="form-actions registration-share-actions">
            <a class="btn btn-primary btn-sm" href="@emailHref">Email link</a>
            <a class="btn btn-outline-primary btn-sm" href="@smsHref">Text link</a>
            <a class="btn btn-outline-secondary btn-sm" href="/account/onboarding/team-opportunities/@Model.TeamId">Back to listing</a>
        </div>
    </div>

    <section class="form-section registration-share-summary p-3">
        <div class="d-flex flex-wrap gap-2 small text-muted">
            <span><strong class="text-body">Sport:</strong> @Model.SportName</span>
            <span><strong class="text-body">Type:</strong> @FormatOpportunityType(Model.Type)</span>
            <span><strong class="text-body">Players:</strong> @Model.RegistrantCount</span>
            <span><strong class="text-body">Generated:</strong> @FormatDateTime(Model.GeneratedAt)</span>
            <span><strong class="text-body">Age:</strong> @FormatValue(Model.AgeGroup)</span>
            <span><strong class="text-body">Competition:</strong> @FormatValue(Model.CompetitionLevel)</span>
            <span><strong class="text-body">Start:</strong> @FormatDate(Model.EventDate)</span>
            <span><strong class="text-body">End:</strong> @FormatDate(Model.EventEndDate)</span>
            <span><strong class="text-body">Location:</strong> @FormatValue(Model.Location)</span>
            <span><strong class="text-body">Address:</strong> @FormatValue(Model.Address)</span>
            <span><strong class="text-body">City/State/ZIP:</strong> @FormatLocation(Model.City, Model.State, Model.ZipCode)</span>
        </div>
    </section>

    <section class="form-section registration-share-roster p-3">
        <h2>Players</h2>
        @if (Model.Registrants.Count == 0)
        {
            <p class="section-help">No players have registered for this event yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle registration-share-table mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Player</th>
                            <th scope="col">Status</th>
                            <th scope="col">Player contact</th>
                            <th scope="col">Guardian</th>
                            <th scope="col">Emergency</th>
                            <th scope="col">Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var registrant in Model.Registrants)
                        {
                            <tr class="@(registrant.IsFavoritedByViewer ? "table-warning" : string.Empty)">
                                <td>
                                    <strong>
                                        @registrant.PlayerName
                                        @if (registrant.IsFavoritedByViewer)
                                        {
                                            <span class="favorite-player-marker"
                                                  title="Favorited player listing"
                                                  aria-label="Favorited player listing">&#9733;</span>
                                        }
                                    </strong>
                                    <span class="d-block small text-muted">@FormatValue(registrant.SchoolName)</span>
                                </td>
                                <td>
                                    <span>@registrant.StatusLabel</span>
                                    <span class="d-block small text-muted">Registered @FormatDateTime(registrant.RegisteredAt)</span>
                                    <span class="d-block small text-muted">@(registrant.IsPresent ? "Present" : "Not checked in")</span>
                                    <span class="d-block small text-muted">@(registrant.IsWaiverReceived ? "Waiver received" : "Waiver missing")</span>
                                </td>
                                <td>@FormatContact(registrant.PlayerPhone, registrant.PlayerEmail)</td>
                                <td>
                                    <span>@FormatValue(registrant.GuardianName)</span>
                                    <span class="d-block small text-muted">@FormatContact(registrant.GuardianPhone, registrant.GuardianEmail)</span>
                                </td>
                                <td>
                                    <span>@FormatValue(registrant.EmergencyContactName)</span>
                                    <span class="d-block small text-muted">@FormatValue(registrant.EmergencyContactPhone)</span>
                                </td>
                                <td>
                                    @if (registrant.CheckedInAt.HasValue)
                                    {
                                        <span class="d-block">Checked in @FormatDateTime(registrant.CheckedInAt.Value)</span>
                                    }
                                    @if (registrant.WaiverReceivedAt.HasValue)
                                    {
                                        <span class="d-block">Waiver logged @FormatDateTime(registrant.WaiverReceivedAt.Value)</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(registrant.MedicalInfo))
                                    {
                                        <span class="d-block">Medical: @registrant.MedicalInfo</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(registrant.AdditionalNotes))
                                    {
                                        <span class="d-block">Notes: @registrant.AdditionalNotes</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</section>

@functions {
    private string BuildAbsoluteRosterUrl()
    {
        return $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
    }

    private string BuildShareBody(string rosterUrl)
    {
        return string.Join(
            Environment.NewLine,
            [
                $"Registration roster for {Model.Title}",
                $"{Model.TeamName} - {FormatDate(Model.EventDate)}",
                rosterUrl
            ]);
    }

    private static string FormatOpportunityType(string type)
    {
        if (string.IsNullOrWhiteSpace(type))
        {
            return "Opportunity";
        }

        return type
            .Replace("_", " ", StringComparison.Ordinal)
            .Trim()
            .ToLowerInvariant() switch
        {
            "tryout" => "Tryout",
            "roster opening" => "Roster opening",
            "pickup player" => "Pickup player",
            "camp" => "Camp",
            "clinic" => "Clinic",
            "tournament" => "Tournament",
            "private workout" => "Private workout",
            var fallback => char.ToUpperInvariant(fallback[0]) + fallback[1..]
        };
    }

    private static string FormatLocation(string? city, string? state, string? zipCode)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(city))
        {
            parts.Add(city.Trim());
        }

        if (!string.IsNullOrWhiteSpace(state))
        {
            parts.Add(state.Trim().ToUpperInvariant());
        }

        if (!string.IsNullOrWhiteSpace(zipCode))
        {
            parts.Add(zipCode.Trim());
        }

        return parts.Count == 0 ? "Not set" : string.Join(", ", parts);
    }

    private static string FormatDate(DateTime? date)
    {
        return date?.ToLocalTime().ToString("MMM d, yyyy") ?? "Not set";
    }

    private static string FormatDateTime(DateTime date)
    {
        return date.ToLocalTime().ToString("MMM d, yyyy h:mm tt");
    }

    private static string FormatValue(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Not set" : value.Trim();
    }

    private static string FormatContact(string? phone, string? email)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(phone))
        {
            parts.Add(phone.Trim());
        }

        if (!string.IsNullOrWhiteSpace(email))
        {
            parts.Add(email.Trim());
        }

        return parts.Count == 0 ? "Not set" : string.Join(" / ", parts);
    }
}
