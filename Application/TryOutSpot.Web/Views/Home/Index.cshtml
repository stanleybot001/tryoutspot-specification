@{
    ViewData["Title"] = "Baseball and Softball Tryouts, Teams, and Player Profiles";
    ViewData["SeoTitle"] = "TryOutSpot | Baseball and Softball Tryouts, Teams, and Player Profiles";
    ViewData["MetaDescription"] = "Find baseball and softball tryouts, roster openings, team opportunities, and player profiles with TryOutSpot. Connect players, parents, coaches, and organizations in one trusted platform.";
    ViewData["CanonicalPath"] = "/";
    ViewData["Robots"] = "index,follow";
    ViewData["OpenGraphType"] = "website";

    var homePageUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/";
    var logoUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Url.Content("~/logo/MainLogoSized.png")}";
    var websiteJsonLd = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "WebSite",
        ["name"] = "TryOutSpot",
        ["alternateName"] = "TryoutSpot",
        ["url"] = homePageUrl,
        ["description"] = ViewData["MetaDescription"]
    });
    var organizationJsonLd = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Organization",
        ["name"] = "TryOutSpot",
        ["url"] = homePageUrl,
        ["logo"] = logoUrl,
        ["description"] = ViewData["MetaDescription"]
    });
}

@section Head {
    <script type="application/ld+json">
        @Html.Raw(websiteJsonLd)
    </script>
    <script type="application/ld+json">
        @Html.Raw(organizationJsonLd)
    </script>
}

<div class="startpage-wrap">
    <a class="splash-logo" asp-controller="Home" asp-action="Index" aria-label="TryOutSpot home">
        <img src="~/logo/TryOutSpotLogo.png" asp-append-version="true" alt="TryOutSpot" />
    </a>
    <section class="start-hero-shell">
        <div class="start-hero-card">
            <header class="start-hero-topbar">
                <nav aria-label="Hero navigation">
                    <a asp-controller="Account" asp-action="Login">Find Tryouts</a>
                    <a asp-controller="Account" asp-action="Register">Create Profile</a>
                    <a asp-controller="Account" asp-action="Register">Teams</a>
                    <a href="/plans-and-features">Plans</a>
                </nav>
            </header>

            <div class="start-hero-main">
                <div class="start-hero-copy">
                    <p class="start-kicker">Competitive Baseball and Softball</p>
                    <h1>Baseball and Softball Tryouts, Teams, and Player Profiles</h1>
                    <p>
                        Find tryouts, roster openings, and team opportunities built for families,
                        coaches, academies, and organizations ready to connect.
                    </p>
                    <section class="start-selling-points" aria-label="Platform selling points">
                        <h2>Find Tryouts and Roster Openings Near You</h2>
                        <ul>
                            <li>List your tryout and reach serious local players.</li>
                            <li>Search for team spots by age group, level, and location.</li>
                            <li>Accept tryout registrations with clear deadlines and open spots.</li>
                            <li>Find local players ready to compete this season.</li>
                        </ul>
                    </section>
                    <div class="start-actions">
                        <a class="btn start-btn-primary" asp-controller="Account" asp-action="Login">Find Tryouts</a>
                        <a class="btn start-btn-secondary" asp-controller="Account" asp-action="Register">Create Profile</a>
                    </div>
                </div>
                <aside class="start-feature-panel" aria-label="Featured listing">
                    <p class="start-feature-kicker">Featured This Week</p>
                    <h2>Dallas Elite 13U Major</h2>
                    <p>Saturday, June 22 · 10:00 AM</p>
                    <p>Las Colinas Sports Complex</p>
                    <p class="start-feature-alert">Registration closes in 2 days</p>
                </aside>
            </div>

            <div class="start-hero-rail">
                <article>
                    <p class="rail-label">Top Programs</p>
                    <h3>Verified Team Profiles</h3>
                </article>
                <article>
                    <p class="rail-label">Faster Decisions</p>
                    <h3>Clear Deadlines and Open Spots</h3>
                </article>
                <article class="rail-accent">
                    <p class="rail-label">Season Active</p>
                    <h3>1,200+ Opportunities Posted</h3>
                </article>
            </div>
        </div>
    </section>
</div>
