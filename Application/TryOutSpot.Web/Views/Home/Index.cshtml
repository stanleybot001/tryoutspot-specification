@{
    ViewData["Title"] = "Baseball and Softball Tryouts, Teams, and Player Profiles";
    ViewData["SeoTitle"] = "TryOutSpot | Baseball and Softball Tryouts, Teams, and Player Profiles";
    ViewData["MetaDescription"] = "Find baseball and softball tryouts, roster openings, team opportunities, and player profiles with TryOutSpot. Connect players, parents, coaches, and organizations in one trusted platform.";
    ViewData["CanonicalPath"] = "/";
    ViewData["Robots"] = "index,follow";
    ViewData["OpenGraphType"] = "website";

    var demoListingUrl = "https://tryoutspot.com/opportunities/967602f9-4866-4c75-bc6f-ff86c3f448a5";
    var isSignedIn = User.Identity?.IsAuthenticated ?? false;
    var homePageUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/";
    var logoUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Url.Content("~/logo/MainLogoSized.png")}";
    var websiteJsonLd = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "WebSite",
        ["name"] = "TryOutSpot",
        ["alternateName"] = "TryoutSpot",
        ["url"] = homePageUrl,
        ["description"] = ViewData["MetaDescription"]
    });
    var organizationJsonLd = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Organization",
        ["name"] = "TryOutSpot",
        ["url"] = homePageUrl,
        ["logo"] = logoUrl,
        ["description"] = ViewData["MetaDescription"]
    });
}

@section Head {
    <script type="application/ld+json">
        @Html.Raw(websiteJsonLd)
    </script>
    <script type="application/ld+json">
        @Html.Raw(organizationJsonLd)
    </script>
}

<div class="startpage-wrap">
    <a class="splash-logo" asp-controller="Home" asp-action="Index" aria-label="TryOutSpot home">
        <img src="~/logo/TryOutSpotLogo.png" asp-append-version="true" alt="TryOutSpot" />
    </a>
    <section class="start-hero-shell">
        <div class="start-hero-card">
            <header class="start-hero-topbar">
                <nav aria-label="Hero navigation">
                    <a href="/tryouts">Find tryouts</a>
                    @if (isSignedIn)
                    {
                        <a href="/account/onboarding">Dashboard</a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Register">Create free account</a>
                        <a asp-controller="Account" asp-action="Login">Sign in</a>
                    }
                    <a asp-controller="Home" asp-action="PlansAndFeatures">Plans &amp; pricing</a>
                </nav>
            </header>

            <div class="start-hero-main">
                <div class="start-hero-copy">
                    <p class="start-kicker">Competitive Baseball and Softball</p>
                    <h1>Baseball and Softball Tryouts, Teams, and Player Profiles</h1>
                    <p>
                        Find tryouts, roster openings, and team opportunities built for families,
                        coaches, academies, and organizations ready to connect.
                    </p>
                    <section class="start-selling-points" aria-label="Platform selling points">
                        <h2>Find Tryouts and Roster Openings Near You</h2>
                        <ul>
                            <li>List your tryout and reach serious local players.</li>
                            <li>Search for team spots by age group, level, and location.</li>
                            <li>Accept tryout registrations with clear deadlines and open spots.</li>
                            <li>Find local players ready to compete this season.</li>
                        </ul>
                    </section>
                    <form class="start-search-form" action="/tryouts" method="get" role="search" aria-label="Find tryouts">
                        <label class="visually-hidden" for="start-search-zip">ZIP code</label>
                        <input id="start-search-zip" name="OriginZipCode" class="form-control" inputmode="numeric" maxlength="10" placeholder="Your ZIP code" autocomplete="postal-code" />
                        <button class="btn start-btn-primary" type="submit">Find tryouts near me</button>
                    </form>
                    <div class="start-actions">
                        @if (isSignedIn)
                        {
                            <a class="btn start-btn-secondary" href="/account/onboarding">Go to your dashboard</a>
                        }
                        else
                        {
                            <a class="btn start-btn-secondary" asp-controller="Account" asp-action="Register">Create free account</a>
                            <a class="btn start-btn-tertiary" asp-controller="Account" asp-action="Login">Sign in</a>
                        }
                    </div>
                </div>
                <aside class="start-feature-panel start-next-panel" aria-labelledby="start-next-title">
                    <p class="start-feature-kicker">Start Here</p>
                    <h2 id="start-next-title">What do you want to do next?</h2>
                    <div class="start-next-actions">
                        <a class="start-next-link start-next-primary" href="/tryouts">
                            <span>Parents and players</span>
                            <strong>Find tryouts</strong>
                            <small>Search tryouts, camps, and roster openings near you. No account needed to look.</small>
                        </a>
                        @if (isSignedIn)
                        {
                            <a class="start-next-link" href="/account/onboarding">
                                <span>Welcome back</span>
                                <strong>Go to your dashboard</strong>
                                <small>Pick up where you left off.</small>
                            </a>
                        }
                        else
                        {
                            <a class="start-next-link" href="/account/register?accountType=TeamRepresentative">
                                <span>Coaches and teams</span>
                                <strong>Post a tryout free</strong>
                                <small>Free Coach includes one published listing every six months.</small>
                            </a>
                            <a class="start-next-link" asp-controller="Account" asp-action="Login">
                                <span>Already have an account?</span>
                                <strong>Sign in</strong>
                                <small>Go to your dashboard and keep moving.</small>
                            </a>
                        }
                        <a class="start-next-link" asp-controller="Home" asp-action="PlansAndFeatures">
                            <span>Still deciding?</span>
                            <strong>Compare plans</strong>
                            <small>Compare features for players and teams.</small>
                        </a>
                        <a class="start-next-link" href="@demoListingUrl">
                            <span>Want a preview?</span>
                            <strong>View demo listing</strong>
                            <small>See how a public team listing appears.</small>
                        </a>
                    </div>
                </aside>
            </div>

            <div class="start-hero-rail">
                <article>
                    <p class="rail-label">Top Programs</p>
                    <h3>Verified Team Profiles</h3>
                </article>
                <article>
                    <p class="rail-label">Faster Decisions</p>
                    <h3>Clear Deadlines and Open Spots</h3>
                </article>
                <article class="rail-accent">
                    <p class="rail-label">New Site Launch</p>
                    <h3>Teams Can Start Posting</h3>
                </article>
            </div>
        </div>
    </section>
</div>
