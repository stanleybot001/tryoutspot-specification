@model TryOutSpot.Web.Models.Billing.PlansFeatureMatrixPageModel
@using TryOutSpot.Web.Billing

@{
    ViewData["Title"] = "Plans & Pricing";
    var isSignedIn = User.Identity?.IsAuthenticated ?? false;
}

<section class="account-page">
    <div class="account-heading">
        <p class="account-kicker">Plans &amp; pricing</p>
        <h1>Free to begin. Upgrade when you need more.</h1>
        <p>Families can find and register for tryouts free. Coaches can post a tryout free, then upgrade for online registration, check-in, and more listings.</p>
    </div>

    <section class="form-section">
        <h2>Plans</h2>
        @foreach (var track in Model.PlanTracks)
        {
            <h3 class="plans-track-title">@track.TrackName</h3>
            <div class="plan-list">
                @foreach (var plan in track.Plans)
                {
                    var isTeamPlan = IsTeamPlanCode(plan.Code);
                    var bundle = isTeamPlan ? "team" : "player_parent";
                    var accountType = isTeamPlan ? "TeamRepresentative" : "Parent";
                    var isFreePlan = plan.Code is TryOutSpotPlanCodes.FreeCoach or TryOutSpotPlanCodes.FreePlayerParent;
                    var choosePlanUrl = $"/account/onboarding/choose-plan?bundle={bundle}";
                    var actionUrl = isSignedIn
                        ? (isFreePlan ? "/account/onboarding" : choosePlanUrl)
                        : isFreePlan
                            ? $"/account/register?accountType={accountType}"
                            : $"/account/register?accountType={accountType}&returnUrl={Uri.EscapeDataString(choosePlanUrl)}";
                    var actionLabel = isFreePlan
                        ? (isSignedIn ? "Go to dashboard" : "Create free account")
                        : $"Choose {plan.Name}";
                    <article class="plan-row plan-row-stack">
                        <div>
                            <strong>@plan.Name</strong>
                            <span>@plan.Audience</span>
                            <p>@plan.Description</p>
                        </div>
                        <div class="plan-price">
                            <strong>@plan.PriceLabel</strong>
                            @if (TryOutSpotBillingCatalog.RequiresAnnualCommitment(plan.Code))
                            {
                                <span>Annual only</span>
                            }
                            else if (plan.TrialDays is not null)
                            {
                                <span>@plan.TrialDays-day trial</span>
                            }
                            <a class="btn btn-sm @(isFreePlan ? "btn-outline-primary" : "btn-primary") mt-1" href="@actionUrl">@actionLabel</a>
                        </div>
                        @if (plan.AddedFeaturesComparedToPrevious.Count > 0)
                        {
                            <div>
                                <h4>Adds over the plan above</h4>
                                <ul class="plan-feature-list">
                                    @foreach (var feature in plan.AddedFeaturesComparedToPrevious)
                                    {
                                        <li><strong>@feature.Name</strong>: @feature.Description</li>
                                    }
                                </ul>
                            </div>
                        }
                    </article>
                }
            </div>
        }
    </section>

    <details class="form-section plans-detail">
        <summary><h2 class="d-inline">Compare in detail</h2></summary>

    <section class="form-section">
        <h2>Who can use each plan</h2>
        <div class="plan-access-mobile" aria-label="Account type plan eligibility">
            @foreach (var row in Model.AccountTypePlanAccess)
            {
                <article class="plan-access-card@(row.FreeCoach ? " plan-access-card-team" : string.Empty)">
                    <div class="plan-access-card-head">
                        <div>
                            <span>Account type</span>
                            <strong>@row.AccountType</strong>
                        </div>
                        @if (row.FreeCoach)
                        {
                            <span class="plan-access-free-badge">Free Team/Coach</span>
                        }
                    </div>
                    @if (row.FreeCoach)
                    {
                        <p class="plan-access-card-copy">Team representatives can use the Free Coach tier, then upgrade when they need more tools.</p>
                    }
                    <div class="plan-access-pill-list" aria-label="Eligible plans">
                        @if (row.FreePlayerParent)
                        {
                            <span class="plan-access-pill">Free Player/Parent</span>
                        }
                        @if (row.PremiumPlayer)
                        {
                            <span class="plan-access-pill">Premium Player</span>
                        }
                        @if (row.FreeCoach)
                        {
                            <span class="plan-access-pill plan-access-pill-free">Free Coach</span>
                        }
                        @if (row.TeamBasic)
                        {
                            <span class="plan-access-pill">Basic Team</span>
                        }
                        @if (row.TeamProfessional)
                        {
                            <span class="plan-access-pill">Professional Team</span>
                        }
                        @if (row.EnterpriseOrganization)
                        {
                            <span class="plan-access-pill">Enterprise Organization</span>
                        }
                    </div>
                </article>
            }
        </div>
        <div class="table-responsive plans-matrix-scroll">
            <table class="table table-sm align-middle plans-matrix-table">
                <thead>
                    <tr>
                        <th scope="col">Account type</th>
                        <th scope="col">Free Player/Parent</th>
                        <th scope="col">Premium Player</th>
                        <th scope="col">Free Coach</th>
                        <th scope="col">Basic Team</th>
                        <th scope="col">Professional Team</th>
                        <th scope="col">Enterprise Organization</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.AccountTypePlanAccess)
                    {
                        <tr>
                            <th scope="row">@row.AccountType</th>
                            <td>@(row.FreePlayerParent ? "Yes" : "No")</td>
                            <td>@(row.PremiumPlayer ? "Yes" : "No")</td>
                            <td>@(row.FreeCoach ? "Yes" : "No")</td>
                            <td>@(row.TeamBasic ? "Yes" : "No")</td>
                            <td>@(row.TeamProfessional ? "Yes" : "No")</td>
                            <td>@(row.EnterpriseOrganization ? "Yes" : "No")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.CriticalPolicyNotes.Count > 0)
        {
            <div class="section-help">
                <strong>Important policy notes</strong>
                <ul class="plan-feature-list">
                    @foreach (var note in Model.CriticalPolicyNotes)
                    {
                        <li>@note</li>
                    }
                </ul>
            </div>
        }
    </section>

    <section class="form-section">
        <h2>Feature bundles</h2>
        <div class="plan-list">
            @foreach (var bundle in Model.FeatureBundles)
            {
                <article class="plan-row plan-row-stack">
                    <div>
                        <strong>@bundle.Name</strong>
                        <span>@bundle.Scope</span>
                        <p>@bundle.ComparedTo</p>
                        <ul class="plan-feature-list">
                            @foreach (var feature in bundle.Features)
                            {
                                <li>
                                    <strong>@feature.Name</strong>: @feature.Description
                                </li>
                            }
                        </ul>
                    </div>
                </article>
            }
        </div>
    </section>

    <section class="form-section">
        <h2>Everything included in each plan</h2>
        @foreach (var track in Model.PlanTracks)
        {
            <h3 class="plans-track-title">@track.TrackName</h3>
            <div class="plan-list">
                @foreach (var plan in track.Plans)
                {
                    <article class="plan-row plan-row-stack">
                        <div>
                            <strong>@plan.Name</strong>
                            <ul class="plan-feature-list">
                                @foreach (var feature in plan.IncludedFeatures)
                                {
                                    <li><strong>@feature.Name</strong>: @feature.Description</li>
                                }
                            </ul>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
    </details>
</section>

@functions {
    private static bool IsTeamPlanCode(string planCode)
    {
        return planCode is TryOutSpotPlanCodes.FreeCoach
            or TryOutSpotPlanCodes.TeamBasic
            or TryOutSpotPlanCodes.TeamProfessional
            or TryOutSpotPlanCodes.EnterpriseOrganization;
    }
}
