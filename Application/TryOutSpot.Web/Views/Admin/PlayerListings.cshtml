@model AdminListingListPageModel<AdminPlayerListingListItem>

@{
    ViewData["Title"] = "Admin Player Listings";
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<section class="account-page admin-page">
    <div class="account-heading">
        <p class="account-kicker">Listings</p>
        <h1>Player listings</h1>
        <p>View all parent/player marketplace listings, including unpublished and inactive records.</p>
    </div>

    @await Html.PartialAsync("_AdminNav")

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="account-alert">@statusMessage</div>
    }

    <section class="form-section">
        <form method="get" class="admin-filter-form">
            <div class="form-field">
                <label class="form-label" for="listing-search">Search</label>
                <input id="listing-search" class="form-control" name="q" value="@Model.Search" />
            </div>
            <div class="form-field">
                <label class="form-label" for="published-state">Published</label>
                <select id="published-state" class="form-select" name="isPublished">
                    <option value="">All</option>
                    <option value="true" selected="@(Model.IsPublished == true)">Published</option>
                    <option value="false" selected="@(Model.IsPublished == false)">Unpublished</option>
                </select>
            </div>
            <div class="form-field">
                <label class="form-label" for="active-state">Active</label>
                <select id="active-state" class="form-select" name="isActive">
                    <option value="">All</option>
                    <option value="true" selected="@(Model.IsActive == true)">Active</option>
                    <option value="false" selected="@(Model.IsActive == false)">Inactive</option>
                </select>
            </div>
            <div class="form-field">
                <label class="form-label" for="listing-page-size">Rows</label>
                <select id="listing-page-size" class="form-select" name="pageSize">
                    @foreach (var size in PageSizeOptions())
                    {
                        <option value="@size" selected="@(Model.PageSize == size)">@size</option>
                    }
                </select>
            </div>
            <div class="form-actions admin-filter-actions">
                <button type="submit" class="btn btn-primary">Filter</button>
                <a class="btn btn-outline-secondary" href="/admin/player-listings">Reset</a>
            </div>
        </form>
    </section>

    <section class="form-section">
        <div class="opportunity-row-head">
            <h2>Listings</h2>
            <span class="section-help">@Model.TotalCount total</span>
        </div>

        @if (Model.Listings.Count == 0)
        {
            <p class="section-help">No player listings match these filters.</p>
        }
        else
        {
            <div class="plan-list">
                @foreach (var listing in Model.Listings)
                {
                    <article class="plan-row plan-row-stack admin-list-row">
                        <div class="opportunity-row-head">
                            <div>
                                <strong>@listing.Title</strong>
                                <span>@listing.ListingType - @(listing.SportName ?? "No sport")</span>
                            </div>
                            <div class="team-metric-inline">
                                <span>@(listing.IsPublished ? "Published" : "Unpublished")</span>
                                <span>@GetListingStatus(listing)</span>
                                <span>@listing.OpenReportCount open reports</span>
                            </div>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-2 small text-muted">
                            <span><strong class="text-body">Owner:</strong> @listing.OwnerName (@listing.OwnerEmail)</span>
                            <span><strong class="text-body">Player:</strong> @(listing.PlayerName ?? "Not linked")</span>
                            <span><strong class="text-body">Location:</strong> @FormatLocation(listing.City, listing.State, listing.ZipCode)</span>
                            <span><strong class="text-body">Updated:</strong> @listing.UpdatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(listing.Description))
                        {
                            <p class="section-help small mb-1">@listing.Description</p>
                        }
                        <div class="form-actions admin-row-actions mt-2">
                            <a class="btn btn-outline-primary btn-sm" href="/admin/users/@listing.OwnerUserId">Owner profile</a>
                            @if (listing.IsPublished && listing.IsSearchable)
                            {
                                <a class="btn btn-outline-secondary btn-sm" href="/player-listings/@listing.ListingId" target="_blank" rel="noopener">Public page</a>
                            }
                            @if (listing.IsActive)
                            {
                                <form asp-action="DeactivatePlayerListing" asp-controller="Admin" asp-route-listingId="@listing.ListingId" method="post" class="inline-form">
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="btn btn-outline-warning btn-sm">Deactivate</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="ReactivatePlayerListing" asp-controller="Admin" asp-route-listingId="@listing.ListingId" method="post" class="inline-form">
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="btn btn-outline-success btn-sm">Reactivate</button>
                                </form>
                            }
                            <form asp-action="DeletePlayerListing" asp-controller="Admin" asp-route-listingId="@listing.ListingId" method="post" class="inline-form">
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                            </form>
                        </div>
                    </article>
                }
            </div>
        }

        @if (Model.TotalPages > 1)
        {
            <div class="form-actions mt-3">
                @if (Model.Page > 1)
                {
                    <a class="btn btn-outline-secondary" href="@BuildPageUrl(Model.Page - 1)">Previous</a>
                }
                <span class="section-help">Page @Model.Page of @Model.TotalPages</span>
                @if (Model.Page < Model.TotalPages)
                {
                    <a class="btn btn-outline-secondary" href="@BuildPageUrl(Model.Page + 1)">Next</a>
                }
            </div>
        }
    </section>
</section>

@functions {
    private static int[] PageSizeOptions()
    {
        return [10, 25, 50, 100];
    }

    private static string GetListingStatus(AdminPlayerListingListItem listing)
    {
        if (listing.IsActive)
        {
            return "Active";
        }

        return listing.IsSearchable ? "Inactive" : "Deleted";
    }

    private string BuildPageUrl(int page)
    {
        var values = new List<string> { $"page={page}", $"pageSize={Model.PageSize}" };
        if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            values.Add($"q={Uri.EscapeDataString(Model.Search)}");
        }

        if (Model.IsPublished.HasValue)
        {
            values.Add($"isPublished={Model.IsPublished.Value.ToString().ToLowerInvariant()}");
        }

        if (Model.IsActive.HasValue)
        {
            values.Add($"isActive={Model.IsActive.Value.ToString().ToLowerInvariant()}");
        }

        return "/admin/player-listings?" + string.Join("&", values);
    }

    private static string FormatLocation(string? city, string? state, string? zipCode)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(city))
        {
            parts.Add(city.Trim());
        }

        if (!string.IsNullOrWhiteSpace(state))
        {
            parts.Add(state.Trim().ToUpperInvariant());
        }

        if (!string.IsNullOrWhiteSpace(zipCode))
        {
            parts.Add(zipCode.Trim());
        }

        return parts.Count == 0 ? "Not set" : string.Join(", ", parts);
    }
}
