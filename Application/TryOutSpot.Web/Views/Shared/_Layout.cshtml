<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TryOutSpot</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TryOutSpot.Web.styles.css" asp-append-version="true" />
</head>
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var isSplashPage = string.Equals(controller, "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(action, "Index", StringComparison.OrdinalIgnoreCase);
}
<body class="@(isSplashPage ? "splash-page" : string.Empty)">
    @if (!isSplashPage)
    {
        <header>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                <div class="container-fluid">
                    <a class="navbar-brand brand-lockup" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="~/logo/TryOutSpotLogo.png" asp-append-version="true" alt="TryOutSpot logo" class="brand-logo" />
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/privacy-policy">Privacy</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/terms-and-conditions">Terms</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/account-deletion">Account Deletion</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/plans-and-features">Plans &amp; Features</a>
                            </li>
                            @if (User.Identity?.IsAuthenticated ?? false)
                            {
                                var showTeamItemSearch = User.IsInRole(TryOutSpotRoles.Parent)
                                    || User.IsInRole(TryOutSpotRoles.Player);
                                var showPlayerSearch = User.IsInRole(TryOutSpotRoles.TeamRepresentative)
                                    || User.IsInRole(TryOutSpotRoles.Coach)
                                    || User.IsInRole(TryOutSpotRoles.TeamManager)
                                    || User.IsInRole(TryOutSpotRoles.AcademyDirector)
                                    || User.IsInRole(TryOutSpotRoles.OrganizationAdmin);
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Onboarding">Dashboard</a>
                                </li>
                                @if (showTeamItemSearch)
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="SearchTeamItems">Search Team Items</a>
                                    </li>
                                }
                                @if (showPlayerSearch)
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="SearchPlayers">Search Players</a>
                                    </li>
                                }
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Settings">Account Settings</a>
                                </li>
                                <li class="nav-item">
                                    <form asp-action="Logout" asp-controller="Account" method="post" class="nav-signout-form">
                                        <button type="submit" class="nav-link text-dark btn btn-link">Sign out</button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Register">Create Account</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
    }
    <div class="@(isSplashPage ? "container-fluid px-0" : "container")">
        <main role="main" class="@(isSplashPage ? string.Empty : "pb-3")">
            @RenderBody()
        </main>
    </div>
    @if (!isSplashPage)
    {
        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2026 - TryOutSpot - <a href="/privacy-policy">Privacy Policy</a> - <a href="/terms-and-conditions">Terms and Conditions</a> - <a href="/account-deletion">Account Deletion</a> - <a href="/sms-consent">SMS Consent</a>
            </div>
        </footer>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
