<!DOCTYPE html>
@{
    var rawTitle = (ViewData["SeoTitle"] as string) ?? (ViewData["Title"] as string) ?? "TryOutSpot";
    var pageTitle = rawTitle.Contains("TryOutSpot", StringComparison.OrdinalIgnoreCase)
        ? rawTitle
        : $"{rawTitle} - TryOutSpot";
    var metaDescription = ViewData["MetaDescription"] as string;
    var robots = ViewData["Robots"] as string;
    var requestBaseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}";
    var canonicalUrl = ViewData["CanonicalUrl"] as string;
    var canonicalPath = ViewData["CanonicalPath"] as string;

    if (string.IsNullOrWhiteSpace(canonicalUrl) && !string.IsNullOrWhiteSpace(canonicalPath))
    {
        if (Uri.IsWellFormedUriString(canonicalPath, UriKind.Absolute))
        {
            canonicalUrl = canonicalPath;
        }
        else
        {
            var resolvedCanonicalPath = Url.Content(canonicalPath);
            canonicalUrl = resolvedCanonicalPath.StartsWith("/", StringComparison.Ordinal)
                ? $"{requestBaseUrl}{resolvedCanonicalPath}"
                : $"{requestBaseUrl}/{resolvedCanonicalPath}";
        }
    }
    else if (!string.IsNullOrWhiteSpace(canonicalUrl) && !Uri.IsWellFormedUriString(canonicalUrl, UriKind.Absolute))
    {
        var resolvedCanonicalUrl = Url.Content(canonicalUrl);
        canonicalUrl = resolvedCanonicalUrl.StartsWith("/", StringComparison.Ordinal)
            ? $"{requestBaseUrl}{resolvedCanonicalUrl}"
            : $"{requestBaseUrl}/{resolvedCanonicalUrl}";
    }

    var openGraphTitle = (ViewData["OpenGraphTitle"] as string) ?? pageTitle;
    var openGraphDescription = (ViewData["OpenGraphDescription"] as string) ?? metaDescription;
    var openGraphType = (ViewData["OpenGraphType"] as string) ?? "website";
    var openGraphImageValue = (ViewData["OpenGraphImage"] as string) ?? "~/logo/MainLogoSized.png";
    var openGraphImage = openGraphImageValue;
    if (!Uri.IsWellFormedUriString(openGraphImageValue, UriKind.Absolute))
    {
        var resolvedOpenGraphImage = Url.Content(openGraphImageValue);
        openGraphImage = resolvedOpenGraphImage.StartsWith("/", StringComparison.Ordinal)
            ? $"{requestBaseUrl}{resolvedOpenGraphImage}"
            : $"{requestBaseUrl}/{resolvedOpenGraphImage}";
    }
    var hasSocialMetadata = !string.IsNullOrWhiteSpace(openGraphDescription);
}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle</title>
    @if (!string.IsNullOrWhiteSpace(metaDescription))
    {
        <meta name="description" content="@metaDescription" />
    }
    @if (!string.IsNullOrWhiteSpace(robots))
    {
        <meta name="robots" content="@robots" />
    }
    @if (!string.IsNullOrWhiteSpace(canonicalUrl))
    {
        <link rel="canonical" href="@canonicalUrl" />
    }
    @if (hasSocialMetadata)
    {
        <meta property="og:site_name" content="TryOutSpot" />
        <meta property="og:title" content="@openGraphTitle" />
        <meta property="og:description" content="@openGraphDescription" />
        <meta property="og:type" content="@openGraphType" />
        @if (!string.IsNullOrWhiteSpace(canonicalUrl))
        {
            <meta property="og:url" content="@canonicalUrl" />
        }
        <meta property="og:image" content="@openGraphImage" />
        <meta property="og:image:alt" content="TryOutSpot logo" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="@openGraphTitle" />
        <meta name="twitter:description" content="@openGraphDescription" />
        <meta name="twitter:image" content="@openGraphImage" />
    }
    <script type="importmap"></script>
    <link rel="manifest" href="~/site.webmanifest" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png" />
    @await RenderSectionAsync("Head", required: false)
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TryOutSpot.Web.styles.css" asp-append-version="true" />
</head>
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var isSplashPage = string.Equals(controller, "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(action, "Index", StringComparison.OrdinalIgnoreCase);
    var currentPath = Context.Request.Path.Value ?? "/";
    var isSignedIn = User.Identity?.IsAuthenticated ?? false;
    var isPlayerSide = User.IsInRole(TryOutSpotRoles.Parent) || User.IsInRole(TryOutSpotRoles.Player);
    var isTeamSide = User.IsInRole(TryOutSpotRoles.TeamRepresentative)
        || User.IsInRole(TryOutSpotRoles.Coach)
        || User.IsInRole(TryOutSpotRoles.TeamManager)
        || User.IsInRole(TryOutSpotRoles.AcademyDirector)
        || User.IsInRole(TryOutSpotRoles.OrganizationAdmin);
    var isPlatformAdmin = User.IsInRole(TryOutSpotRoles.PlatformAdmin);
    var accountLabel = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value;
    if (string.IsNullOrWhiteSpace(accountLabel))
    {
        accountLabel = "Account";
    }

    var mainLinks = new List<(string Href, string Label, string[] Prefixes)>();
    if (!isSignedIn)
    {
        mainLinks.Add(("/tryouts", "Find Tryouts", ["/tryouts", "/opportunities"]));
        mainLinks.Add(("/plans-and-features", "Plans & Pricing", ["/plans-and-features"]));
    }
    else
    {
        mainLinks.Add(("/account/onboarding", "Dashboard", ["/account/onboarding"]));
        if (isPlayerSide || !isTeamSide)
        {
            mainLinks.Add(("/tryouts", "Find Tryouts", ["/tryouts", "/account/search/team-items", "/opportunities"]));
        }
        if (isPlayerSide)
        {
            mainLinks.Add(("/account/onboarding/player-profiles", "My Players", ["/account/onboarding/player-profiles", "/account/onboarding/add-player-profile", "/account/onboarding/player-listings"]));
            mainLinks.Add(("/account/registrations", "My Registrations", ["/account/registrations"]));
        }
        if (isTeamSide)
        {
            mainLinks.Add(("/account/onboarding/team-opportunities", "My Teams", ["/account/onboarding/team-opportunities", "/account/onboarding/add-team-or-organization", "/account/onboarding/coach-getting-started"]));
            mainLinks.Add(("/account/search/players", "Find Players", ["/account/search/players", "/player-listings", "/players"]));
        }
        mainLinks.Add(("/account/onboarding/favorites", "Saved", ["/account/onboarding/favorites"]));
        if (isPlatformAdmin)
        {
            mainLinks.Add(("/admin", "Admin", ["/admin"]));
        }
    }

    string? ActiveLinkHref()
    {
        string? best = null;
        var bestLength = 0;
        foreach (var link in mainLinks)
        {
            foreach (var prefix in link.Prefixes)
            {
                var matches = string.Equals(currentPath, prefix, StringComparison.OrdinalIgnoreCase)
                    || currentPath.StartsWith(prefix + "/", StringComparison.OrdinalIgnoreCase);
                if (matches && prefix.Length > bestLength)
                {
                    best = link.Href;
                    bestLength = prefix.Length;
                }
            }
        }

        return best;
    }

    var activeHref = ActiveLinkHref();
}
<body class="@(isSplashPage ? "splash-page" : string.Empty)">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    @if (!isSplashPage)
    {
        <header>
            <nav class="navbar navbar-expand-md navbar-toggleable-md navbar-light bg-white border-bottom box-shadow mb-3" aria-label="Main">
                <div class="container-fluid">
                    <a class="navbar-brand brand-lockup" href="@(isSignedIn ? "/account/onboarding" : "/")">
                        <img src="~/logo/TryOutSpotLogo.png" asp-append-version="true" alt="TryOutSpot home" class="brand-logo" />
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-navigation" aria-controls="main-navigation"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div id="main-navigation" class="navbar-collapse collapse d-md-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            @foreach (var link in mainLinks)
                            {
                                var isActive = string.Equals(link.Href, activeHref, StringComparison.Ordinal);
                                <li class="nav-item">
                                    <a class="nav-link text-dark @(isActive ? "active" : null)" href="@link.Href" aria-current="@(isActive ? "page" : null)">@link.Label</a>
                                </li>
                            }
                            @if (isSignedIn)
                            {
                                <li class="nav-item d-md-none">
                                    <a class="nav-link text-dark" href="/account/settings">Account Settings</a>
                                </li>
                                <li class="nav-item d-md-none">
                                    <a class="nav-link text-dark" href="/account/settings#membership">Plan &amp; Billing</a>
                                </li>
                                <li class="nav-item d-md-none">
                                    <form asp-action="Logout" asp-controller="Account" method="post" class="nav-signout-form">
                                        <button type="submit" class="nav-link text-dark btn btn-link">Sign out</button>
                                    </form>
                                </li>
                            }
                        </ul>
                        @if (isSignedIn)
                        {
                            <ul class="navbar-nav account-nav d-none d-md-flex">
                                <li class="nav-item dropdown">
                                    <button class="nav-link account-menu-toggle account-menu-toggle-labeled" type="button" id="accountMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                        <span class="account-menu-icon" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" focusable="false" role="img">
                                                <path d="M12 12.5a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" />
                                                <path d="M4.75 20a7.25 7.25 0 0 1 14.5 0" />
                                            </svg>
                                        </span>
                                        <span>@accountLabel</span>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-end account-menu" aria-labelledby="accountMenuButton">
                                        <a class="dropdown-item" href="/account/settings">Account Settings</a>
                                        <a class="dropdown-item" href="/account/settings#membership">Plan &amp; Billing</a>
                                        <a class="dropdown-item" href="/plans-and-features">Compare plans</a>
                                        <form asp-action="Logout" asp-controller="Account" method="post" class="nav-signout-form">
                                            <button type="submit" class="dropdown-item">Sign out</button>
                                        </form>
                                    </div>
                                </li>
                            </ul>
                        }
                        else
                        {
                            <div class="navbar-nav account-nav nav-auth-actions">
                                <a class="nav-link text-dark" href="/account/login">Sign in</a>
                                <a class="btn btn-primary btn-sm" href="/account/register">Create free account</a>
                            </div>
                        }
                    </div>
                </div>
            </nav>
        </header>
    }
    <div class="@(isSplashPage ? "container-fluid px-0" : "container")">
        <main id="main-content" role="main" tabindex="-1" class="@(isSplashPage ? string.Empty : "pb-3")">
            @RenderBody()
        </main>
    </div>
    @if (isSplashPage)
    {
        <footer class="splash-footer">
            <a href="/privacy-policy">Privacy Policy</a> &middot; <a href="/terms-and-conditions">Terms and Conditions</a> &middot; <a href="/account-deletion">Account Deletion</a> &middot; <a href="/sms-consent">SMS Consent</a>
        </footer>
    }
    else
    {
        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2026 - TryOutSpot - <a href="/privacy-policy">Privacy Policy</a> - <a href="/terms-and-conditions">Terms and Conditions</a> - <a href="/account-deletion">Account Deletion</a> - <a href="/sms-consent">SMS Consent</a>
            </div>
        </footer>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
