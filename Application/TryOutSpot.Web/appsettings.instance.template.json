{
  "_Notes": [
    "Copy this file to appsettings.instance.json and replace every PUT_ value needed by the deployment.",
    "appsettings.instance.json is ignored by Git but included when publishing from a machine where it exists.",
    "Never put real passwords, API keys, tokens, or signing secrets in this template.",
    "Environment variables use double underscores for nesting, for example Jwt__SigningKey."
  ],
  "ConnectionStrings": {
    "TryOutSpotDatabase": "Host=PUT_DATABASE_HOST_HERE;Port=5432;Database=tryoutspot_prod;Username=PUT_DATABASE_USER_HERE;Password=PUT_DATABASE_PASSWORD_HERE;SSL Mode=Prefer"
  },
  "Jwt": {
    "SigningKey": "PUT_RANDOM_32_PLUS_CHARACTER_SIGNING_KEY_HERE"
  },
  "Authentication": {
    "CookieDomain": "",
    "Google": {
      "ClientId": "PUT_GOOGLE_CLIENT_ID_HERE",
      "ClientSecret": "PUT_GOOGLE_CLIENT_SECRET_HERE"
    },
    "Facebook": {
      "AppId": "PUT_FACEBOOK_APP_ID_HERE",
      "AppSecret": "PUT_FACEBOOK_APP_SECRET_HERE"
    },
    "Apple": {
      "ClientId": "PUT_APPLE_SERVICE_ID_HERE",
      "TeamId": "PUT_APPLE_TEAM_ID_HERE",
      "KeyId": "PUT_APPLE_KEY_ID_HERE",
      "PrivateKey": "PUT_APPLE_PRIVATE_KEY_HERE"
    }
  },
  "Email": {
    "Provider": "Resend",
    "FromEmail": "no-reply@tryoutspot.com",
    "FromName": "TryOutSpot",
    "FrontendBaseUrl": "https://tryoutspot.com"
  },
  "BootstrapAdmin": {
    "Email": "PUT_BOOTSTRAP_ADMIN_EMAIL_HERE",
    "Password": "PUT_BOOTSTRAP_ADMIN_PASSWORD_HERE",
    "FirstName": "Platform",
    "LastName": "Admin",
    "ResetPassword": false
  },
  "Resend": {
    "ApiKey": "PUT_RESEND_API_KEY_HERE"
  },
  "Sms": {
    "Provider": "Logging"
  },
  "Twilio": {
    "AccountSid": "PUT_TWILIO_ACCOUNT_SID_HERE",
    "AuthToken": "PUT_TWILIO_AUTH_TOKEN_HERE",
    "FromPhoneNumber": "",
    "MessagingServiceSid": ""
  },
  "OpenAI": {
    "ApiKey": "PUT_OPENAI_API_KEY_HERE"
  },
  "FlyerLocationEnrichment": {
    "ApiKey": "PUT_LATLNG_WORK_API_KEY_HERE"
  },
  "Stripe": {
    "SecretKey": "PUT_STRIPE_SECRET_KEY_HERE",
    "WebhookSigningSecret": "PUT_STRIPE_WEBHOOK_SIGNING_SECRET_HERE"
  },
  "R2Storage": {
    "AccountId": "PUT_CLOUDFLARE_ACCOUNT_ID_HERE",
    "Endpoint": "https://PUT_CLOUDFLARE_ACCOUNT_ID_HERE.r2.cloudflarestorage.com",
    "BucketName": "PUT_BUCKET_NAME_HERE",
    "AccessKeyId": "PUT_R2_ACCESS_KEY_ID_HERE",
    "SecretAccessKey": "PUT_R2_SECRET_ACCESS_KEY_HERE"
  }
}
